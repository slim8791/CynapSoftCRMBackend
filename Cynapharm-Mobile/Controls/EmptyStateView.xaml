<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Cynapharm_Mobile.Controls.EmptyStateView"
             x:Name="rootView"
             IsVisible="False">

    <VerticalStackLayout Spacing="16"
                         Padding="32"
                         VerticalOptions="Center"
                         HorizontalOptions="Center">

        <!-- Illustration emoji / icon -->
        <Label Text="{Binding Icon, Source={x:Reference rootView}}"
               FontSize="52"
               HorizontalOptions="Center" />

        <!-- Title -->
        <Label Text="{Binding Title, Source={x:Reference rootView}}"
               FontSize="17"
               FontAttributes="Bold"
               TextColor="{StaticResource Gray900}"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center" />

        <!-- Subtitle -->
        <Label Text="{Binding Subtitle, Source={x:Reference rootView}}"
               FontSize="14"
               TextColor="{StaticResource Gray515}"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               IsVisible="{Binding HasSubtitle, Source={x:Reference rootView}}" />

        <!-- Retry button -->
        <Button Text="{Binding ActionLabel, Source={x:Reference rootView}}"
                Command="{Binding ActionCommand, Source={x:Reference rootView}}"
                BackgroundColor="{StaticResource Primary}"
                TextColor="{StaticResource White}"
                CornerRadius="8"
                Padding="24,10"
                FontSize="14"
                IsVisible="{Binding HasAction, Source={x:Reference rootView}}" />

    </VerticalStackLayout>
</ContentView>
