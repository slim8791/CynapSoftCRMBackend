<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Cynapharm_Mobile.Controls.AppLoader"
             x:Name="root">
             
    <!-- Un petit overlay transparent ou juste l'indicateur selon le besoin.
         Ici on garde la simplicité de l'ActivityIndicator. -->
    <ActivityIndicator IsRunning="{Binding IsBusy, Source={x:Reference root}}"
                       IsVisible="{Binding IsBusy, Source={x:Reference root}}"
                       Color="{StaticResource Primary}"
                       WidthRequest="50"
                       HeightRequest="50"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Margin="0,8" />
</ContentView>
