<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Cynapharm_Mobile.ViewModels.Planning"
             xmlns:field="clr-namespace:Cynapharm_Mobile.Models.Field"
             xmlns:controls="clr-namespace:Cynapharm_Mobile.Controls"
             x:Class="Cynapharm_Mobile.Views.Planning.PlanningPage"
             x:DataType="vm:PlanningViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Primary}"
              Padding="16,48,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>

            <!-- Hamburger button (≡) — opens flyout drawer -->
            <Border Grid.Column="0"
                    BackgroundColor="#26FFFFFF" StrokeShape="RoundRectangle 12"
                    Stroke="Transparent" HeightRequest="38" WidthRequest="38"
                    VerticalOptions="Center" HorizontalOptions="Start">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHamburgerTapped" />
                </Border.GestureRecognizers>
                <!-- SVG Hamburger Menu -->
                <Path Data="M 5,7 L 19,7 M 5,12 L 19,12 M 5,17 L 19,17"
                      Stroke="White" StrokeThickness="2.5"
                      StrokeLineJoin="Round" StrokeLineCap="Round"
                      HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <Border Grid.Column="1"
                    BackgroundColor="#26FFFFFF" StrokeShape="RoundRectangle 12"
                    Stroke="Transparent" HeightRequest="38" WidthRequest="38"
                    VerticalOptions="Center" HorizontalOptions="Start">
                <Label Text="‹" FontSize="22" FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PreviousWeekCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Border>

            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2">
                <Label Text="{Binding WeekLabel}"
                       FontSize="17" FontAttributes="Bold"
                       FontFamily="OpenSansSemibold"
                       TextColor="White"
                       HorizontalOptions="Center" />
                <Label Text="Semaine en cours"
                       FontSize="11" TextColor="#CCF5FF"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Border Grid.Column="3"
                    BackgroundColor="#26FFFFFF" StrokeShape="RoundRectangle 12"
                    Stroke="Transparent" HeightRequest="38" WidthRequest="38"
                    VerticalOptions="Center" HorizontalOptions="End">
                <Label Text="›" FontSize="22" FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NextWeekCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Border>
        </Grid>

        <controls:ErrorBanner Grid.Row="1"
                              Message="{Binding ErrorMessage}"
                              Margin="16,8,16,0" />

        <ActivityIndicator Grid.Row="2"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           Margin="0,8" />

        <!-- ── Week day list ─────────────────────────────────────────────── -->
        <CollectionView Grid.Row="3" ItemsSource="{Binding WeekDays}">
            <CollectionView.Header>
                <BoxView HeightRequest="10" Color="Transparent" />
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:PlanningDayGroup">
                    <Border Margin="16,0,16,10"
                            BackgroundColor="{StaticResource CardBackground}"
                            StrokeShape="RoundRectangle 16"
                            Stroke="{StaticResource BorderColor}" StrokeThickness="1">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.05" />
                        </Border.Shadow>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsToday}" Value="True">
                                <Setter Property="Stroke"          Value="{StaticResource Primary}" />
                                <Setter Property="StrokeThickness" Value="2" />
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryLight}" />
                            </DataTrigger>
                        </Border.Triggers>

                        <VerticalStackLayout Spacing="10" Padding="14,12">
                            <!-- Day header -->
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding DayLabel}"
                                       FontAttributes="Bold" FontSize="14"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource Primary}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsToday}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource PrimaryDark}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Border Grid.Column="1"
                                        BackgroundColor="{StaticResource Primary}"
                                        StrokeShape="RoundRectangle 15" Stroke="Transparent"
                                        HeightRequest="34" WidthRequest="34">
                                    <Label Text="+" FontSize="20" FontAttributes="Bold"
                                           TextColor="White"
                                           HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AddVisitCommand}"
                                                CommandParameter="{Binding Date}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Border>
                            </Grid>

                            <!-- Plannings créés — avec bouton Démarrer -->
                            <CollectionView ItemsSource="{Binding Entries}"
                                            IsVisible="{Binding HasEntries}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="field:Planning">
                                        <Border Margin="0,0,0,6"
                                                StrokeShape="RoundRectangle 10"
                                                Stroke="{StaticResource BorderColor}"
                                                StrokeThickness="1"
                                                BackgroundColor="{StaticResource CardBackground}"
                                                Padding="0">
                                            <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="10">
                                                <BoxView Grid.Column="0" CornerRadius="4,0,0,4"
                                                         BackgroundColor="{StaticResource Primary}"/>
                                                <VerticalStackLayout Grid.Column="1" Spacing="4"
                                                                     VerticalOptions="Center" Margin="0,10">
                                                    <Label Text="{Binding ContactNom}"
                                                           FontSize="13" FontAttributes="Bold"
                                                           TextColor="{StaticResource TextPrimary}"
                                                           LineBreakMode="TailTruncation"/>
                                                    <Grid ColumnDefinitions="Auto,8,Auto">
                                                        <Border Grid.Column="0"
                                                                BackgroundColor="{StaticResource PrimaryLight}"
                                                                StrokeShape="RoundRectangle 10"
                                                                Stroke="Transparent" Padding="8,3">
                                                            <Label Text="{Binding TypeLabel}"
                                                                   FontSize="11" FontAttributes="Bold"
                                                                   TextColor="{StaticResource PrimaryText}"/>
                                                        </Border>
                                                        <Border Grid.Column="2"
                                                                BackgroundColor="{StaticResource SecondaryLight}"
                                                                StrokeShape="RoundRectangle 10"
                                                                Stroke="Transparent" Padding="8,3">
                                                            <Label Text="{Binding EtatLabel}"
                                                                   FontSize="11" FontAttributes="Bold"
                                                                   TextColor="{StaticResource SecondaryText}"/>
                                                        </Border>
                                                    </Grid>
                                                </VerticalStackLayout>
                                                <!-- Bouton Démarrer -->
                                                <Border Grid.Column="2"
                                                        BackgroundColor="{StaticResource Primary}"
                                                        StrokeShape="RoundRectangle 10"
                                                        Stroke="Transparent"
                                                        Padding="12,8" Margin="0,0,10,0"
                                                        VerticalOptions="Center">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DemarrerVisiteCommand}"
                                                            CommandParameter="{Binding .}"/>
                                                    </Border.GestureRecognizers>
                                                    <Label Text="▶ Démarrer" FontSize="12"
                                                           FontAttributes="Bold" TextColor="White"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <!-- Visites du délégué pour ce jour -->
                            <CollectionView ItemsSource="{Binding Visites}"
                                            IsVisible="{Binding HasVisites}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="field:Visite">
                                        <Border Margin="0,0,0,6"
                                                StrokeShape="RoundRectangle 10"
                                                Stroke="{StaticResource BorderColor}"
                                                StrokeThickness="1"
                                                BackgroundColor="{StaticResource CardBackground}"
                                                Padding="0">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenVisiteCommand}"
                                                    CommandParameter="{Binding Id}" />
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="10">
                                                <!-- Barre gauche : couleur selon statut -->
                                                <BoxView Grid.Column="0"
                                                         CornerRadius="4,0,0,4">
                                                    <BoxView.Triggers>
                                                        <DataTrigger TargetType="BoxView"
                                                                     Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="BackgroundColor" Value="#2E7D32"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="BoxView"
                                                                     Binding="{Binding IsStarted}" Value="True">
                                                            <Setter Property="BackgroundColor" Value="{StaticResource Secondary}"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="BoxView"
                                                                     Binding="{Binding IsCompleted}" Value="False">
                                                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
                                                        </DataTrigger>
                                                    </BoxView.Triggers>
                                                </BoxView>
                                                <!-- Centre : contact + type -->
                                                <VerticalStackLayout Grid.Column="1"
                                                                     Spacing="4"
                                                                     VerticalOptions="Center"
                                                                     Margin="0,10">
                                                    <Label Text="{Binding ContactName}"
                                                           FontSize="13" FontAttributes="Bold"
                                                           TextColor="{StaticResource TextPrimary}"
                                                           LineBreakMode="TailTruncation"/>
                                                    <Border Padding="8,3" Stroke="Transparent"
                                                            BackgroundColor="{StaticResource PrimaryLight}"
                                                            HorizontalOptions="Start">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="10"/>
                                                        </Border.StrokeShape>
                                                        <Label Text="{Binding TypeLabel}"
                                                               FontSize="11" FontAttributes="Bold"
                                                               TextColor="{StaticResource PrimaryText}"/>
                                                    </Border>
                                                </VerticalStackLayout>
                                                <!-- Droite : statut -->
                                                <Label Grid.Column="2"
                                                       Text="{Binding Statut}"
                                                       FontSize="11"
                                                       TextColor="{StaticResource TextMuted}"
                                                       VerticalOptions="Center"
                                                       Margin="0,0,10,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <!-- Message si aucune visite ce jour -->
                            <Border BackgroundColor="{StaticResource SurfaceBackground}"
                                    StrokeShape="RoundRectangle 8" Stroke="Transparent"
                                    Padding="12,8"
                                    IsVisible="{Binding HasEntries, Converter={StaticResource InvertedBoolConverter}}">
                                <Label Text="Aucune visite planifiée"
                                       TextColor="{StaticResource TextMuted}"
                                       FontSize="12" FontAttributes="Italic"
                                       HorizontalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <BoxView HeightRequest="8" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>

        <!-- ── Sticky CTA ─────────────────────────────────────────────────── -->
        <Grid Grid.Row="4" BackgroundColor="{StaticResource CardBackground}">
            <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}"
                     VerticalOptions="Start" />
            <Button Text="+ Ajouter une visite"
                    Command="{Binding AddVisitCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="16,12,16,28" />
        </Grid>

    </Grid>
</ContentPage>
