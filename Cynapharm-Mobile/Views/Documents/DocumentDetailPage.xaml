<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Cynapharm_Mobile.ViewModels.Documents"
             xmlns:controls="clr-namespace:Cynapharm_Mobile.Controls"
             x:Class="Cynapharm_Mobile.Views.Documents.DocumentDetailPage"
             x:DataType="vm:DocumentDetailViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Partager" Command="{Binding ShareCommand}" IconImageSource="share.png" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">

        <!-- ── Primary header ────────────────────────────────────────────── -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource Primary}"
              Padding="16,48,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0"
                   Text="‹"
                   FontSize="28" FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center"
                   Padding="0,0,8,0" />


            <Label Grid.Column="1"
                   Text="{Binding Title}"
                   FontSize="18" FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center"
                   HorizontalOptions="Center" />
        </Grid>

        <!-- ── Body ──────────────────────────────────────────────────────── -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="16">

                <controls:ErrorBanner Message="{Binding ErrorMessage}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Primary}"
                                   HorizontalOptions="Center" />

                <!-- ── Facture ────────────────────────────────────────── -->
                <Border Style="{StaticResource CardStyle}"
                        IsVisible="{Binding IsFacture}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Facture"
                               FontSize="11" FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}"
                               TextTransform="Uppercase" />
                        <Label Text="{Binding Facture.NumeroFacture}"
                               FontSize="22" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                <Label Text="Date"
                                       FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                <Label Text="{Binding Facture.DateFacture, StringFormat='{0:dd/MM/yyyy}'}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                                <Label Text="Statut"
                                       FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                <Border BackgroundColor="{StaticResource PrimaryLight}"
                                        Padding="8,3"
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="Transparent"
                                        HorizontalOptions="Start">
                                    <Label Text="{Binding Facture.Statut}"
                                           FontSize="12"
                                           TextColor="{StaticResource PrimaryText}"
                                           FontAttributes="Bold" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2">
                                <Label Text="Montant HT"
                                       FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                <Label Text="{Binding Facture.MontantHT, StringFormat='{0:N3} TND'}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                                <Label Text="TVA"
                                       FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                <Label Text="{Binding Facture.TVA, StringFormat='{0:N3} TND'}"
                                       FontSize="14"
                                       TextColor="{StaticResource TextPrimary}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4">
                                <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" />
                                <Label Text="Montant TTC"
                                       FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                <Label Text="{Binding Facture.MontantTTC, StringFormat='{0:N3} TND'}"
                                       FontSize="20" FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ── Bon de commande ────────────────────────────────── -->
                <Border Style="{StaticResource CardStyle}"
                        IsVisible="{Binding IsBonCommande}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Bon de commande"
                               FontSize="11" FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}"
                               TextTransform="Uppercase" />
                        <Label Text="{Binding BonCommande.NumeroBon}"
                               FontSize="22" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" />
                        <Grid ColumnDefinitions="*,*" RowSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Date d'émission"
                                       FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                <Label Text="{Binding BonCommande.DateEmission, StringFormat='{0:dd/MM/yyyy}'}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Statut"
                                       FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                <Border BackgroundColor="{StaticResource PrimaryLight}"
                                        Padding="8,3"
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="Transparent"
                                        HorizontalOptions="Start">
                                    <Label Text="{Binding BonCommande.Statut}"
                                           FontSize="12"
                                           TextColor="{StaticResource PrimaryText}"
                                           FontAttributes="Bold" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" />
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Montant total"
                                   FontSize="11" TextColor="{StaticResource TextSecondary}" />
                            <Label Text="{Binding BonCommande.MontantTotal, StringFormat='{0:N3} TND'}"
                                   FontSize="20" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ── Bon de livraison ───────────────────────────────── -->
                <Border Style="{StaticResource CardStyle}"
                        IsVisible="{Binding IsBonLivraison}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Bon de livraison"
                               FontSize="11" FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}"
                               TextTransform="Uppercase" />
                        <Label Text="{Binding BonLivraison.NumeroBon}"
                               FontSize="22" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" />
                        <Grid ColumnDefinitions="*,*" RowSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Date de livraison"
                                       FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                <Label Text="{Binding BonLivraison.DateLivraison, StringFormat='{0:dd/MM/yyyy}'}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Statut"
                                       FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                <Border BackgroundColor="{StaticResource PrimaryLight}"
                                        Padding="8,3"
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="Transparent"
                                        HorizontalOptions="Start">
                                    <Label Text="{Binding BonLivraison.Statut}"
                                           FontSize="12"
                                           TextColor="{StaticResource PrimaryText}"
                                           FontAttributes="Bold" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Share button -->
                <Button Text="🔗  Partager ce document"
                        Command="{Binding ShareCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,8,0,24" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
