<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Cynapharm_Mobile.ViewModels.Documents"
             xmlns:docs="clr-namespace:Cynapharm_Mobile.Models.Documents"
             xmlns:controls="clr-namespace:Cynapharm_Mobile.Controls"
             x:Class="Cynapharm_Mobile.Views.Documents.DocumentListPage"
             x:DataType="vm:DocumentListViewModel"
             Title="Documents"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <controls:AppHeader Grid.Row="0"
                            Title="Documents"
                            Subtitle="Factures, bons de commande et livraison"
                            ShowHamburger="True" />

        <!-- Error banner -->
        <controls:ErrorBanner Grid.Row="1"
                              Message="{Binding ErrorMessage}"
                              Margin="16,8,16,0" />

        <!-- ── Tab bar ───────────────────────────────────────────────────── -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,*,*"
              BackgroundColor="{StaticResource CardBackground}">

            <VerticalStackLayout Grid.Column="0" Spacing="0">
                <Button Text="Factures"
                        Command="{Binding SetTypeIndexCommand}" CommandParameter="0"
                        BackgroundColor="Transparent"
                        FontSize="13" HeightRequest="46" Margin="0">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedTypeIndex}" Value="0">
                            <Setter Property="TextColor"     Value="{StaticResource Primary}" />
                            <Setter Property="FontAttributes" Value="Bold" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedTypeIndex}" Value="1">
                            <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedTypeIndex}" Value="2">
                            <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <BoxView HeightRequest="2.5" CornerRadius="2">
                    <BoxView.Triggers>
                        <DataTrigger TargetType="BoxView" Binding="{Binding SelectedTypeIndex}" Value="0">
                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                        </DataTrigger>
                        <DataTrigger TargetType="BoxView" Binding="{Binding SelectedTypeIndex}" Value="1">
                            <Setter Property="BackgroundColor" Value="Transparent" />
                        </DataTrigger>
                        <DataTrigger TargetType="BoxView" Binding="{Binding SelectedTypeIndex}" Value="2">
                            <Setter Property="BackgroundColor" Value="Transparent" />
                        </DataTrigger>
                    </BoxView.Triggers>
                </BoxView>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="1" Spacing="0">
                <Button Text="Bons cmd."
                        Command="{Binding SetTypeIndexCommand}" CommandParameter="1"
                        BackgroundColor="Transparent"
                        FontSize="13" HeightRequest="46" Margin="0">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedTypeIndex}" Value="0">
                            <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedTypeIndex}" Value="1">
                            <Setter Property="TextColor"     Value="{StaticResource Primary}" />
                            <Setter Property="FontAttributes" Value="Bold" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedTypeIndex}" Value="2">
                            <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <BoxView HeightRequest="2.5" CornerRadius="2">
                    <BoxView.Triggers>
                        <DataTrigger TargetType="BoxView" Binding="{Binding SelectedTypeIndex}" Value="0">
                            <Setter Property="BackgroundColor" Value="Transparent" />
                        </DataTrigger>
                        <DataTrigger TargetType="BoxView" Binding="{Binding SelectedTypeIndex}" Value="1">
                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                        </DataTrigger>
                        <DataTrigger TargetType="BoxView" Binding="{Binding SelectedTypeIndex}" Value="2">
                            <Setter Property="BackgroundColor" Value="Transparent" />
                        </DataTrigger>
                    </BoxView.Triggers>
                </BoxView>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="2" Spacing="0">
                <Button Text="Bons liv."
                        Command="{Binding SetTypeIndexCommand}" CommandParameter="2"
                        BackgroundColor="Transparent"
                        FontSize="13" HeightRequest="46" Margin="0">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedTypeIndex}" Value="0">
                            <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedTypeIndex}" Value="1">
                            <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedTypeIndex}" Value="2">
                            <Setter Property="TextColor"     Value="{StaticResource Primary}" />
                            <Setter Property="FontAttributes" Value="Bold" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <BoxView HeightRequest="2.5" CornerRadius="2">
                    <BoxView.Triggers>
                        <DataTrigger TargetType="BoxView" Binding="{Binding SelectedTypeIndex}" Value="0">
                            <Setter Property="BackgroundColor" Value="Transparent" />
                        </DataTrigger>
                        <DataTrigger TargetType="BoxView" Binding="{Binding SelectedTypeIndex}" Value="1">
                            <Setter Property="BackgroundColor" Value="Transparent" />
                        </DataTrigger>
                        <DataTrigger TargetType="BoxView" Binding="{Binding SelectedTypeIndex}" Value="2">
                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                        </DataTrigger>
                    </BoxView.Triggers>
                </BoxView>
            </VerticalStackLayout>

        </Grid>

        <ActivityIndicator Grid.Row="3"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           Margin="0,6" />

        <!-- ── Document list ─────────────────────────────────────────────── -->
        <RefreshView Grid.Row="4"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing}"
                     RefreshColor="{StaticResource Primary}">
            <CollectionView ItemsSource="{Binding Documents}">

                <CollectionView.Header>
                    <BoxView HeightRequest="8" Color="Transparent" />
                </CollectionView.Header>

                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                         Spacing="16" Padding="40" Margin="0,40,0,0">
                        <Border BackgroundColor="{StaticResource PrimaryLight}"
                                StrokeShape="RoundRectangle 50" Stroke="Transparent"
                                WidthRequest="80" HeightRequest="80" HorizontalOptions="Center">
                            <Label Text="📄" FontSize="38"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Aucun document trouvé"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               HorizontalOptions="Center" />
                        <Label Text="Les documents apparaîtront ici."
                               Style="{StaticResource EmptyStateStyle}" FontSize="13" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="docs:DocumentSummary">
                        <Border Margin="16,0,16,10"
                                BackgroundColor="{StaticResource CardBackground}"
                                StrokeShape="RoundRectangle 16"
                                Stroke="{StaticResource BorderColor}" StrokeThickness="1"
                                Padding="0">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.06" />
                            </Border.Shadow>
                            <Grid ColumnDefinitions="5,*,Auto">
                                <BoxView Grid.Column="0"
                                         BackgroundColor="{StaticResource Primary}"
                                         VerticalOptions="Fill" />
                                <VerticalStackLayout Grid.Column="1" Padding="14,14" Spacing="5">
                                    <Label Text="{Binding Numero}"
                                           FontAttributes="Bold" FontSize="15"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="{StaticResource TextPrimary}"
                                           LineBreakMode="TailTruncation" />
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                        <Label Grid.Column="0" Text="📅" FontSize="11"
                                               VerticalOptions="Center" />
                                        <Label Grid.Column="1"
                                               Text="{Binding Date, StringFormat='Le {0:dd/MM/yyyy}'}"
                                               FontSize="12"
                                               TextColor="{StaticResource TextSecondary}"
                                               VerticalOptions="Center" />
                                    </Grid>
                                    <Label Text="{Binding Montant, StringFormat='{0:#,##0.000} TND'}"
                                           FontSize="13" FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}"
                                           IsVisible="{Binding Montant, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Padding="12,14" Spacing="8"
                                                     HorizontalOptions="End" VerticalOptions="Center">
                                    <!-- Download button — visible only when a URL is available -->
                                    <Border BackgroundColor="{StaticResource PrimaryLight}"
                                            StrokeShape="RoundRectangle 10" Stroke="Transparent"
                                            HeightRequest="34" WidthRequest="34"
                                            HorizontalOptions="Center"
                                            IsVisible="{Binding Url, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                                        <Label FontFamily="Tabler" Text="&#xea96;"
                                               FontSize="18" TextColor="{StaticResource Primary}"
                                               HorizontalOptions="Center" VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenDocumentCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Border>
                                    <Label Text="›" FontSize="22"
                                           TextColor="{StaticResource Gray300}"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.GoToDetailCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <BoxView HeightRequest="24" Color="Transparent" />
                </CollectionView.Footer>

            </CollectionView>
        </RefreshView>

        <controls:AppLoader Grid.RowSpan="5" />

    </Grid>
</ContentPage>
