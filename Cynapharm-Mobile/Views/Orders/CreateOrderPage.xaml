<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Cynapharm_Mobile.ViewModels.Orders"
             xmlns:models="clr-namespace:Cynapharm_Mobile.Models.Orders"
             xmlns:products="clr-namespace:Cynapharm_Mobile.Models.Products"
             xmlns:controls="clr-namespace:Cynapharm_Mobile.Controls"
             x:Class="Cynapharm_Mobile.Views.Orders.CreateOrderPage"
             x:DataType="vm:CreateOrderViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ── Primary header with wizard steps ──────────────────────────── -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource Primary}"
              Padding="16,48,16,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0"
                   Text="Nouvelle commande"
                   FontSize="18" FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center" />

            <!-- Wizard step bar (3 segments) -->
            <Grid Grid.Row="1"
                  ColumnDefinitions="*,8,*,8,*"
                  ColumnSpacing="0"
                  Margin="0,16,0,4">
                <!-- Step 1 -->
                <BoxView Grid.Column="0" HeightRequest="4"
                         BackgroundColor="White"
                         CornerRadius="2" />
                <!-- Step 2 -->
                <BoxView Grid.Column="2" HeightRequest="4"
                         CornerRadius="2">
                    <BoxView.Triggers>
                        <DataTrigger TargetType="BoxView" Binding="{Binding CurrentStep}" Value="1">
                            <Setter Property="BackgroundColor" Value="#4DFFFFFF" />
                        </DataTrigger>
                        <DataTrigger TargetType="BoxView" Binding="{Binding CurrentStep}" Value="2">
                            <Setter Property="BackgroundColor" Value="White" />
                        </DataTrigger>
                        <DataTrigger TargetType="BoxView" Binding="{Binding CurrentStep}" Value="3">
                            <Setter Property="BackgroundColor" Value="White" />
                        </DataTrigger>
                    </BoxView.Triggers>
                </BoxView>
                <!-- Step 3 -->
                <BoxView Grid.Column="4" HeightRequest="4"
                         CornerRadius="2">
                    <BoxView.Triggers>
                        <DataTrigger TargetType="BoxView" Binding="{Binding CurrentStep}" Value="1">
                            <Setter Property="BackgroundColor" Value="#4DFFFFFF" />
                        </DataTrigger>
                        <DataTrigger TargetType="BoxView" Binding="{Binding CurrentStep}" Value="2">
                            <Setter Property="BackgroundColor" Value="#4DFFFFFF" />
                        </DataTrigger>
                        <DataTrigger TargetType="BoxView" Binding="{Binding CurrentStep}" Value="3">
                            <Setter Property="BackgroundColor" Value="White" />
                        </DataTrigger>
                    </BoxView.Triggers>
                </BoxView>
            </Grid>

            <!-- Step labels -->
            <Grid Grid.Row="2"
                  ColumnDefinitions="*,8,*,8,*">
                <Label Grid.Column="0" Text="Produits" FontSize="11"
                       TextColor="White" HorizontalOptions="Center" />
                <Label Grid.Column="2" Text="Panier" FontSize="11"
                       HorizontalOptions="Center">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding CurrentStep}" Value="1">
                            <Setter Property="TextColor" Value="#99FFFFFF" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding CurrentStep}" Value="2">
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding CurrentStep}" Value="3">
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
                <Label Grid.Column="4" Text="Confirm." FontSize="11"
                       HorizontalOptions="Center">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding CurrentStep}" Value="1">
                            <Setter Property="TextColor" Value="#99FFFFFF" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding CurrentStep}" Value="2">
                            <Setter Property="TextColor" Value="#99FFFFFF" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding CurrentStep}" Value="3">
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Grid>
        </Grid>

        <!-- ── Step content ──────────────────────────────────────────────── -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="12">

                <controls:ErrorBanner Message="{Binding ErrorMessage}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Primary}"
                                   HorizontalOptions="Center" />

                <!-- Step 1: Product search + cart -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsStep1}">
                    <Label Text="Étape 1 — Ajouter des produits"
                           Style="{StaticResource SectionTitleStyle}" />

                    <Border Stroke="{StaticResource BorderColor}"
                            BackgroundColor="{StaticResource SurfaceBackground}"
                            StrokeThickness="1"
                            Padding="12,0" HeightRequest="48">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <SearchBar Placeholder="Rechercher un produit..."
                                   Text="{Binding SearchQuery}"
                                   SearchCommand="{Binding SearchProductCommand}"
                                   BackgroundColor="Transparent"
                                   TextColor="{StaticResource TextPrimary}"
                                   PlaceholderColor="{StaticResource TextMuted}"
                                   VerticalOptions="Center" />
                    </Border>

                    <CollectionView ItemsSource="{Binding SearchResults}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="products:Product">
                                <Border Padding="12,10" Margin="0,3"
                                        Style="{StaticResource CardStyle}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Nom}"
                                               FontAttributes="Bold" FontSize="14"
                                               TextColor="{StaticResource TextPrimary}" />
                                        <Label Grid.Column="1"
                                               Text="{Binding PrixUnitaire, StringFormat='{0:N3} TND'}"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Primary}" />
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectProductCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Selected product preview -->
                    <Border BackgroundColor="{StaticResource PrimaryLight}"
                            StrokeShape="RoundRectangle 10" Stroke="Transparent" Padding="12,10"
                            IsVisible="{Binding SelectedProduct, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                        <Label Text="{Binding SelectedProduct.Nom, StringFormat='Produit sélectionné : {0}'}"
                               TextColor="{StaticResource PrimaryText}" FontAttributes="Bold" FontSize="14" />
                    </Border>

                    <!-- Quantity entry -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Quantité" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        <Border Stroke="{StaticResource BorderColor}"
                                BackgroundColor="{StaticResource SurfaceBackground}"
                                StrokeThickness="1" Padding="12,0" HeightRequest="48">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Entry Placeholder="Quantité" Text="{Binding Quantity}"
                                   Keyboard="Numeric"
                                   BackgroundColor="Transparent"
                                   TextColor="{StaticResource TextPrimary}"
                                   Margin="0" VerticalOptions="Center" />
                        </Border>
                        <Label Text="{Binding QuantityError}"
                               TextColor="{StaticResource Danger}" FontSize="12"
                               IsVisible="{Binding QuantityError, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                    </VerticalStackLayout>

                    <Button Text="Ajouter au panier"
                            Command="{Binding AddLineCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0" />

                    <!-- Cart summary -->
                    <Label Text="Panier" Style="{StaticResource SectionTitleStyle}" Margin="0,8,0,0" />

                    <CollectionView ItemsSource="{Binding CartLines}">
                        <CollectionView.EmptyView>
                            <Label Text="Panier vide"
                                   Style="{StaticResource EmptyStateStyle}"
                                   Margin="0,8" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:CartLine">
                                <Border Margin="0,4" Style="{StaticResource CardStyle}">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
                                        <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="6">
                                            <Label Text="{Binding ProductNom}"
                                                   FontAttributes="Bold" FontSize="14"
                                                   TextColor="{StaticResource TextPrimary}" />
                                            <Border BackgroundColor="{StaticResource SecondaryLight}"
                                                    Padding="6,2" StrokeShape="RoundRectangle 8" Stroke="Transparent"
                                                    IsVisible="{Binding HasPromo}">
                                                <Label Text="{Binding PromoTitre}" FontSize="10"
                                                       TextColor="{StaticResource SecondaryText}" FontAttributes="Bold" />
                                            </Border>
                                        </HorizontalStackLayout>
                                        <Label Grid.Row="0" Grid.Column="1"
                                               Text="{Binding Quantite, StringFormat='x{0}'}"
                                               TextColor="{StaticResource TextSecondary}" FontSize="13"
                                               VerticalOptions="Center" />
                                        <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="8">
                                            <Label Text="{Binding PrixOriginal, StringFormat='{0:N3} TND'}"
                                                   TextColor="{StaticResource TextMuted}" FontSize="12"
                                                   TextDecorations="Strikethrough"
                                                   IsVisible="{Binding HasPromo}" />
                                            <Label Text="{Binding PrixUnitaire, StringFormat='{}{0:N3} TND'}"
                                                   FontSize="13" FontAttributes="Bold"
                                                   TextColor="{StaticResource Primary}" />
                                        </HorizontalStackLayout>
                                        <Label Grid.Row="1" Grid.Column="1"
                                               Text="{Binding SousTotal, StringFormat='{0:N3} TND'}"
                                               FontAttributes="Bold" TextColor="{StaticResource Primary}"
                                               FontSize="13" VerticalOptions="End" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Border Style="{StaticResource CardStyle}"
                            BackgroundColor="{StaticResource SurfaceBackground}">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Sous-total"
                                       FontSize="13" TextColor="{StaticResource TextSecondary}" />
                                <Label Grid.Column="1"
                                       Text="{Binding CartTotal, StringFormat='{0:N3} TND'}"
                                       FontAttributes="Bold" FontSize="13"
                                       TextColor="{StaticResource TextPrimary}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto"
                                  IsVisible="{Binding HasCartSavings}">
                                <Label Grid.Column="0" Text="Économies promo"
                                       FontSize="13" TextColor="{StaticResource PrimaryText}" />
                                <Label Grid.Column="1"
                                       Text="{Binding CartSavings, StringFormat='-{0:N3} TND'}"
                                       FontAttributes="Bold" FontSize="13"
                                       TextColor="{StaticResource PrimaryText}" />
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Total"
                                       FontSize="16" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Grid.Column="1"
                                       Text="{Binding CartTotal, StringFormat='{0:N3} TND'}"
                                       FontAttributes="Bold" FontSize="16"
                                       TextColor="{StaticResource Primary}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Step 2: Cart review -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsStep2}">
                    <Label Text="Étape 2 — Réviser le panier"
                           Style="{StaticResource SectionTitleStyle}" />
                    <CollectionView ItemsSource="{Binding CartLines}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:CartLine">
                                <Border Margin="0,4" Style="{StaticResource CardStyle}">
                                    <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
                                        <Label Grid.Row="0" Grid.Column="0"
                                               Text="{Binding ProductNom}"
                                               FontAttributes="Bold" FontSize="14"
                                               TextColor="{StaticResource TextPrimary}" />
                                        <Label Grid.Row="0" Grid.Column="1"
                                               Text="{Binding Quantite, StringFormat='x{0}'}"
                                               TextColor="{StaticResource TextSecondary}" Margin="8,0" />
                                        <Button Grid.Row="0" Grid.Column="2" Text="✕"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource Danger}"
                                                Padding="4,0" FontSize="14"
                                                HeightRequest="36"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveLineCommand}"
                                                CommandParameter="{Binding .}" />
                                        <HorizontalStackLayout Grid.Row="1" Grid.Column="0"
                                                               Grid.ColumnSpan="2" Spacing="8">
                                            <Label Text="{Binding PrixOriginal, StringFormat='{0:N3} TND'}"
                                                   TextColor="{StaticResource TextMuted}" FontSize="12"
                                                   TextDecorations="Strikethrough"
                                                   IsVisible="{Binding HasPromo}" />
                                            <Label Text="{Binding SousTotal, StringFormat='{0:N3} TND'}"
                                                   FontAttributes="Bold" FontSize="14"
                                                   TextColor="{StaticResource Primary}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Grid ColumnDefinitions="*,*" Margin="0,4">
                        <Label Grid.Column="0"
                               Text="{Binding CartTotal, StringFormat='Total : {0:N3} TND'}"
                               FontAttributes="Bold" FontSize="18"
                               TextColor="{StaticResource Primary}" />
                        <Label Grid.Column="1"
                               Text="{Binding CartSavings, StringFormat='Économie : {0:N3} TND'}"
                               TextColor="{StaticResource PrimaryText}" FontAttributes="Bold"
                               HorizontalOptions="End" VerticalOptions="Center"
                               IsVisible="{Binding HasCartSavings}" />
                    </Grid>
                </VerticalStackLayout>

                <!-- Step 3: Confirmation -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding IsStep3}"
                                     HorizontalOptions="Center">
                    <!-- Success icon -->
                    <Border BackgroundColor="{StaticResource PrimaryLight}"
                            StrokeShape="RoundRectangle 32"
                            Stroke="Transparent"
                            HeightRequest="64" WidthRequest="64"
                            HorizontalOptions="Center">
                        <Label Text="✓"
                               FontSize="28" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <Label Text="Commande confirmée !"
                           FontSize="20" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalOptions="Center" />

                    <Label Text="Votre commande a été enregistrée avec succès."
                           FontSize="14"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />

                    <!-- Delivery notes -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Notes de livraison (optionnel)"
                               FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        <Border Stroke="{StaticResource BorderColor}"
                                BackgroundColor="{StaticResource SurfaceBackground}"
                                StrokeThickness="1" Padding="12,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Editor Placeholder="Notes de livraison…"
                                    Text="{Binding DeliveryNotes}"
                                    MinimumHeightRequest="80"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource TextPrimary}"
                                    PlaceholderColor="{StaticResource TextMuted}" />
                        </Border>
                    </VerticalStackLayout>

                    <Label Text="{Binding CartTotal, StringFormat='Total commande : {0:N3} TND'}"
                           FontAttributes="Bold" FontSize="20"
                           TextColor="{StaticResource Primary}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ── Navigation buttons ─────────────────────────────────────────── -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" Padding="16,8" ColumnSpacing="8">
            <Button Grid.Column="0"
                    Text="Précédent"
                    Command="{Binding PreviousStepCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0"
                    IsVisible="{Binding IsNotStep1}" />
            <Button Grid.Column="1"
                    Text="Suivant"
                    Command="{Binding NextStepCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0"
                    IsVisible="{Binding IsNotStep3}" />
            <Button Grid.Column="0" Grid.ColumnSpan="2"
                    Text="Confirmer la commande"
                    Command="{Binding SubmitOrderCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0"
                    IsVisible="{Binding IsStep3}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
        </Grid>

    </Grid>
</ContentPage>
