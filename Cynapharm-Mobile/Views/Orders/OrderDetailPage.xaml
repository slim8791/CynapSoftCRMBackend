<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Cynapharm_Mobile.ViewModels.Orders"
             xmlns:models="clr-namespace:Cynapharm_Mobile.Models.Orders"
             xmlns:docs="clr-namespace:Cynapharm_Mobile.Models.Documents"
             xmlns:controls="clr-namespace:Cynapharm_Mobile.Controls"
             x:Class="Cynapharm_Mobile.Views.Orders.OrderDetailPage"
             x:DataType="vm:OrderDetailViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- ── Primary header ────────────────────────────────────────────── -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource Primary}"
              Padding="16,48,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0"
                   Text="‹"
                   FontSize="28" FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center"
                   Padding="0,0,8,0" />

            <Label Grid.Column="1"
                   Text="Détail commande"
                   FontSize="18" FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center"
                   HorizontalOptions="Center" />
        </Grid>

        <!-- ── Body ──────────────────────────────────────────────────────── -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}"
                     RefreshColor="{StaticResource Primary}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">

                <controls:ErrorBanner Message="{Binding ErrorMessage}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Primary}"
                                   HorizontalOptions="Center" />

                <!-- Order header card -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0"
                               Text="Numéro"
                               FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        <Label Grid.Row="0" Grid.Column="1"
                               Text="{Binding Order.NumeroCommande, StringFormat='#{0}'}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />

                        <Label Grid.Row="1" Grid.Column="0"
                               Text="Date"
                               FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        <Label Grid.Row="1" Grid.Column="1"
                               Text="{Binding Order.DateCommande, StringFormat='{0:dd/MM/yyyy}'}"
                               TextColor="{StaticResource TextPrimary}" />

                        <Label Grid.Row="2" Grid.Column="0"
                               Text="Statut"
                               FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        <Border Grid.Row="2" Grid.Column="1"
                                Padding="8,3" Stroke="Transparent"
                                BackgroundColor="{StaticResource SecondaryLight}"
                                HorizontalOptions="Start">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label Text="{Binding Order.Statut}"
                                   FontSize="11" FontAttributes="Bold"
                                   TextColor="{Binding Order.Statut, Converter={StaticResource StatusColorConverter}}" />
                        </Border>

                        <Label Grid.Row="3" Grid.Column="0"
                               Text="Total"
                               FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        <Label Grid.Row="3" Grid.Column="1"
                               Text="{Binding Order.MontantTotal, StringFormat='{0:N3} TND'}"
                               TextColor="{StaticResource Primary}"
                               FontAttributes="Bold" FontSize="16" />
                    </Grid>
                </Border>

                <!-- Cancellation reason (shown when ANNULEE) -->
                <Border BackgroundColor="{StaticResource DangerLight}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource Danger}" StrokeThickness="1"
                        Padding="14,12"
                        IsVisible="{Binding IsAnnulee}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="🚫" FontSize="22"
                               VerticalOptions="Center" HorizontalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Commande annulée"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="{StaticResource Danger}" />
                            <Label Text="{Binding Order.MotifAnnulation}"
                                   FontSize="13"
                                   TextColor="{StaticResource Danger}"
                                   IsVisible="{Binding Order.MotifAnnulation, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Line items -->
                <Label Text="Articles"
                       Style="{StaticResource SectionTitleStyle}" />

                <CollectionView ItemsSource="{Binding Lignes}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:LigneCommande">
                            <Border Margin="0,0,0,8" Style="{StaticResource CardStyle}">
                                <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
                                    <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                           Text="{Binding DisplayName}"
                                           FontAttributes="Bold" FontSize="14"
                                           TextColor="{StaticResource TextPrimary}" />
                                    <Label Grid.Row="1" Grid.Column="0"
                                           Text="{Binding Quantite, StringFormat='Qté: {0}'}"
                                           TextColor="{StaticResource TextSecondary}" FontSize="12" />
                                    <Label Grid.Row="1" Grid.Column="1"
                                           Text="{Binding PrixUnitaire, StringFormat='{0:N3} TND'}"
                                           TextColor="{StaticResource TextSecondary}" FontSize="12" />
                                    <Label Grid.Row="1" Grid.Column="2"
                                           Text="{Binding SousTotal, StringFormat='{0:N3} TND'}"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Notes -->
                <Label Text="{Binding Order.Notes}"
                       TextColor="{StaticResource TextSecondary}"
                       FontSize="13"
                       IsVisible="{Binding Order.Notes, Converter={StaticResource IsNotNullOrEmptyConverter}}" />

                <!-- ── Documents liés ─────────────────────────────────────── -->
                <VerticalStackLayout Spacing="8"
                                     IsVisible="{Binding HasLinkedDocuments}">

                    <Label Text="Documents liés"
                           Style="{StaticResource SectionTitleStyle}" />

                    <!-- Factures -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding LinkedFactures}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="docs:DocumentSummary">
                                <Border Style="{StaticResource CardStyle}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Grid.Column="0"
                                                BackgroundColor="{StaticResource PrimaryLight}"
                                                StrokeShape="RoundRectangle 8" Stroke="Transparent"
                                                HeightRequest="36" WidthRequest="36">
                                            <Label FontFamily="Tabler" Text="&#xea88;"
                                                   FontSize="18" TextColor="{StaticResource Primary}"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Numero}"
                                                   FontSize="13" FontAttributes="Bold"
                                                   TextColor="{StaticResource TextPrimary}" />
                                            <Label Text="{Binding Date, StringFormat='{0:dd/MM/yyyy}'}"
                                                   FontSize="11" TextColor="{StaticResource TextMuted}" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="2"
                                                BackgroundColor="{StaticResource SecondaryLight}"
                                                StrokeShape="RoundRectangle 8" Stroke="Transparent"
                                                Padding="8,3" VerticalOptions="Center">
                                            <Label Text="{Binding Statut}"
                                                   FontSize="11" FontAttributes="Bold"
                                                   TextColor="{StaticResource TextPrimary}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Bons de commande -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding LinkedBC}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="docs:DocumentSummary">
                                <Border Style="{StaticResource CardStyle}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Grid.Column="0"
                                                BackgroundColor="{StaticResource AccentLight}"
                                                StrokeShape="RoundRectangle 8" Stroke="Transparent"
                                                HeightRequest="36" WidthRequest="36">
                                            <Label FontFamily="Tabler" Text="&#xeb65;"
                                                   FontSize="18" TextColor="{StaticResource Accent}"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Numero}"
                                                   FontSize="13" FontAttributes="Bold"
                                                   TextColor="{StaticResource TextPrimary}" />
                                            <Label Text="{Binding Date, StringFormat='{0:dd/MM/yyyy}'}"
                                                   FontSize="11" TextColor="{StaticResource TextMuted}" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="2"
                                                BackgroundColor="{StaticResource SecondaryLight}"
                                                StrokeShape="RoundRectangle 8" Stroke="Transparent"
                                                Padding="8,3" VerticalOptions="Center">
                                            <Label Text="{Binding Statut}"
                                                   FontSize="11" FontAttributes="Bold"
                                                   TextColor="{StaticResource TextPrimary}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Bons de livraison -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding LinkedBL}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="docs:DocumentSummary">
                                <Border Style="{StaticResource CardStyle}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Grid.Column="0"
                                                BackgroundColor="{StaticResource SurfaceBackground}"
                                                StrokeShape="RoundRectangle 8" Stroke="{StaticResource BorderColor}"
                                                HeightRequest="36" WidthRequest="36">
                                            <Label FontFamily="Tabler" Text="&#xeb01;"
                                                   FontSize="18" TextColor="{StaticResource TextSecondary}"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Numero}"
                                                   FontSize="13" FontAttributes="Bold"
                                                   TextColor="{StaticResource TextPrimary}" />
                                            <Label Text="{Binding Date, StringFormat='{0:dd/MM/yyyy}'}"
                                                   FontSize="11" TextColor="{StaticResource TextMuted}" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="2"
                                                BackgroundColor="{StaticResource SecondaryLight}"
                                                StrokeShape="RoundRectangle 8" Stroke="Transparent"
                                                Padding="8,3" VerticalOptions="Center">
                                            <Label Text="{Binding Statut}"
                                                   FontSize="11" FontAttributes="Bold"
                                                   TextColor="{StaticResource TextPrimary}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>

                <!-- Cancel order button -->
                <Button Text="Annuler la commande"
                        Command="{Binding CancelOrderCommand}"
                        BackgroundColor="{StaticResource Danger}"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="44"
                        Margin="0,8,0,0"
                        IsVisible="{Binding CanCancel}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

                <!-- Reclamation toggle -->
                <Button Text="Soumettre une réclamation"
                        Command="{Binding ToggleReclamationFormCommand}"
                        BackgroundColor="{StaticResource DangerLight}"
                        TextColor="{StaticResource DangerText}"
                        CornerRadius="10"
                        HeightRequest="44"
                        Margin="0,8,0,0"
                        IsVisible="{Binding IsDelivered}" />

                <!-- Reclamation form -->
                <Border Padding="16"
                        BackgroundColor="{StaticResource CardBackground}"
                        StrokeShape="RoundRectangle 16"
                        Stroke="{StaticResource Danger}"
                        StrokeThickness="1"
                        IsVisible="{Binding ShowReclamationForm}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Réclamation"
                               FontAttributes="Bold" FontSize="15"
                               TextColor="{StaticResource TextPrimary}" />
                        <Border Stroke="{StaticResource BorderColor}"
                                BackgroundColor="{StaticResource SurfaceBackground}"
                                StrokeThickness="1" Padding="12,0" HeightRequest="48">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Entry Placeholder="Motif"
                                   Text="{Binding ReclamationMotif}"
                                   BackgroundColor="Transparent"
                                   TextColor="{StaticResource TextPrimary}"
                                   Margin="0" VerticalOptions="Center" />
                        </Border>
                        <Border Stroke="{StaticResource BorderColor}"
                                BackgroundColor="{StaticResource SurfaceBackground}"
                                StrokeThickness="1" Padding="12,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Editor Placeholder="Description"
                                    Text="{Binding ReclamationDescription}"
                                    MinimumHeightRequest="80"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource TextPrimary}"
                                    PlaceholderColor="{StaticResource TextMuted}" />
                        </Border>
                        <Button Text="Envoyer"
                                Command="{Binding SubmitReclamationCommand}"
                                BackgroundColor="{StaticResource Danger}"
                                TextColor="White"
                                CornerRadius="10"
                                HeightRequest="44"
                                Margin="0"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
        </RefreshView>

    </Grid>
</ContentPage>
