<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Cynapharm_Mobile.ViewModels.Orders"
             xmlns:models="clr-namespace:Cynapharm_Mobile.Models.Orders"
             xmlns:controls="clr-namespace:Cynapharm_Mobile.Controls"
             x:Class="Cynapharm_Mobile.Views.Orders.OrderListPage"
             x:DataType="vm:OrderListViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Primary}">
            <VerticalStackLayout Padding="20,52,20,20" Spacing="0">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                        <Label Text="Commandes"
                               FontSize="22" FontAttributes="Bold"
                               FontFamily="OpenSansSemibold"
                               TextColor="White" />
                        <Label Text="Suivi de vos commandes"
                               FontSize="12" TextColor="#CCF5FF" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1"
                            BackgroundColor="#26FFFFFF"
                            StrokeShape="RoundRectangle 20"
                            Stroke="Transparent" Padding="12,6"
                            VerticalOptions="Center"
                            IsVisible="{Binding IsGrossiste}">
                        <Label Text="{Binding Orders.Count, StringFormat='{0} cmd.'}"
                               FontSize="12" FontAttributes="Bold"
                               TextColor="White" />
                    </Border>
                </Grid>

                <!-- KPI strip (GROSSISTE) -->
                <Border BackgroundColor="#26FFFFFF"
                        StrokeShape="RoundRectangle 14"
                        Stroke="Transparent" Padding="16,12"
                        IsVisible="{Binding IsGrossiste}">
                    <Grid ColumnDefinitions="*,1,*" ColumnSpacing="0">
                        <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                            <Label Text="{Binding Orders.Count}"
                                   FontSize="22" FontAttributes="Bold"
                                   TextColor="White" HorizontalOptions="Center" />
                            <Label Text="Commandes" FontSize="11"
                                   TextColor="#CCF5FF" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <BoxView Grid.Column="1" BackgroundColor="#40FFFFFF"
                                 WidthRequest="1" VerticalOptions="Fill" />
                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                            <Label Text="Ce mois" FontSize="22" FontAttributes="Bold"
                                   TextColor="White" HorizontalOptions="Center" />
                            <Label Text="Volume" FontSize="11"
                                   TextColor="#CCF5FF" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </Grid>

        <!-- Error banner -->
        <controls:ErrorBanner Grid.Row="1"
                              Message="{Binding ErrorMessage}"
                              Margin="16,8,16,0" />

        <!-- ── Status filter chips ───────────────────────────────────────── -->
        <ScrollView Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    BackgroundColor="{StaticResource PageBackground}">
            <HorizontalStackLayout Padding="16,10" Spacing="8"
                                   BindableLayout.ItemsSource="{Binding StatusOptions}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border Padding="16,8"
                                StrokeThickness="1.5"
                                Stroke="{StaticResource BorderColor}"
                                BackgroundColor="{StaticResource CardBackground}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,1" Radius="4" Opacity="0.05" />
                            </Border.Shadow>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.StatusFilter}"
                                             Value="{Binding .}">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="Stroke"          Value="{StaticResource Primary}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="{Binding .}" FontSize="13"
                                   TextColor="{StaticResource TextSecondary}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.StatusFilter}"
                                                 Value="{Binding .}">
                                        <Setter Property="TextColor"      Value="White" />
                                        <Setter Property="FontAttributes" Value="Bold" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SetStatusFilterCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Result count -->
        <Label Grid.Row="3"
               Text="{Binding Orders.Count, StringFormat='{0} commande(s)'}"
               FontSize="12" FontAttributes="Bold"
               TextColor="{StaticResource TextSecondary}"
               Margin="20,4,20,0" />

        <!-- ── Order list ────────────────────────────────────────────────── -->
        <RefreshView Grid.Row="4"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing}"
                     RefreshColor="{StaticResource Primary}"
                     BackgroundColor="Transparent">
            <CollectionView ItemsSource="{Binding Orders}"
                            RemainingItemsThreshold="3"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                            ItemSizingStrategy="MeasureFirstItem"
                            BackgroundColor="Transparent">

                <CollectionView.Header>
                    <BoxView HeightRequest="6" Color="Transparent" />
                </CollectionView.Header>

                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                         Spacing="16" Padding="40" Margin="0,40,0,0">
                        <Border BackgroundColor="{StaticResource PrimaryLight}"
                                StrokeShape="RoundRectangle 50" Stroke="Transparent"
                                WidthRequest="80" HeightRequest="80" HorizontalOptions="Center">
                            <Label Text="📦" FontSize="38"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Aucune commande trouvée"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               HorizontalOptions="Center" />
                        <Label Text="Essayez de modifier le filtre de statut."
                               Style="{StaticResource EmptyStateStyle}" FontSize="13" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Order">
                        <Border Margin="16,0,16,10"
                                BackgroundColor="{StaticResource CardBackground}"
                                StrokeShape="RoundRectangle 16"
                                Stroke="{StaticResource BorderColor}" StrokeThickness="1"
                                Padding="0">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.06" />
                            </Border.Shadow>
                            <!-- Left accent stripe -->
                            <Grid ColumnDefinitions="5,*">
                                <BoxView Grid.Column="0" BackgroundColor="{StaticResource Primary}"
                                         VerticalOptions="Fill" />
                                <Grid Grid.Column="1"
                                      ColumnDefinitions="*,Auto"
                                      RowDefinitions="Auto,Auto"
                                      RowSpacing="6" Padding="14,14">
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="{Binding NumeroCommande, StringFormat='Commande #{0}'}"
                                           FontAttributes="Bold" FontSize="15"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="{StaticResource TextPrimary}" />
                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding MontantTTC, StringFormat='{0:#,##0.000} TND'}"
                                           FontAttributes="Bold" FontSize="14"
                                           TextColor="{StaticResource Primary}"
                                           VerticalOptions="Center" />
                                    <Label Grid.Row="1" Grid.Column="0"
                                           Text="{Binding DateCommande, StringFormat='Le {0:dd/MM/yyyy}'}"
                                           FontSize="12"
                                           TextColor="{StaticResource TextSecondary}" />
                                    <Border Grid.Row="1" Grid.Column="1"
                                            Padding="10,4"
                                            Stroke="Transparent"
                                            BackgroundColor="{StaticResource SecondaryLight}"
                                            VerticalOptions="Center"
                                            HorizontalOptions="End">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding StatutFrançais}"
                                               FontSize="11" FontAttributes="Bold"
                                               TextColor="{Binding Statut, Converter={StaticResource StatusColorConverter}}" />
                                    </Border>
                                </Grid>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.GoToDetailCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <VerticalStackLayout>
                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding HasMore}"
                                           Color="{StaticResource Primary}"
                                           HorizontalOptions="Center"
                                           Margin="0,8" />
                        <BoxView HeightRequest="8" Color="Transparent" />
                    </VerticalStackLayout>
                </CollectionView.Footer>

            </CollectionView>
        </RefreshView>

        <!-- ── Sticky CTA ─────────────────────────────────────────────────── -->
        <Grid Grid.Row="5" BackgroundColor="{StaticResource CardBackground}">
            <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}"
                     VerticalOptions="Start" />
            <Button Text="+ Nouvelle commande"
                    Command="{Binding CreateOrderCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="16,12,16,28" />
        </Grid>

    </Grid>
</ContentPage>
