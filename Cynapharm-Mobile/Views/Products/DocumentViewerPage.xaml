<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Cynapharm_Mobile.ViewModels.Products"
             xmlns:controls="clr-namespace:Cynapharm_Mobile.Controls"
             x:Class="Cynapharm_Mobile.Views.Products.DocumentViewerPage"
             x:DataType="vm:DocumentViewerViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="Black">

    <Grid RowDefinitions="Auto,*">

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Primary}"
              Padding="16,48,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BackgroundColor="#26FFFFFF" StrokeShape="RoundRectangle 12"
                    Stroke="Transparent" HeightRequest="38" WidthRequest="38"
                    VerticalOptions="Center">
                <Label Text="‹" FontSize="24" FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Border>

            <Label Grid.Column="1"
                   Text="{Binding NomFichier}"
                   FontSize="15" FontAttributes="Bold"
                   FontFamily="OpenSansSemibold"
                   TextColor="White"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   LineBreakMode="TailTruncation" />

            <!-- Download button -->
            <Border Grid.Column="2"
                    BackgroundColor="#26FFFFFF" StrokeShape="RoundRectangle 12"
                    Stroke="Transparent" HeightRequest="38" WidthRequest="38"
                    VerticalOptions="Center" HorizontalOptions="End">
                <Label FontFamily="Tabler" Text="&#xea96;"
                       FontSize="20" TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenExternalCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Border>
        </Grid>

        <!-- ── Content ───────────────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <WebView Source="{Binding PdfViewerUrl}"
                     IsVisible="{Binding IsImage, Converter={StaticResource InvertedBoolConverter}}"
                     VerticalOptions="FillAndExpand"
                     HorizontalOptions="FillAndExpand" />
            <ScrollView IsVisible="{Binding IsImage}"
                        VerticalOptions="FillAndExpand"
                        BackgroundColor="Black">
                <Image Source="{Binding Url}"
                       Aspect="AspectFit"
                       VerticalOptions="FillAndExpand"
                       HorizontalOptions="FillAndExpand"
                       MinimumHeightRequest="300" />
            </ScrollView>
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />
        </Grid>

    </Grid>
</ContentPage>
