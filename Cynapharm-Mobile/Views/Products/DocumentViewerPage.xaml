<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Cynapharm_Mobile.ViewModels.Products"
             xmlns:controls="clr-namespace:Cynapharm_Mobile.Controls"
             x:Class="Cynapharm_Mobile.Views.Products.DocumentViewerPage"
             x:DataType="vm:DocumentViewerViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource Primary}"
              Padding="16,48,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Text="‹"
                    TextColor="White"
                    BackgroundColor="Transparent"
                    FontSize="24" FontAttributes="Bold"
                    Padding="0"
                    Command="{Binding GoBackCommand}" />

            <Label Grid.Column="1"
                   Text="{Binding NomFichier}"
                   FontSize="16" FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   LineBreakMode="TailTruncation" />

            <!-- ti-download (U+EA96): open externally -->
            <Label Grid.Column="2"
                   FontFamily="Tabler"
                   Text="&#xea96;"
                   FontSize="22"
                   TextColor="White"
                   VerticalOptions="Center"
                   HorizontalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenExternalCommand}" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <!-- ── Content area ───────────────────────────────────────────────── -->
        <Grid Grid.Row="1">

            <!-- PDF / other files: WebView with Google Docs viewer -->
            <!-- Hidden when IsImage = true -->
            <WebView Source="{Binding PdfViewerUrl}"
                     IsVisible="{Binding IsImage, Converter={StaticResource InvertedBoolConverter}}"
                     VerticalOptions="FillAndExpand"
                     HorizontalOptions="FillAndExpand" />

            <!-- Image files: direct URL -->
            <!-- Hidden when IsImage = false -->
            <ScrollView IsVisible="{Binding IsImage}"
                        VerticalOptions="FillAndExpand">
                <Image Source="{Binding Url}"
                       Aspect="AspectFit"
                       VerticalOptions="FillAndExpand"
                       HorizontalOptions="FillAndExpand"
                       MinimumHeightRequest="300" />
            </ScrollView>

            <!-- Loading indicator -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />

        </Grid>

    </Grid>
</ContentPage>
