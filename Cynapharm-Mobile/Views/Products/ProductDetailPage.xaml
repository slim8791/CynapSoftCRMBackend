<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Cynapharm_Mobile.ViewModels.Products"
             xmlns:models="clr-namespace:Cynapharm_Mobile.Models.Products"
             xmlns:controls="clr-namespace:Cynapharm_Mobile.Controls"
             x:Class="Cynapharm_Mobile.Views.Products.ProductDetailPage"
             x:DataType="vm:ProductDetailViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <!-- Row 0: header  |  Row 1: scrollable body  |  Row 2: sticky CTA -->
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Primary}" Padding="16,48,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Back button -->
            <Border Grid.Column="0"
                    BackgroundColor="#22FFFFFF"
                    StrokeShape="RoundRectangle 10"
                    Stroke="Transparent"
                    HeightRequest="36" WidthRequest="36"
                    VerticalOptions="Center">
                <Label Text="‹" FontSize="22" FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Border>

            <!-- Title -->
            <Label Grid.Column="1"
                   Text="Fiche produit"
                   FontSize="17" FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center" VerticalOptions="Center" />

            <!-- Active / Inactive badge -->
            <Border Grid.Column="2"
                    StrokeShape="RoundRectangle 8"
                    Stroke="Transparent"
                    Padding="10,4"
                    VerticalOptions="Center"
                    IsVisible="{Binding Product, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                <Border.BackgroundColor>
                    <Color>#3300C853</Color>
                </Border.BackgroundColor>
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding Product.Actif}" Value="False">
                        <Setter Property="BackgroundColor" Value="#44E24B4A" />
                    </DataTrigger>
                </Border.Triggers>
                <Label FontSize="11" FontAttributes="Bold" TextColor="White">
                    <Label.Text>Actif</Label.Text>
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding Product.Actif}" Value="False">
                            <Setter Property="Text" Value="Inactif" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Border>
        </Grid>

        <!-- ── Body ──────────────────────────────────────────────────────── -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}"
                     Command="{Binding LoadCommand}"
                     RefreshColor="{StaticResource Primary}">
        <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Error + loading -->
            <controls:ErrorBanner Message="{Binding ErrorMessage}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}"
                               HorizontalOptions="Center"
                               Margin="0,16" />

            <!-- ── Hero image (edge-to-edge, no horizontal padding) ──────── -->
            <Grid HeightRequest="220"
                  IsVisible="{Binding Product, Converter={StaticResource IsNotNullOrEmptyConverter}}">

                <!-- Placeholder when no image -->
                <Border Stroke="Transparent" BackgroundColor="{StaticResource Primary}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="0" /></Border.StrokeShape>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border"
                                     Binding="{Binding Product.ImageUrl, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                                     Value="True">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Border.Triggers>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                        <Label Text="Rx" FontSize="56" FontAttributes="Bold"
                               TextColor="White" Opacity="0.75"
                               HorizontalOptions="Center" />
                        <Label Text="Produit pharmaceutique" FontSize="13"
                               TextColor="White" Opacity="0.50"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Product image -->
                <Border Stroke="Transparent"
                        IsVisible="{Binding Product.ImageUrl, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="0" /></Border.StrokeShape>
                    <Image Source="{Binding Product.ImageUrl}"
                           Aspect="AspectFill"
                           HeightRequest="220" />
                </Border>

            </Grid>

            <!-- ── Padded body content ────────────────────────────────────── -->
            <VerticalStackLayout Padding="16" Spacing="12"
                                 IsVisible="{Binding Product, Converter={StaticResource IsNotNullOrEmptyConverter}}">

                <!-- ── Product name + badges + price card ──────────────── -->
                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="12">

                        <!-- Name -->
                        <Label Text="{Binding Product.Nom}"
                               FontSize="22" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />

                        <!-- Category + reference chips -->
                        <HorizontalStackLayout Spacing="8">
                            <Border BackgroundColor="{StaticResource AccentLight}"
                                    Stroke="{StaticResource Accent}" StrokeThickness="1"
                                    Padding="10,4" StrokeShape="RoundRectangle 12"
                                    IsVisible="{Binding Product.Categorie, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                                <Label Text="{Binding Product.Categorie}"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="{StaticResource Accent}" />
                            </Border>
                            <Border BackgroundColor="{StaticResource SurfaceBackground}"
                                    Stroke="{StaticResource BorderColor}" StrokeThickness="1"
                                    Padding="10,4" StrokeShape="RoundRectangle 12"
                                    IsVisible="{Binding Product.Reference, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                                <Label Text="{Binding Product.Reference, StringFormat='Réf. {0}'}"
                                       FontSize="11" TextColor="{StaticResource TextSecondary}" />
                            </Border>
                        </HorizontalStackLayout>

                        <!-- Price block (hidden for MEDECIN) -->
                        <Border BackgroundColor="{StaticResource PrimaryLight}"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 12"
                                Padding="14,12"
                                IsVisible="{Binding CanSeePrices}">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Prix unitaire"
                                           FontSize="11"
                                           TextColor="{StaticResource TextMuted}" />
                                    <Label Text="{Binding Product.PrixUnitaire, StringFormat='{0:N3}'}"
                                           FontSize="30" FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1"
                                        BackgroundColor="{StaticResource Primary}"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="12,6"
                                        VerticalOptions="Center">
                                    <Label Text="TND" FontSize="14" FontAttributes="Bold"
                                           TextColor="White" />
                                </Border>
                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <!-- ── Description card ────────────────────────────────── -->
                <Border Style="{StaticResource CardStyle}"
                        IsVisible="{Binding Product.Description, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="DESCRIPTION"
                               FontSize="11" FontAttributes="Bold"
                               TextColor="{StaticResource TextMuted}"
                               CharacterSpacing="0.5" />
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" />
                        <Label Text="{Binding Product.Description}"
                               FontSize="14"
                               TextColor="{StaticResource TextPrimary}"
                               LineHeight="1.5" />
                    </VerticalStackLayout>
                </Border>

                <!-- ── Informations card ────────────────────────────────── -->
                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="INFORMATIONS"
                               FontSize="11" FontAttributes="Bold"
                               TextColor="{StaticResource TextMuted}"
                               CharacterSpacing="0.5"
                               Margin="0,0,0,8" />
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" Margin="0,0,0,4" />

                        <!-- Catégorie row -->
                        <Grid ColumnDefinitions="36,*" ColumnSpacing="12" Padding="2,8"
                              IsVisible="{Binding Product.Categorie, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource AccentLight}"
                                    StrokeShape="RoundRectangle 10" Stroke="Transparent"
                                    HeightRequest="36" WidthRequest="36">
                                <Label Text="🏷️" FontSize="15"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Catégorie" FontSize="11" TextColor="{StaticResource TextMuted}" />
                                <Label Text="{Binding Product.Categorie}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Statut row -->
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}"
                                 Margin="48,0,0,0"
                                 IsVisible="{Binding Product.Categorie, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                        <Grid ColumnDefinitions="36,*" ColumnSpacing="12" Padding="2,8">
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource PrimaryLight}"
                                    StrokeShape="RoundRectangle 10" Stroke="Transparent"
                                    HeightRequest="36" WidthRequest="36">
                                <Label FontSize="15"
                                       HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label.Text>✅</Label.Text>
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Product.Actif}" Value="False">
                                            <Setter Property="Text" Value="⛔" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Statut" FontSize="11" TextColor="{StaticResource TextMuted}" />
                                <Label FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}">
                                    <Label.Text>Actif</Label.Text>
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Product.Actif}" Value="False">
                                            <Setter Property="Text" Value="Inactif" />
                                            <Setter Property="TextColor" Value="{StaticResource Danger}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Prix vente row (hidden for MEDECIN) -->
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}"
                                 Margin="48,0,0,0" IsVisible="{Binding CanSeePrices}" />
                        <Grid ColumnDefinitions="36,*" ColumnSpacing="12" Padding="2,8"
                              IsVisible="{Binding CanSeePrices}">
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource PrimaryLight}"
                                    StrokeShape="RoundRectangle 10" Stroke="Transparent"
                                    HeightRequest="36" WidthRequest="36">
                                <Label Text="💰" FontSize="15"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Prix vente" FontSize="11" TextColor="{StaticResource TextMuted}" />
                                <Label Text="{Binding Product.PrixUnitaire, StringFormat='{0:N3} TND'}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}" />
                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- ── MEDECIN info banner ──────────────────────────────── -->
                <Border BackgroundColor="{StaticResource InfoBackground}"
                        StrokeShape="RoundRectangle 12" Stroke="Transparent"
                        Padding="14,14"
                        IsVisible="{Binding CanSeePrices, Converter={StaticResource InvertedBoolConverter}}">
                    <Grid ColumnDefinitions="32,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="💊" FontSize="22"
                               VerticalOptions="Center" HorizontalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="Pour toute demande d'échantillons, contactez votre délégué Cynapharm."
                               FontSize="13" TextColor="{StaticResource InfoText}" LineHeight="1.4" />
                    </Grid>
                </Border>

                <!-- ── Documents card ──────────────────────────────────── -->
                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="12">

                        <Label Text="DOCUMENTS"
                               FontSize="11" FontAttributes="Bold"
                               TextColor="{StaticResource TextMuted}"
                               CharacterSpacing="0.5" />
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" Margin="0,-4,0,0" />

                        <!-- Empty state -->
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,8"
                                             IsVisible="{Binding HasSupports, Converter={StaticResource InvertedBoolConverter}}">
                            <Label Text="📄" FontSize="32" HorizontalOptions="Center" />
                            <Label Text="Aucun document disponible"
                                   FontSize="13" TextColor="{StaticResource TextSecondary}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <!-- Supports list -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Supports}"
                                             Spacing="16"
                                             IsVisible="{Binding HasSupports}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:SupportMarketing">
                                    <VerticalStackLayout Spacing="8">

                                        <!-- Support type header -->
                                        <Grid ColumnDefinitions="30,*" ColumnSpacing="10">
                                            <Label Grid.Column="0"
                                                   FontFamily="Tabler" FontSize="20"
                                                   TextColor="{StaticResource Accent}"
                                                   VerticalOptions="Center" HorizontalOptions="Center">
                                                <Label.Text>&#xea5f;</Label.Text>
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="Video">
                                                        <Setter Property="Text" Value="&#xed22;" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="Presentation">
                                                        <Setter Property="Text" Value="&#xeb70;" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="PDF">
                                                        <Setter Property="Text" Value="&#xea5f;" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                <Label Text="{Binding Type}"
                                                       FontSize="13" FontAttributes="Bold"
                                                       TextColor="{StaticResource TextPrimary}" />
                                                <Label Text="{Binding CampaignName}"
                                                       FontSize="11" TextColor="{StaticResource TextMuted}"
                                                       IsVisible="{Binding CampaignName, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                                            </VerticalStackLayout>
                                        </Grid>

                                        <!-- File rows -->
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Fichiers}"
                                                             Spacing="6"
                                                             IsVisible="{Binding Fichiers.Count, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="models:Fichier">
                                                    <Border BackgroundColor="{StaticResource SurfaceBackground}"
                                                            Stroke="{StaticResource BorderColor}"
                                                            StrokeThickness="1"
                                                            Padding="12,10"
                                                            StrokeShape="RoundRectangle 10">
                                                        <Grid ColumnDefinitions="*,36,36" ColumnSpacing="6">

                                                            <!-- File name + extension -->
                                                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                                                <Label Text="{Binding NomFichier}"
                                                                       FontSize="13" FontAttributes="Bold"
                                                                       TextColor="{StaticResource TextPrimary}"
                                                                       LineBreakMode="TailTruncation" />
                                                                <Label Text="{Binding Extension}"
                                                                       FontSize="10"
                                                                       TextColor="{StaticResource TextMuted}"
                                                                       IsVisible="{Binding Extension, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                                                            </VerticalStackLayout>

                                                            <!-- ti-eye: open in-app viewer -->
                                                            <Border Grid.Column="1"
                                                                    BackgroundColor="{StaticResource AccentLight}"
                                                                    Stroke="Transparent"
                                                                    StrokeShape="RoundRectangle 8"
                                                                    HeightRequest="34" WidthRequest="34">
                                                                <Label FontFamily="Tabler" Text="&#xea9a;"
                                                                       FontSize="18"
                                                                       TextColor="{StaticResource Accent}"
                                                                       HorizontalOptions="Center" VerticalOptions="Center">
                                                                    <Label.GestureRecognizers>
                                                                        <TapGestureRecognizer
                                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ViewDocumentCommand}"
                                                                            CommandParameter="{Binding .}" />
                                                                    </Label.GestureRecognizers>
                                                                </Label>
                                                            </Border>

                                                            <!-- ti-download: open externally -->
                                                            <Border Grid.Column="2"
                                                                    BackgroundColor="{StaticResource PrimaryLight}"
                                                                    Stroke="Transparent"
                                                                    StrokeShape="RoundRectangle 8"
                                                                    HeightRequest="34" WidthRequest="34">
                                                                <Label FontFamily="Tabler" Text="&#xea96;"
                                                                       FontSize="18"
                                                                       TextColor="{StaticResource Primary}"
                                                                       HorizontalOptions="Center" VerticalOptions="Center">
                                                                    <Label.GestureRecognizers>
                                                                        <TapGestureRecognizer
                                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenDocumentCommand}"
                                                                            CommandParameter="{Binding Url}" />
                                                                    </Label.GestureRecognizers>
                                                                </Label>
                                                            </Border>

                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>

                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- ── Lots section ─────────────────────────────────────── -->
                <Label Text="LOTS DISPONIBLES"
                       FontSize="11" FontAttributes="Bold"
                       TextColor="{StaticResource TextMuted}"
                       CharacterSpacing="0.5"
                       Margin="0,4,0,0"
                       IsVisible="{Binding CanSeePrices}" />

                <CollectionView ItemsSource="{Binding Lots}" IsVisible="{Binding CanSeePrices}">
                    <CollectionView.EmptyView>
                        <Border BackgroundColor="{StaticResource SurfaceBackground}"
                                Stroke="{StaticResource BorderColor}" StrokeThickness="1"
                                StrokeShape="RoundRectangle 12" Padding="16,20">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                                <Label Text="📦" FontSize="28" HorizontalOptions="Center" />
                                <Label Text="Aucun lot disponible"
                                       FontSize="13" TextColor="{StaticResource TextSecondary}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Lot">
                            <Border Margin="0,0,0,8" Style="{StaticResource CardStyle}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

                                    <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                        <Label Text="{Binding NumeroLot, StringFormat='Lot N° {0}'}"
                                               FontAttributes="Bold" FontSize="15"
                                               TextColor="{StaticResource TextPrimary}" />
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                            <Label Grid.Column="0" Text="📅" FontSize="11"
                                                   VerticalOptions="Center" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding DateExpiration, StringFormat='Exp. {0:dd/MM/yyyy}'}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource TextSecondary}"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </VerticalStackLayout>

                                    <Border Grid.Column="1"
                                            BackgroundColor="{StaticResource Primary}"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="14,10"
                                            VerticalOptions="Center">
                                        <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                                            <Label Text="{Binding QuantiteDisponible}"
                                                   FontAttributes="Bold" FontSize="20"
                                                   TextColor="White"
                                                   HorizontalOptions="Center" />
                                            <Label Text="unités" FontSize="10"
                                                   TextColor="White" Opacity="0.75"
                                                   HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- ── Promotions section ───────────────────────────────── -->
                <Label Text="PROMOTIONS ACTIVES"
                       FontSize="11" FontAttributes="Bold"
                       TextColor="{StaticResource TextMuted}"
                       CharacterSpacing="0.5"
                       Margin="0,4,0,0"
                       IsVisible="{Binding CanSeePrices}" />

                <CollectionView ItemsSource="{Binding Promotions}" IsVisible="{Binding CanSeePrices}">
                    <CollectionView.EmptyView>
                        <Border BackgroundColor="{StaticResource SurfaceBackground}"
                                Stroke="{StaticResource BorderColor}" StrokeThickness="1"
                                StrokeShape="RoundRectangle 12" Padding="16,20">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                                <Label Text="🎁" FontSize="28" HorizontalOptions="Center" />
                                <Label Text="Aucune promotion active"
                                       FontSize="13" TextColor="{StaticResource TextSecondary}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Promotion">
                            <Border Margin="0,0,0,8"
                                    BackgroundColor="White"
                                    Stroke="{StaticResource BorderColor}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="0">
                                <!-- Left accent stripe + content -->
                                <Grid ColumnDefinitions="5,*">
                                    <BoxView Grid.Column="0"
                                             BackgroundColor="{StaticResource Secondary}"
                                             VerticalOptions="Fill" />
                                    <VerticalStackLayout Grid.Column="1" Padding="14,12" Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Titre}"
                                                   FontAttributes="Bold" FontSize="14"
                                                   TextColor="{StaticResource TextPrimary}"
                                                   VerticalOptions="Center" />
                                            <Border Grid.Column="1"
                                                    BackgroundColor="{StaticResource Secondary}"
                                                    Stroke="Transparent"
                                                    StrokeShape="RoundRectangle 12"
                                                    Padding="10,5">
                                                <Label Text="{Binding RemisePourcentage, StringFormat='-{0}%'}"
                                                       FontAttributes="Bold" FontSize="13"
                                                       TextColor="White" />
                                            </Border>
                                        </Grid>
                                        <Label Text="{Binding DateFin, StringFormat='Valable jusqu\'au {0:dd/MM/yyyy}'}"
                                               FontSize="12"
                                               TextColor="{StaticResource TextSecondary}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Bottom padding -->
                <BoxView HeightRequest="8" Color="Transparent" />

            </VerticalStackLayout>

        </VerticalStackLayout>
        </ScrollView>
        </RefreshView>

        <!-- ── Sticky CTA ─────────────────────────────────────────────── -->
        <VerticalStackLayout Grid.Row="2"
                             BackgroundColor="{StaticResource CardBackground}"
                             IsVisible="{Binding CanSeePrices}">
            <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" />
            <Button Text="Ajouter à une commande"
                    Command="{Binding AddToOrderCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="16,12,16,28" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>
