<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Cynapharm_Mobile.ViewModels.Products"
             xmlns:models="clr-namespace:Cynapharm_Mobile.Models.Products"
             xmlns:controls="clr-namespace:Cynapharm_Mobile.Controls"
             x:Class="Cynapharm_Mobile.Views.Products.ProductDetailPage"
             x:DataType="vm:ProductDetailViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <!-- Row 0: header  |  Row 1: scrollable body  |  Row 2: sticky CTA -->
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Primary}" Padding="16,48,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Back button -->
            <Border Grid.Column="0"
                    BackgroundColor="#26FFFFFF"
                    StrokeShape="RoundRectangle 12"
                    Stroke="Transparent"
                    HeightRequest="38" WidthRequest="38"
                    VerticalOptions="Center">
                <Label Text="‹" FontSize="24" FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Border>

            <!-- Title -->
            <Label Grid.Column="1"
                   Text="Fiche produit"
                   FontSize="17" FontAttributes="Bold"
                   FontFamily="OpenSansSemibold"
                   TextColor="White"
                   HorizontalOptions="Center" VerticalOptions="Center" />

            <!-- Active / Inactive badge (hidden for MEDECIN) -->
            <Border Grid.Column="2"
                    StrokeShape="RoundRectangle 12"
                    Stroke="Transparent"
                    Padding="12,5"
                    VerticalOptions="Center"
                    IsVisible="{Binding Product, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                <Border.BackgroundColor>
                    <Color>#3300C853</Color>
                </Border.BackgroundColor>
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding Product.Actif}" Value="False">
                        <Setter Property="BackgroundColor" Value="#44E24B4A" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding CanSeePrices}" Value="False">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Border.Triggers>
                <Label FontSize="11" FontAttributes="Bold" TextColor="White">
                    <Label.Text>Actif</Label.Text>
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding Product.Actif}" Value="False">
                            <Setter Property="Text" Value="Inactif" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Border>
        </Grid>

        <!-- ── Body ──────────────────────────────────────────────────────── -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}"
                     Command="{Binding LoadCommand}"
                     RefreshColor="{StaticResource Primary}">
        <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Error + loading -->
            <controls:ErrorBanner Message="{Binding ErrorMessage}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}"
                               HorizontalOptions="Center"
                               Margin="0,20" />

            <!-- ── Hero ─────────────────────────────────────────────────── -->
            <Grid HeightRequest="200"
                  IsVisible="{Binding Product, Converter={StaticResource IsNotNullOrEmptyConverter}}">

                <!-- Placeholder (no image) -->
                <Border Stroke="Transparent" BackgroundColor="{StaticResource Primary}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="0" /></Border.StrokeShape>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border"
                                     Binding="{Binding Product.ImageUrl, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                                     Value="True">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Border.Triggers>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                        <!-- Large icon pill -->
                        <Border BackgroundColor="#26FFFFFF"
                                StrokeShape="RoundRectangle 36"
                                Stroke="Transparent"
                                WidthRequest="96" HeightRequest="96"
                                HorizontalOptions="Center">
                            <Label Text="💊" FontSize="48"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Rx"
                               FontSize="22" FontAttributes="Bold"
                               TextColor="White" Opacity="0.9"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Actual product image -->
                <Border Stroke="Transparent"
                        IsVisible="{Binding Product.ImageUrl, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="0" /></Border.StrokeShape>
                    <Image Source="{Binding Product.ImageUrl}"
                           Aspect="AspectFill"
                           HeightRequest="200" />
                </Border>

                <!-- Gradient overlay at bottom for readability -->
                <BoxView VerticalOptions="End"
                         HeightRequest="60"
                         BackgroundColor="{StaticResource PageBackground}"
                         Opacity="0.55" />
            </Grid>

            <!-- ── Padded body content ────────────────────────────────────── -->
            <VerticalStackLayout Padding="16,12" Spacing="12"
                                 IsVisible="{Binding Product, Converter={StaticResource IsNotNullOrEmptyConverter}}">

                <!-- ── Name + badges + price ──────────────────────────────── -->
                <Border Style="{StaticResource CardStyle}" Padding="16,14">
                    <VerticalStackLayout Spacing="12">

                        <!-- Product name -->
                        <Label Text="{Binding Product.Nom}"
                               FontSize="22" FontAttributes="Bold"
                               FontFamily="OpenSansSemibold"
                               TextColor="{StaticResource TextPrimary}" />

                        <!-- Category + reference chips -->
                        <HorizontalStackLayout Spacing="8">
                            <Border BackgroundColor="{StaticResource AccentLight}"
                                    Stroke="{StaticResource Accent}" StrokeThickness="1"
                                    Padding="10,5" StrokeShape="RoundRectangle 12"
                                    IsVisible="{Binding Product.Categorie, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                                <Label Text="{Binding Product.Categorie}"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="{StaticResource Accent}" />
                            </Border>
                            <Border BackgroundColor="{StaticResource SurfaceBackground}"
                                    Stroke="{StaticResource BorderColor}" StrokeThickness="1"
                                    Padding="10,5" StrokeShape="RoundRectangle 12"
                                    IsVisible="{Binding Product.Reference, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                                <Label Text="{Binding Product.Reference, StringFormat='Réf. {0}'}"
                                       FontSize="11" TextColor="{StaticResource TextSecondary}" />
                            </Border>
                        </HorizontalStackLayout>

                        <!-- Price block (hidden for MEDECIN) -->
                        <Border BackgroundColor="{StaticResource PrimaryLight}"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 14"
                                Padding="16,14"
                                IsVisible="{Binding CanSeePrices}">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Prix unitaire"
                                           FontSize="11" TextColor="{StaticResource TextMuted}" />
                                    <Grid>
                                        <!-- Price defined: large number + TND unit -->
                                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6"
                                              IsVisible="{Binding Product.IsPriceDefined}">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Product.PrixUnitaire, StringFormat='{0:#,##0.000}'}"
                                                   FontSize="32" FontAttributes="Bold"
                                                   TextColor="{StaticResource Primary}" />
                                            <Label Grid.Column="1"
                                                   Text="TND"
                                                   FontSize="14" FontAttributes="Bold"
                                                   TextColor="{StaticResource PrimaryText}"
                                                   VerticalOptions="End"
                                                   Margin="0,0,0,6" />
                                        </Grid>
                                        <!-- Price not defined -->
                                        <Label Text="Prix non défini"
                                               FontSize="18" FontAttributes="Italic"
                                               TextColor="#AAAAAA"
                                               IsVisible="{Binding Product.IsPriceDefined, Converter={StaticResource InvertedBoolConverter}}" />
                                    </Grid>
                                </VerticalStackLayout>
                                <!-- Status pill on the right -->
                                <Border Grid.Column="1"
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="Transparent"
                                        Padding="12,6"
                                        VerticalOptions="Center">
                                    <Border.BackgroundColor>
                                        <Color>#2200C853</Color>
                                    </Border.BackgroundColor>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Product.Actif}" Value="False">
                                            <Setter Property="BackgroundColor" Value="{StaticResource DangerLight}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label FontSize="12" FontAttributes="Bold">
                                        <Label.TextColor>
                                            <Color>#00C853</Color>
                                        </Label.TextColor>
                                        <Label.Text>✓ Actif</Label.Text>
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Product.Actif}" Value="False">
                                                <Setter Property="Text" Value="✕ Inactif" />
                                                <Setter Property="TextColor" Value="{StaticResource Danger}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <!-- ── Description card ───────────────────────────────────── -->
                <Border Style="{StaticResource CardStyle}" Padding="16,14"
                        IsVisible="{Binding Product.Description, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                    <VerticalStackLayout Spacing="10">
                        <!-- Section header with left accent bar -->
                        <Grid ColumnDefinitions="4,*" ColumnSpacing="10">
                            <BoxView Grid.Column="0"
                                     BackgroundColor="{StaticResource Primary}"
                                     CornerRadius="2"
                                     VerticalOptions="Fill" WidthRequest="4" />
                            <Label Grid.Column="1"
                                   Text="Description"
                                   FontSize="13" FontAttributes="Bold"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" />
                        <Label Text="{Binding Product.Description}"
                               FontSize="14"
                               TextColor="{StaticResource TextPrimary}"
                               LineHeight="1.55" />
                    </VerticalStackLayout>
                </Border>

                <!-- ── Informations card (hidden for MEDECIN) ────────────── -->
                <Border Style="{StaticResource CardStyle}"
                        IsVisible="{Binding HasInformations}">
                    <VerticalStackLayout Spacing="0">
                        <!-- Section header -->
                        <Grid ColumnDefinitions="4,*" ColumnSpacing="10" Margin="0,0,0,10">
                            <BoxView Grid.Column="0"
                                     BackgroundColor="{StaticResource Secondary}"
                                     CornerRadius="2"
                                     VerticalOptions="Fill" WidthRequest="4" />
                            <Label Grid.Column="1"
                                   Text="Informations"
                                   FontSize="13" FontAttributes="Bold"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" Margin="0,0,0,4" />

                        <!-- Catégorie row -->
                        <Grid ColumnDefinitions="44,*" ColumnSpacing="12" Padding="2,10"
                              IsVisible="{Binding Product.Categorie, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource AccentLight}"
                                    StrokeShape="RoundRectangle 12" Stroke="Transparent"
                                    HeightRequest="40" WidthRequest="40">
                                <Label Text="🏷️" FontSize="16"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Catégorie" FontSize="11" TextColor="{StaticResource TextMuted}" />
                                <Label Text="{Binding Product.Categorie}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}"
                                 Margin="56,0,0,0"
                                 IsVisible="{Binding Product.Categorie, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                            <BoxView.Triggers>
                                <DataTrigger TargetType="BoxView"
                                             Binding="{Binding CanSeePrices}" Value="False">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </BoxView.Triggers>
                        </BoxView>

                        <!-- Statut row (hidden for MEDECIN) -->
                        <Grid ColumnDefinitions="44,*" ColumnSpacing="12" Padding="2,10"
                              IsVisible="{Binding CanSeePrices}">
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource PrimaryLight}"
                                    StrokeShape="RoundRectangle 12" Stroke="Transparent"
                                    HeightRequest="40" WidthRequest="40">
                                <Label FontSize="16"
                                       HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label.Text>✅</Label.Text>
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Product.Actif}" Value="False">
                                            <Setter Property="Text" Value="⛔" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Statut" FontSize="11" TextColor="{StaticResource TextMuted}" />
                                <Label FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}">
                                    <Label.Text>Actif</Label.Text>
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Product.Actif}" Value="False">
                                            <Setter Property="Text" Value="Inactif" />
                                            <Setter Property="TextColor" Value="{StaticResource Danger}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Prix vente row (hidden for MEDECIN) -->
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}"
                                 Margin="56,0,0,0" IsVisible="{Binding CanSeePrices}" />
                        <Grid ColumnDefinitions="44,*" ColumnSpacing="12" Padding="2,10"
                              IsVisible="{Binding CanSeePrices}">
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource PrimaryLight}"
                                    StrokeShape="RoundRectangle 12" Stroke="Transparent"
                                    HeightRequest="40" WidthRequest="40">
                                <Label Text="💰" FontSize="16"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Prix vente" FontSize="11" TextColor="{StaticResource TextMuted}" />
                                <Label Text="{Binding Product.PrixDisplay}"
                                       FontSize="14" FontAttributes="Bold">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding Product.IsPriceDefined}"
                                                     Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding Product.IsPriceDefined}"
                                                     Value="False">
                                            <Setter Property="TextColor" Value="#AAAAAA" />
                                            <Setter Property="FontAttributes" Value="Italic" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- ── MEDECIN info banner ─────────────────────────────────── -->
                <Border BackgroundColor="{StaticResource InfoBackground}"
                        StrokeShape="RoundRectangle 14"
                        Stroke="{StaticResource InfoText}" StrokeThickness="0.5"
                        Padding="16,14"
                        IsVisible="{Binding CanSeePrices, Converter={StaticResource InvertedBoolConverter}}">
                    <Grid ColumnDefinitions="38,*" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                BackgroundColor="#1A0C447C"
                                StrokeShape="RoundRectangle 12"
                                Stroke="Transparent"
                                WidthRequest="38" HeightRequest="38">
                            <Label Text="💊" FontSize="20"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1"
                               Text="Pour toute demande d'échantillons, contactez votre délégué Cynapharm."
                               FontSize="13" TextColor="{StaticResource InfoText}" LineHeight="1.5"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- ── Documents card ─────────────────────────────────────── -->
                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="12">

                        <!-- Section header -->
                        <Grid ColumnDefinitions="4,*" ColumnSpacing="10">
                            <BoxView Grid.Column="0"
                                     BackgroundColor="{StaticResource Primary}"
                                     CornerRadius="2"
                                     VerticalOptions="Fill" WidthRequest="4" />
                            <Label Grid.Column="1"
                                   Text="Documents"
                                   FontSize="13" FontAttributes="Bold"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" Margin="0,-4,0,0" />

                        <!-- Empty state -->
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="8" Margin="0,8"
                                             IsVisible="{Binding HasSupports, Converter={StaticResource InvertedBoolConverter}}">
                            <Border BackgroundColor="{StaticResource SurfaceBackground}"
                                    StrokeShape="RoundRectangle 40"
                                    Stroke="Transparent"
                                    WidthRequest="64" HeightRequest="64"
                                    HorizontalOptions="Center">
                                <Label Text="📄" FontSize="30"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="Aucun document disponible"
                                   FontSize="13" TextColor="{StaticResource TextSecondary}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <!-- Supports list -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Supports}"
                                             Spacing="16"
                                             IsVisible="{Binding HasSupports}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:SupportMarketing">
                                    <VerticalStackLayout Spacing="8">

                                        <!-- Support type header -->
                                        <Grid ColumnDefinitions="32,*" ColumnSpacing="10">
                                            <Border Grid.Column="0"
                                                    BackgroundColor="{StaticResource AccentLight}"
                                                    StrokeShape="RoundRectangle 8"
                                                    Stroke="Transparent"
                                                    WidthRequest="32" HeightRequest="32">
                                                <Label FontFamily="Tabler" FontSize="18"
                                                       TextColor="{StaticResource Accent}"
                                                       HorizontalOptions="Center" VerticalOptions="Center">
                                                    <Label.Text>&#xea5f;</Label.Text>
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="Video">
                                                            <Setter Property="Text" Value="&#xed22;" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="Presentation">
                                                            <Setter Property="Text" Value="&#xeb70;" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="PDF">
                                                            <Setter Property="Text" Value="&#xea5f;" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding Type}"
                                                       FontSize="13" FontAttributes="Bold"
                                                       TextColor="{StaticResource TextPrimary}" />
                                                <Label Text="{Binding CampaignName}"
                                                       FontSize="11" TextColor="{StaticResource TextMuted}"
                                                       IsVisible="{Binding CampaignName, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                                            </VerticalStackLayout>
                                        </Grid>

                                        <!-- File rows -->
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Fichiers}"
                                                             Spacing="6"
                                                             IsVisible="{Binding Fichiers.Count, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="models:Fichier">
                                                    <Border BackgroundColor="{StaticResource SurfaceBackground}"
                                                            Stroke="{StaticResource BorderColor}"
                                                            StrokeThickness="1"
                                                            Padding="12,10"
                                                            StrokeShape="RoundRectangle 12">
                                                        <Grid ColumnDefinitions="*,38,38" ColumnSpacing="8">

                                                            <!-- File name + extension -->
                                                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                                                <Label Text="{Binding NomFichier}"
                                                                       FontSize="13" FontAttributes="Bold"
                                                                       TextColor="{StaticResource TextPrimary}"
                                                                       LineBreakMode="TailTruncation" />
                                                                <Label Text="{Binding Extension}"
                                                                       FontSize="10"
                                                                       TextColor="{StaticResource TextMuted}"
                                                                       IsVisible="{Binding Extension, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                                                            </VerticalStackLayout>

                                                            <!-- View in-app -->
                                                            <Border Grid.Column="1"
                                                                    BackgroundColor="{StaticResource AccentLight}"
                                                                    Stroke="Transparent"
                                                                    StrokeShape="RoundRectangle 10"
                                                                    HeightRequest="36" WidthRequest="36">
                                                                <Label FontFamily="Tabler" Text="&#xea9a;"
                                                                       FontSize="18"
                                                                       TextColor="{StaticResource Accent}"
                                                                       HorizontalOptions="Center" VerticalOptions="Center">
                                                                    <Label.GestureRecognizers>
                                                                        <TapGestureRecognizer
                                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ViewDocumentCommand}"
                                                                            CommandParameter="{Binding .}" />
                                                                    </Label.GestureRecognizers>
                                                                </Label>
                                                            </Border>

                                                            <!-- Download / open externally -->
                                                            <Border Grid.Column="2"
                                                                    BackgroundColor="{StaticResource PrimaryLight}"
                                                                    Stroke="Transparent"
                                                                    StrokeShape="RoundRectangle 10"
                                                                    HeightRequest="36" WidthRequest="36">
                                                                <Label FontFamily="Tabler" Text="&#xea96;"
                                                                       FontSize="18"
                                                                       TextColor="{StaticResource Primary}"
                                                                       HorizontalOptions="Center" VerticalOptions="Center">
                                                                    <Label.GestureRecognizers>
                                                                        <TapGestureRecognizer
                                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenDocumentCommand}"
                                                                            CommandParameter="{Binding Url}" />
                                                                    </Label.GestureRecognizers>
                                                                </Label>
                                                            </Border>

                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>

                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- ── Lots section ───────────────────────────────────────── -->
                <Grid ColumnDefinitions="4,*" ColumnSpacing="10" Margin="0,4,0,0"
                      IsVisible="{Binding CanSeePrices}">
                    <BoxView Grid.Column="0"
                             BackgroundColor="{StaticResource Primary}"
                             CornerRadius="2" WidthRequest="4" />
                    <Label Grid.Column="1"
                           Text="Lots disponibles"
                           FontSize="13" FontAttributes="Bold"
                           FontFamily="OpenSansSemibold"
                           TextColor="{StaticResource TextPrimary}"
                           VerticalOptions="Center" />
                </Grid>

                <CollectionView ItemsSource="{Binding Lots}" IsVisible="{Binding CanSeePrices}">
                    <CollectionView.EmptyView>
                        <Border BackgroundColor="{StaticResource SurfaceBackground}"
                                Stroke="{StaticResource BorderColor}" StrokeThickness="1"
                                StrokeShape="RoundRectangle 14" Padding="16,22">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                                <Label Text="📦" FontSize="30" HorizontalOptions="Center" />
                                <Label Text="Aucun lot disponible"
                                       FontSize="13" TextColor="{StaticResource TextSecondary}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Lot">
                            <Border Margin="0,0,0,8"
                                    BackgroundColor="{StaticResource CardBackground}"
                                    Stroke="{StaticResource BorderColor}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="0">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.05" />
                                </Border.Shadow>
                                <!-- Left accent + content -->
                                <Grid ColumnDefinitions="5,*">
                                    <BoxView Grid.Column="0"
                                             BackgroundColor="{StaticResource Primary}"
                                             VerticalOptions="Fill" />
                                    <Grid Grid.Column="1"
                                          ColumnDefinitions="*,Auto"
                                          ColumnSpacing="12"
                                          Padding="14,14">
                                        <VerticalStackLayout Grid.Column="0" Spacing="5" VerticalOptions="Center">
                                            <Label Text="{Binding NumeroLot, StringFormat='Lot N° {0}'}"
                                                   FontAttributes="Bold" FontSize="15"
                                                   FontFamily="OpenSansSemibold"
                                                   TextColor="{StaticResource TextPrimary}" />
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                <Label Grid.Column="0" Text="📅" FontSize="12"
                                                       VerticalOptions="Center" />
                                                <Label Grid.Column="1"
                                                       Text="{Binding DateExpiration, StringFormat='Exp. {0:dd/MM/yyyy}'}"
                                                       FontSize="12"
                                                       TextColor="{StaticResource TextSecondary}"
                                                       VerticalOptions="Center" />
                                            </Grid>
                                        </VerticalStackLayout>

                                        <!-- Quantity badge -->
                                        <Border Grid.Column="1"
                                                BackgroundColor="{StaticResource Primary}"
                                                Stroke="Transparent"
                                                StrokeShape="RoundRectangle 14"
                                                Padding="16,12"
                                                VerticalOptions="Center">
                                            <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                                                <Label Text="{Binding QuantiteDisponible}"
                                                       FontAttributes="Bold" FontSize="22"
                                                       TextColor="White"
                                                       HorizontalOptions="Center" />
                                                <Label Text="unités" FontSize="10"
                                                       TextColor="White" Opacity="0.75"
                                                       HorizontalOptions="Center" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- ── Promotions section ──────────────────────────────────── -->
                <Grid ColumnDefinitions="4,*" ColumnSpacing="10" Margin="0,4,0,0"
                      IsVisible="{Binding CanSeePrices}">
                    <BoxView Grid.Column="0"
                             BackgroundColor="{StaticResource Secondary}"
                             CornerRadius="2" WidthRequest="4" />
                    <Label Grid.Column="1"
                           Text="Promotions actives"
                           FontSize="13" FontAttributes="Bold"
                           FontFamily="OpenSansSemibold"
                           TextColor="{StaticResource TextPrimary}"
                           VerticalOptions="Center" />
                </Grid>

                <CollectionView ItemsSource="{Binding Promotions}" IsVisible="{Binding CanSeePrices}">
                    <CollectionView.EmptyView>
                        <Border BackgroundColor="{StaticResource SurfaceBackground}"
                                Stroke="{StaticResource BorderColor}" StrokeThickness="1"
                                StrokeShape="RoundRectangle 14" Padding="16,22">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                                <Label Text="🎁" FontSize="30" HorizontalOptions="Center" />
                                <Label Text="Aucune promotion active"
                                       FontSize="13" TextColor="{StaticResource TextSecondary}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Promotion">
                            <Border Margin="0,0,0,8"
                                    BackgroundColor="{StaticResource CardBackground}"
                                    Stroke="{StaticResource BorderColor}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="0">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.05" />
                                </Border.Shadow>
                                <Grid ColumnDefinitions="5,*">
                                    <BoxView Grid.Column="0"
                                             BackgroundColor="{StaticResource Secondary}"
                                             VerticalOptions="Fill" />
                                    <Grid Grid.Column="1"
                                          ColumnDefinitions="*,Auto"
                                          ColumnSpacing="10"
                                          Padding="14,14">
                                        <VerticalStackLayout Grid.Column="0" Spacing="5" VerticalOptions="Center">
                                            <Label Text="{Binding Titre}"
                                                   FontAttributes="Bold" FontSize="14"
                                                   FontFamily="OpenSansSemibold"
                                                   TextColor="{StaticResource TextPrimary}"
                                                   LineBreakMode="TailTruncation" />
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                <Label Grid.Column="0" Text="🗓️" FontSize="11"
                                                       VerticalOptions="Center" />
                                                <Label Grid.Column="1"
                                                       Text="{Binding DateFin, StringFormat='Valable jusqu\'au {0:dd/MM/yyyy}'}"
                                                       FontSize="12"
                                                       TextColor="{StaticResource TextSecondary}"
                                                       VerticalOptions="Center" />
                                            </Grid>
                                        </VerticalStackLayout>

                                        <!-- Discount badge -->
                                        <Border Grid.Column="1"
                                                BackgroundColor="{StaticResource Secondary}"
                                                Stroke="Transparent"
                                                StrokeShape="RoundRectangle 14"
                                                Padding="14,10"
                                                VerticalOptions="Center">
                                            <VerticalStackLayout HorizontalOptions="Center" Spacing="0">
                                                <Label Text="{Binding RemisePourcentage, StringFormat='-{0}%'}"
                                                       FontAttributes="Bold" FontSize="18"
                                                       TextColor="White"
                                                       HorizontalOptions="Center" />
                                                <Label Text="remise"
                                                       FontSize="10" TextColor="White" Opacity="0.8"
                                                       HorizontalOptions="Center" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Bottom padding -->
                <BoxView HeightRequest="12" Color="Transparent" />

            </VerticalStackLayout>

        </VerticalStackLayout>
        </ScrollView>
        </RefreshView>

        <!-- ── Sticky CTA ─────────────────────────────────────────────────── -->
        <Grid Grid.Row="2"
              BackgroundColor="{StaticResource CardBackground}"
              IsVisible="{Binding CanSeePrices}">
            <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}"
                     VerticalOptions="Start" />
            <Grid ColumnDefinitions="*,Auto" Padding="16,12,16,28" ColumnSpacing="12">
                <!-- Price recap -->
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="1">
                    <Label Text="Prix unitaire" FontSize="11" TextColor="{StaticResource TextMuted}" />
                    <Label Text="{Binding Product.PrixDisplay}"
                           FontSize="16" FontAttributes="Bold">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding Product.IsPriceDefined}"
                                         Value="True">
                                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding Product.IsPriceDefined}"
                                         Value="False">
                                <Setter Property="TextColor" Value="#AAAAAA" />
                                <Setter Property="FontAttributes" Value="Italic" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
                <!-- CTA -->
                <Button Grid.Column="1"
                        Text="Ajouter à commande"
                        Command="{Binding AddToOrderCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HeightRequest="46"
                        Margin="0" />
            </Grid>
        </Grid>

    </Grid>
</ContentPage>
