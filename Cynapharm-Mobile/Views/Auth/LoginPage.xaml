<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Cynapharm_Mobile.Views.Auth.LoginPage"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24,64,24,32" Spacing="0">

            <!-- ── Branding ─────────────────────────────────────────────────── -->
            <VerticalStackLayout HorizontalOptions="Center" Spacing="12" Margin="0,0,0,40">

                <!-- Pharmacy icon -->
                <AbsoluteLayout WidthRequest="64" HeightRequest="64" HorizontalOptions="Center">
                    <Ellipse AbsoluteLayout.LayoutBounds="0,0,64,64"
                             Fill="{StaticResource BrandAccentFaint}" />
                    <Grid AbsoluteLayout.LayoutBounds="12.8,9.6,9.6,22.4" Rotation="-30">
                        <Border BackgroundColor="Transparent"
                                Stroke="{StaticResource BrandAccent}"
                                StrokeThickness="3.2">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="4.8" />
                            </Border.StrokeShape>
                        </Border>
                        <BoxView Color="{StaticResource BrandAccent}"
                                 HeightRequest="3.2" VerticalOptions="Center" />
                    </Grid>
                    <Path AbsoluteLayout.LayoutBounds="0,0,64,64"
                          Data="M 36.8 33.6 C 36.8 17.6 51.2 14.4 51.2 14.4 C 51.2 27.2 43.2 33.6 36.8 33.6 Z"
                          Fill="{StaticResource BrandAccent}" />
                    <Path AbsoluteLayout.LayoutBounds="0,0,64,64"
                          Data="M 20.8 33.6 H 43.2 A 1.6 1.6 0 0 1 44.8 35.2 V 38.4 A 1.6 1.6 0 0 1 43.2 40 H 20.8 A 1.6 1.6 0 0 1 19.2 38.4 V 35.2 A 1.6 1.6 0 0 1 20.8 33.6 Z"
                          Fill="{StaticResource BrandAccent}" />
                    <Path AbsoluteLayout.LayoutBounds="0,0,64,64"
                          Data="M 22.4 40 V 46.4 A 4.8 4.8 0 0 0 27.2 51.2 H 36.8 A 4.8 4.8 0 0 0 41.6 46.4 V 40"
                          Stroke="{StaticResource BrandAccent}"
                          StrokeThickness="3.2" Fill="Transparent" />
                </AbsoluteLayout>

                <!-- CynaPharm wordmark -->
                <Label HorizontalOptions="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Cyna"
                                  TextColor="{StaticResource PrimaryTextColor}"
                                  FontSize="26"
                                  FontFamily="OpenSansRegular" />
                            <Span Text="Pharm"
                                  TextColor="{StaticResource BrandAccent}"
                                  FontSize="26"
                                  FontAttributes="Bold"
                                  FontFamily="OpenSansSemibold" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Label Text="Plateforme commerciale terrain"
                       TextColor="{StaticResource SecondaryTextColor}"
                       FontSize="13"
                       HorizontalOptions="Center" />

            </VerticalStackLayout>

            <!-- ── Login card ───────────────────────────────────────────────── -->
            <Border BackgroundColor="{StaticResource CardBackgroundColor}"
                    Stroke="{StaticResource SurfaceStrokeColor}"
                    StrokeThickness="1"
                    Padding="24,28">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Black}" Offset="0,2" Radius="16" Opacity="0.06" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="24">

                    <!-- Card header -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Connexion"
                               FontSize="20" FontAttributes="Bold"
                               TextColor="{StaticResource PrimaryTextColor}" />
                        <Label Text="Accédez à votre espace de travail"
                               TextColor="{StaticResource SecondaryTextColor}"
                               FontSize="13" />
                    </VerticalStackLayout>

                    <!-- Error banner -->
                    <Border BackgroundColor="{StaticResource ErrorLight}"
                            Stroke="{StaticResource ErrorColor}"
                            StrokeThickness="1" Padding="12,10"
                            IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="{StaticResource ErrorColor}"
                               FontSize="13" />
                    </Border>

                    <!-- ── Email field — underline style ────────────────────── -->
                    <VerticalStackLayout Spacing="0">
                        <Label Text="IDENTIFIANT OU EMAIL"
                               FontSize="11" FontAttributes="Bold"
                               TextColor="{StaticResource SecondaryTextColor}"
                               CharacterSpacing="0.5"
                               Margin="0,0,0,8" />
                        <Grid ColumnDefinitions="20,10,*" HeightRequest="36">
                            <Path Grid.Column="0"
                                  Data="M20 4H4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V6C22 4.9 21.1 4 20 4ZM20 8L12 13L4 8V6L12 11L20 6V8Z"
                                  Fill="{StaticResource SecondaryTextColor}"
                                  WidthRequest="18" HeightRequest="18"
                                  Aspect="Uniform"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center" />
                            <Entry Grid.Column="2"
                                   x:Name="EmailEntry"
                                   Placeholder="votre@email.com"
                                   Text="{Binding Email}"
                                   Keyboard="Email"
                                   BackgroundColor="Transparent"
                                   TextColor="{StaticResource PrimaryTextColor}"
                                   PlaceholderColor="{StaticResource SecondaryTextColor}"
                                   FontSize="15"
                                   VerticalOptions="Center"
                                   Focused="EmailEntry_Focused"
                                   Unfocused="EmailEntry_Unfocused"
                                   SemanticProperties.Description="Champ identifiant ou email" />
                        </Grid>
                        <BoxView x:Name="EmailUnderline"
                                 HeightRequest="1.5"
                                 Color="{StaticResource FieldBorderInactive}" />
                    </VerticalStackLayout>

                    <!-- ── Password field — underline style ─────────────────── -->
                    <VerticalStackLayout Spacing="0">
                        <Label Text="MOT DE PASSE"
                               FontSize="11" FontAttributes="Bold"
                               TextColor="{StaticResource SecondaryTextColor}"
                               CharacterSpacing="0.5"
                               Margin="0,0,0,8" />
                        <Grid ColumnDefinitions="20,10,*,36" HeightRequest="36">
                            <!-- Lock icon -->
                            <Path Grid.Column="0"
                                  Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"
                                  Fill="{StaticResource SecondaryTextColor}"
                                  WidthRequest="18" HeightRequest="18"
                                  Aspect="Uniform"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center" />
                            <!-- Password entry -->
                            <Entry Grid.Column="2"
                                   x:Name="PasswordEntry"
                                   Placeholder="••••••••"
                                   Text="{Binding Password}"
                                   IsPassword="{Binding IsPasswordHidden}"
                                   BackgroundColor="Transparent"
                                   TextColor="{StaticResource PrimaryTextColor}"
                                   PlaceholderColor="{StaticResource SecondaryTextColor}"
                                   FontSize="15"
                                   VerticalOptions="Center"
                                   Focused="PasswordEntry_Focused"
                                   Unfocused="PasswordEntry_Unfocused"
                                   SemanticProperties.Description="Champ mot de passe" />
                            <!-- Eye toggle -->
                            <Grid Grid.Column="3"
                                  VerticalOptions="Center"
                                  HorizontalOptions="Center">
                                <Path Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5ZM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5Zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3Z"
                                      Fill="{StaticResource SecondaryTextColor}"
                                      WidthRequest="20" HeightRequest="20" Aspect="Uniform"
                                      HorizontalOptions="Center" VerticalOptions="Center"
                                      IsVisible="{Binding IsPasswordHidden}" />
                                <Path Data="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7ZM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27Z"
                                      Fill="{StaticResource SecondaryTextColor}"
                                      WidthRequest="20" HeightRequest="20" Aspect="Uniform"
                                      HorizontalOptions="Center" VerticalOptions="Center"
                                      IsVisible="{Binding IsPasswordHidden, Converter={StaticResource InvertedBoolConverter}}" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TogglePasswordVisibilityCommand}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </Grid>
                        <BoxView x:Name="PasswordUnderline"
                                 HeightRequest="1.5"
                                 Color="{StaticResource FieldBorderInactive}" />
                    </VerticalStackLayout>

                    <!-- Forgot password — right-aligned, teal -->
                    <Label Text="Mot de passe oublié ?"
                           TextColor="{StaticResource BrandAccent}"
                           FontSize="13" FontAttributes="Bold"
                           HorizontalOptions="End"
                           HorizontalTextAlignment="End">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToForgotPasswordCommand}" />
                        </Label.GestureRecognizers>
                    </Label>

                    <!-- Actions -->
                    <VerticalStackLayout Spacing="12" Margin="0,4,0,0">
                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           Color="{StaticResource BrandAccent}"
                                           HorizontalOptions="Center" />
                        <Button Text="Se connecter"
                                Command="{Binding LoginCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                                BackgroundColor="{StaticResource BrandAccent}"
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="52"
                                FontSize="15"
                                FontAttributes="Bold"
                                SemanticProperties.Description="Bouton de connexion" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Footer -->
            <Label Text="© 2026 CynaPharm · Tous droits réservés"
                   TextColor="{StaticResource SecondaryTextColor}"
                   FontSize="11"
                   HorizontalOptions="Center"
                   Margin="0,32,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
