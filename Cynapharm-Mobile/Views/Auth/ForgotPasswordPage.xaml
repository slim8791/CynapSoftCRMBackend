<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Cynapharm_Mobile.Views.Auth.ForgotPasswordPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="24,64,24,32" Spacing="0">

            <!-- ── Branding ─────────────────────────────────────────────────── -->
            <VerticalStackLayout HorizontalOptions="Center" Spacing="14" Margin="0,0,0,36">
                <AbsoluteLayout WidthRequest="80" HeightRequest="80" HorizontalOptions="Center">
                    <Border AbsoluteLayout.LayoutBounds="0,0,80,80"
                            BackgroundColor="{StaticResource PrimaryLight}"
                            StrokeShape="RoundRectangle 24"
                            Stroke="Transparent" />
                    <Ellipse AbsoluteLayout.LayoutBounds="4,4,72,72"
                             Fill="{StaticResource BrandAccentFaint}" />
                    <Grid AbsoluteLayout.LayoutBounds="16,12,12,28" Rotation="-30">
                        <Border BackgroundColor="Transparent"
                                Stroke="{StaticResource BrandAccent}"
                                StrokeThickness="3.2">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="4.8" />
                            </Border.StrokeShape>
                        </Border>
                        <BoxView Color="{StaticResource BrandAccent}"
                                 HeightRequest="3.2" VerticalOptions="Center" />
                    </Grid>
                    <Path AbsoluteLayout.LayoutBounds="0,0,80,80"
                          Data="M 46 42 C 46 22 64 18 64 18 C 64 34 54 42 46 42 Z"
                          Fill="{StaticResource BrandAccent}" />
                    <Path AbsoluteLayout.LayoutBounds="0,0,80,80"
                          Data="M 26 42 H 54 A 2 2 0 0 1 56 44 V 48 A 2 2 0 0 1 54 50 H 26 A 2 2 0 0 1 24 48 V 44 A 2 2 0 0 1 26 42 Z"
                          Fill="{StaticResource BrandAccent}" />
                    <Path AbsoluteLayout.LayoutBounds="0,0,80,80"
                          Data="M 28 50 V 58 A 6 6 0 0 0 34 64 H 46 A 6 6 0 0 0 52 58 V 50"
                          Stroke="{StaticResource BrandAccent}"
                          StrokeThickness="3.2" Fill="Transparent" />
                </AbsoluteLayout>
                <Label HorizontalOptions="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Cyna"
                                  TextColor="{StaticResource PrimaryTextColor}"
                                  FontSize="28" FontFamily="OpenSansRegular" />
                            <Span Text="Pharm"
                                  TextColor="{StaticResource BrandAccent}"
                                  FontSize="28" FontAttributes="Bold"
                                  FontFamily="OpenSansSemibold" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label Text="Plateforme commerciale terrain"
                       TextColor="{StaticResource SecondaryTextColor}"
                       FontSize="13" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- ── Card ─────────────────────────────────────────────────────── -->
            <Border BackgroundColor="{StaticResource CardBackgroundColor}"
                    Stroke="{StaticResource SurfaceStrokeColor}"
                    StrokeThickness="1"
                    Padding="24,28">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Black}" Offset="0,4" Radius="20" Opacity="0.08" />
                </Border.Shadow>

                <Grid>

                    <!-- ── STATE 1: Form ──────────────────────────────────── -->
                    <VerticalStackLayout Spacing="22">
                        <VerticalStackLayout.Triggers>
                            <DataTrigger TargetType="VerticalStackLayout"
                                         Binding="{Binding SuccessMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                                         Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </VerticalStackLayout.Triggers>

                        <!-- Back + title -->
                        <Grid ColumnDefinitions="40,*" ColumnSpacing="12">
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource BrandAccentFaint}"
                                    Stroke="Transparent"
                                    HeightRequest="38" WidthRequest="38"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="‹" FontSize="22" FontAttributes="Bold"
                                       TextColor="{StaticResource BrandAccent}"
                                       HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="Réinitialiser"
                                       FontSize="22" FontAttributes="Bold"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource PrimaryTextColor}" />
                                <Label Text="Entrez votre email pour recevoir un lien"
                                       TextColor="{StaticResource SecondaryTextColor}"
                                       FontSize="13" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Error banner -->
                        <Border BackgroundColor="{StaticResource ErrorLight}"
                                Stroke="{StaticResource ErrorColor}"
                                StrokeThickness="1" Padding="14,10"
                                IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Grid.Column="0" Text="⚠️" FontSize="14"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding ErrorMessage}"
                                       TextColor="{StaticResource ErrorColor}"
                                       FontSize="13" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Email field -->
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Adresse email"
                                   FontSize="12" FontAttributes="Bold"
                                   TextColor="{StaticResource SecondaryTextColor}"
                                   Margin="0,0,0,8" />
                            <Grid ColumnDefinitions="20,10,*" HeightRequest="38">
                                <Path Grid.Column="0"
                                      Data="M20 4H4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V6C22 4.9 21.1 4 20 4ZM20 8L12 13L4 8V6L12 11L20 6V8Z"
                                      Fill="{StaticResource SecondaryTextColor}"
                                      WidthRequest="18" HeightRequest="18"
                                      Aspect="Uniform"
                                      HorizontalOptions="Center" VerticalOptions="Center" />
                                <Entry Grid.Column="2"
                                       x:Name="EmailEntry"
                                       Placeholder="votre@email.com"
                                       Text="{Binding Email}"
                                       Keyboard="Email"
                                       BackgroundColor="Transparent"
                                       TextColor="{StaticResource PrimaryTextColor}"
                                       PlaceholderColor="{StaticResource SecondaryTextColor}"
                                       FontSize="15"
                                       VerticalOptions="Center"
                                       Focused="EmailEntry_Focused"
                                       Unfocused="EmailEntry_Unfocused"
                                       SemanticProperties.Description="Champ adresse email" />
                            </Grid>
                            <BoxView x:Name="EmailUnderline"
                                     HeightRequest="2"
                                     CornerRadius="1"
                                     Color="{StaticResource FieldBorderInactive}" />
                        </VerticalStackLayout>

                        <!-- Submit -->
                        <VerticalStackLayout Spacing="12" Margin="0,2,0,0">
                            <ActivityIndicator IsRunning="{Binding IsBusy}"
                                               IsVisible="{Binding IsBusy}"
                                               Color="{StaticResource BrandAccent}"
                                               HorizontalOptions="Center" />
                            <Button Text="Envoyer le lien"
                                    Command="{Binding SendResetCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                                    BackgroundColor="{StaticResource BrandAccent}"
                                    TextColor="White"
                                    CornerRadius="14"
                                    HeightRequest="54"
                                    FontSize="15"
                                    FontAttributes="Bold" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>

                    <!-- ── STATE 2: Success ───────────────────────────────── -->
                    <VerticalStackLayout Spacing="20" IsVisible="False">
                        <VerticalStackLayout.Triggers>
                            <DataTrigger TargetType="VerticalStackLayout"
                                         Binding="{Binding SuccessMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                                         Value="True">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </VerticalStackLayout.Triggers>

                        <!-- Success icon -->
                        <Border BackgroundColor="{StaticResource PrimaryLight}"
                                StrokeShape="RoundRectangle 50"
                                Stroke="Transparent"
                                WidthRequest="90" HeightRequest="90"
                                HorizontalOptions="Center">
                            <Grid>
                                <Ellipse WidthRequest="80" HeightRequest="80"
                                         Fill="{StaticResource BrandAccentFaint}"
                                         HorizontalOptions="Center" VerticalOptions="Center" />
                                <Path Data="M6 12 L10 16 L18 8"
                                      Stroke="{StaticResource BrandAccent}"
                                      StrokeThickness="2.5"
                                      WidthRequest="24" HeightRequest="24"
                                      Aspect="Uniform"
                                      HorizontalOptions="Center" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="Email envoyé !"
                                   FontSize="22" FontAttributes="Bold"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource PrimaryTextColor}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{Binding SuccessMessage}"
                                   FontSize="14"
                                   TextColor="{StaticResource SecondaryTextColor}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   LineHeight="1.4" />
                        </VerticalStackLayout>

                        <Button Text="Retour à la connexion"
                                Command="{Binding GoBackCommand}"
                                BackgroundColor="{StaticResource BrandAccent}"
                                TextColor="White"
                                CornerRadius="14"
                                HeightRequest="54"
                                FontSize="15"
                                FontAttributes="Bold" />

                    </VerticalStackLayout>

                </Grid>
            </Border>

            <!-- Footer -->
            <Label Text="© 2026 CynaPharm · Tous droits réservés"
                   TextColor="{StaticResource SecondaryTextColor}"
                   FontSize="11"
                   HorizontalOptions="Center"
                   Margin="0,28,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
