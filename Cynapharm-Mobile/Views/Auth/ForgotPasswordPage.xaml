<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Cynapharm_Mobile.Views.Auth.ForgotPasswordPage"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24,64,24,32" Spacing="0">

            <!-- ── Branding ─────────────────────────────────────────────────── -->
            <VerticalStackLayout HorizontalOptions="Center" Spacing="12" Margin="0,0,0,40">

                <!-- Pharmacy icon -->
                <AbsoluteLayout WidthRequest="64" HeightRequest="64" HorizontalOptions="Center">
                    <Ellipse AbsoluteLayout.LayoutBounds="0,0,64,64"
                             Fill="{StaticResource BrandAccentFaint}" />
                    <Grid AbsoluteLayout.LayoutBounds="12.8,9.6,9.6,22.4" Rotation="-30">
                        <Border BackgroundColor="Transparent"
                                Stroke="{StaticResource BrandAccent}"
                                StrokeThickness="3.2">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="4.8" />
                            </Border.StrokeShape>
                        </Border>
                        <BoxView Color="{StaticResource BrandAccent}"
                                 HeightRequest="3.2" VerticalOptions="Center" />
                    </Grid>
                    <Path AbsoluteLayout.LayoutBounds="0,0,64,64"
                          Data="M 36.8 33.6 C 36.8 17.6 51.2 14.4 51.2 14.4 C 51.2 27.2 43.2 33.6 36.8 33.6 Z"
                          Fill="{StaticResource BrandAccent}" />
                    <Path AbsoluteLayout.LayoutBounds="0,0,64,64"
                          Data="M 20.8 33.6 H 43.2 A 1.6 1.6 0 0 1 44.8 35.2 V 38.4 A 1.6 1.6 0 0 1 43.2 40 H 20.8 A 1.6 1.6 0 0 1 19.2 38.4 V 35.2 A 1.6 1.6 0 0 1 20.8 33.6 Z"
                          Fill="{StaticResource BrandAccent}" />
                    <Path AbsoluteLayout.LayoutBounds="0,0,64,64"
                          Data="M 22.4 40 V 46.4 A 4.8 4.8 0 0 0 27.2 51.2 H 36.8 A 4.8 4.8 0 0 0 41.6 46.4 V 40"
                          Stroke="{StaticResource BrandAccent}"
                          StrokeThickness="3.2" Fill="Transparent" />
                </AbsoluteLayout>

                <!-- CynaPharm wordmark -->
                <Label HorizontalOptions="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Cyna"
                                  TextColor="{StaticResource PrimaryTextColor}"
                                  FontSize="26"
                                  FontFamily="OpenSansRegular" />
                            <Span Text="Pharm"
                                  TextColor="{StaticResource BrandAccent}"
                                  FontSize="26"
                                  FontAttributes="Bold"
                                  FontFamily="OpenSansSemibold" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Label Text="Plateforme commerciale terrain"
                       TextColor="{StaticResource SecondaryTextColor}"
                       FontSize="13"
                       HorizontalOptions="Center" />

            </VerticalStackLayout>

            <!-- ── Card ────────────────────────────────────────────────────── -->
            <Border BackgroundColor="{StaticResource CardBackgroundColor}"
                    Stroke="{StaticResource SurfaceStrokeColor}"
                    StrokeThickness="1"
                    Padding="24,28">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Black}" Offset="0,2" Radius="16" Opacity="0.06" />
                </Border.Shadow>

                <Grid>

                    <!-- ══════════════════════════════════════════
                         STATE 1 — Form (visible by default)
                         ══════════════════════════════════════════ -->
                    <VerticalStackLayout Spacing="24">
                        <VerticalStackLayout.Triggers>
                            <DataTrigger TargetType="VerticalStackLayout"
                                         Binding="{Binding SuccessMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                                         Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </VerticalStackLayout.Triggers>

                        <!-- Card header: back button + title -->
                        <Grid ColumnDefinitions="36,*" ColumnSpacing="12">
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource BrandAccentFaint}"
                                    Stroke="Transparent"
                                    HeightRequest="36" WidthRequest="36"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>
                                <Label Text="‹"
                                       FontSize="22" FontAttributes="Bold"
                                       TextColor="{StaticResource BrandAccent}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="Réinitialiser"
                                       FontSize="20" FontAttributes="Bold"
                                       TextColor="{StaticResource PrimaryTextColor}" />
                                <Label Text="Entrez votre email pour recevoir un lien"
                                       TextColor="{StaticResource SecondaryTextColor}"
                                       FontSize="13" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Error banner -->
                        <Border BackgroundColor="{StaticResource ErrorLight}"
                                Stroke="{StaticResource ErrorColor}"
                                StrokeThickness="1" Padding="12,10"
                                IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Label Text="{Binding ErrorMessage}"
                                   TextColor="{StaticResource ErrorColor}"
                                   FontSize="13" />
                        </Border>

                        <!-- ── Email field — underline style ────────────────── -->
                        <VerticalStackLayout Spacing="0">
                            <Label Text="ADRESSE EMAIL"
                                   FontSize="11" FontAttributes="Bold"
                                   TextColor="{StaticResource SecondaryTextColor}"
                                   CharacterSpacing="0.5"
                                   Margin="0,0,0,8" />
                            <Grid ColumnDefinitions="20,10,*" HeightRequest="36">
                                <Path Grid.Column="0"
                                      Data="M20 4H4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V6C22 4.9 21.1 4 20 4ZM20 8L12 13L4 8V6L12 11L20 6V8Z"
                                      Fill="{StaticResource SecondaryTextColor}"
                                      WidthRequest="18" HeightRequest="18"
                                      Aspect="Uniform"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center" />
                                <Entry Grid.Column="2"
                                       x:Name="EmailEntry"
                                       Placeholder="votre@email.com"
                                       Text="{Binding Email}"
                                       Keyboard="Email"
                                       BackgroundColor="Transparent"
                                       TextColor="{StaticResource PrimaryTextColor}"
                                       PlaceholderColor="{StaticResource SecondaryTextColor}"
                                       FontSize="15"
                                       VerticalOptions="Center"
                                       Focused="EmailEntry_Focused"
                                       Unfocused="EmailEntry_Unfocused"
                                       SemanticProperties.Description="Champ adresse email" />
                            </Grid>
                            <BoxView x:Name="EmailUnderline"
                                     HeightRequest="1.5"
                                     Color="{StaticResource FieldBorderInactive}" />
                        </VerticalStackLayout>

                        <!-- Submit -->
                        <VerticalStackLayout Spacing="12" Margin="0,4,0,0">
                            <ActivityIndicator IsRunning="{Binding IsBusy}"
                                               IsVisible="{Binding IsBusy}"
                                               Color="{StaticResource BrandAccent}"
                                               HorizontalOptions="Center" />
                            <Button Text="Envoyer le lien"
                                    Command="{Binding SendResetCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                                    BackgroundColor="{StaticResource BrandAccent}"
                                    TextColor="White"
                                    CornerRadius="12"
                                    HeightRequest="52"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    SemanticProperties.Description="Envoyer le lien de réinitialisation" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>

                    <!-- ══════════════════════════════════════════
                         STATE 2 — Success (hidden by default)
                         ══════════════════════════════════════════ -->
                    <VerticalStackLayout Spacing="24" IsVisible="False">
                        <VerticalStackLayout.Triggers>
                            <DataTrigger TargetType="VerticalStackLayout"
                                         Binding="{Binding SuccessMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                                         Value="True">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </VerticalStackLayout.Triggers>

                        <!-- Success icon -->
                        <Grid HorizontalOptions="Center" WidthRequest="80" HeightRequest="80">
                            <Ellipse WidthRequest="80" HeightRequest="80"
                                     Fill="{StaticResource BrandAccentFaint}"
                                     HorizontalOptions="Center" VerticalOptions="Center" />
                            <Path Data="M6 12 L10 16 L18 8"
                                  Stroke="{StaticResource BrandAccent}"
                                  StrokeThickness="2.5"
                                  WidthRequest="24" HeightRequest="24"
                                  Aspect="Uniform"
                                  HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>

                        <!-- Message -->
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="Email envoyé !"
                                   FontSize="20" FontAttributes="Bold"
                                   TextColor="{StaticResource PrimaryTextColor}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{Binding SuccessMessage}"
                                   FontSize="14"
                                   TextColor="{StaticResource SecondaryTextColor}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <!-- Back to login -->
                        <Button Text="Retour à la connexion"
                                Command="{Binding GoBackCommand}"
                                BackgroundColor="{StaticResource BrandAccent}"
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="52"
                                FontSize="15"
                                FontAttributes="Bold" />

                    </VerticalStackLayout>

                </Grid>
            </Border>

            <!-- Footer -->
            <Label Text="© 2026 CynaPharm · Tous droits réservés"
                   TextColor="{StaticResource SecondaryTextColor}"
                   FontSize="11"
                   HorizontalOptions="Center"
                   Margin="0,32,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
