<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Cynapharm_Mobile.ViewModels.Rapports"
             xmlns:products="clr-namespace:Cynapharm_Mobile.Models.Products"
             xmlns:controls="clr-namespace:Cynapharm_Mobile.Controls"
             x:Class="Cynapharm_Mobile.Views.Rapports.RapportPage"
             x:DataType="vm:RapportViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- ── Primary header ────────────────────────────────────────────── -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource Primary}"
              Padding="16,48,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0"
                   Text="‹"
                   FontSize="28" FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center"
                   Padding="0,0,8,0" />


            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                <Label Text="Rapport de visite"
                       FontSize="18" FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- ── Body ──────────────────────────────────────────────────────── -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="16">

                <controls:ErrorBanner Message="{Binding ErrorMessage}" />

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Primary}"
                                   HorizontalOptions="Center" />

                <!-- ── GPS indicator ──────────────────────────────────── -->
                <Border BackgroundColor="{StaticResource PrimaryLight}"
                        Stroke="Transparent"
                        Padding="14,12"
                        IsVisible="{Binding GeoStatus, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <ActivityIndicator Grid.Column="0"
                                           IsRunning="{Binding IsCapturingLocation}"
                                           IsVisible="{Binding IsCapturingLocation}"
                                           Color="{StaticResource Primary}"
                                           HeightRequest="18" WidthRequest="18" />
                        <Label Grid.Column="0"
                               Text="📍"
                               FontSize="16"
                               VerticalOptions="Center"
                               IsVisible="{Binding IsCapturingLocation, Converter={StaticResource InvertedBoolConverter}}" />
                        <Label Grid.Column="1"
                               Text="{Binding GeoStatus}"
                               FontSize="13"
                               TextColor="{StaticResource PrimaryText}"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- ── Report content card ────────────────────────────── -->
                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="16">

                        <Label Text="Compte-rendu de visite"
                               Style="{StaticResource SectionTitleStyle}" />
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" />

                        <!-- Content field -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Contenu du rapport *"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border Stroke="{StaticResource BorderColor}"
                                    BackgroundColor="{StaticResource SurfaceBackground}"
                                    StrokeThickness="1"
                                    Padding="12,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Editor Placeholder="Décrivez le déroulement de la visite…"
                                        Text="{Binding Contenu}"
                                        MinimumHeightRequest="100"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource TextPrimary}"
                                        PlaceholderColor="{StaticResource TextMuted}" />
                            </Border>
                            <Label Text="{Binding ContenuError}"
                                   TextColor="{StaticResource Danger}"
                                   FontSize="12"
                                   IsVisible="{Binding ContenuError, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                            <Label Text="Minimum 20 caractères"
                                   FontSize="11"
                                   TextColor="{StaticResource TextMuted}" />
                        </VerticalStackLayout>

                        <!-- Result selector -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Résultat *"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border Stroke="{StaticResource BorderColor}"
                                    BackgroundColor="{StaticResource SurfaceBackground}"
                                    StrokeThickness="1"
                                    Padding="12,0" HeightRequest="48">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Picker ItemsSource="{Binding ResultatOptions}"
                                        SelectedItem="{Binding Resultat}"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource TextPrimary}"
                                        VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Char count -->
                        <Label Text="{Binding Contenu.Length, StringFormat='{0} caractère(s)'}"
                               TextColor="{StaticResource TextMuted}"
                               FontSize="11"
                               HorizontalOptions="End" />

                    </VerticalStackLayout>
                </Border>

                <!-- ── Products discussed card ───────────────────────── -->
                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="12">

                        <Label Text="Produits discutés"
                               Style="{StaticResource SectionTitleStyle}" />
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" />

                        <Label Text="Sélectionnez les produits abordés lors de cette visite"
                               FontSize="13"
                               TextColor="{StaticResource TextSecondary}" />

                        <CollectionView ItemsSource="{Binding ProduitsDiscutes}"
                                        SelectionMode="None">
                            <CollectionView.EmptyView>
                                <Label Text="Chargement des produits…"
                                       Style="{StaticResource EmptyStateStyle}"
                                       Margin="0,4" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="products:ProductCheckItem">
                                    <Border Margin="0,3" Padding="10,8"
                                            BackgroundColor="{StaticResource SurfaceBackground}"
                                            Stroke="{StaticResource BorderColor}"
                                            StrokeThickness="1">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryLight}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsSelected}"
                                                      Color="{StaticResource Primary}" />
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                <Label Text="{Binding ProductNom}"
                                                       FontSize="14" FontAttributes="Bold"
                                                       TextColor="{StaticResource TextPrimary}" />
                                                <Label Text="{Binding ProductReference}"
                                                       FontSize="11"
                                                       TextColor="{StaticResource TextSecondary}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>
                </Border>

                <!-- ── Submit button ──────────────────────────────────── -->
                <Button Text="Soumettre le rapport"
                        Command="{Binding SubmitCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="{Binding CanSubmit}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding CanSubmit}"
                                     Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Label Text="Le rapport doit contenir au moins 20 caractères avant d'être soumis."
                       FontSize="12"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       IsVisible="{Binding CanSubmit, Converter={StaticResource InvertedBoolConverter}}"
                       Margin="0,0,0,24" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
