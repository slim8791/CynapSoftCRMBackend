<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Cynapharm_Mobile.ViewModels.Visites"
             xmlns:controls="clr-namespace:Cynapharm_Mobile.Controls"
             x:Class="Cynapharm_Mobile.Views.Visites.VisitDetailPage"
             x:DataType="vm:VisitDetailViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Primary}"
              Padding="16,48,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    BackgroundColor="#26FFFFFF" StrokeShape="RoundRectangle 12"
                    Stroke="Transparent" HeightRequest="38" WidthRequest="38"
                    VerticalOptions="Center">
                <Label Text="‹" FontSize="24" FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label Grid.Column="1"
                   Text="Visite"
                   FontSize="17" FontAttributes="Bold"
                   FontFamily="OpenSansSemibold"
                   TextColor="White"
                   HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>

        <!-- ── Body ──────────────────────────────────────────────────────── -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,16,16,8" Spacing="14">

                <controls:ErrorBanner Message="{Binding ErrorMessage}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Primary}"
                                   HorizontalOptions="Center" />

                <!-- ── Visit info form ────────────────────────────────────── -->
                <Border Style="{StaticResource CardStyle}" Padding="16,14">
                    <VerticalStackLayout Spacing="16">

                        <Grid ColumnDefinitions="4,*" ColumnSpacing="10">
                            <BoxView Grid.Column="0" BackgroundColor="{StaticResource Primary}"
                                     CornerRadius="2" WidthRequest="4" />
                            <Label Grid.Column="1" Text="Informations de la visite"
                                   FontSize="13" FontAttributes="Bold"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" />

                        <!-- Client -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Client *" FontSize="12" FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border BackgroundColor="{StaticResource SurfaceBackground}"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="{StaticResource FieldBorderInactive}"
                                    StrokeThickness="1.5"
                                    Padding="14,0" HeightRequest="52">
                                <Grid ColumnDefinitions="22,*" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="🏪" FontSize="17"
                                           VerticalOptions="Center" />
                                    <Entry Grid.Column="1"
                                           Placeholder="Nom du client ou pharmacie"
                                           Text="{Binding ClientName}"
                                           BackgroundColor="Transparent"
                                           TextColor="{StaticResource TextPrimary}"
                                           PlaceholderColor="{StaticResource TextMuted}"
                                           HeightRequest="52"
                                           Margin="0" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Date -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Date de la visite *" FontSize="12" FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border BackgroundColor="{StaticResource SurfaceBackground}"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="{StaticResource FieldBorderInactive}"
                                    StrokeThickness="1.5"
                                    Padding="14,0" HeightRequest="52">
                                <Grid ColumnDefinitions="22,*" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="📅" FontSize="17"
                                           VerticalOptions="Center" />
                                    <DatePicker Grid.Column="1"
                                                Date="{Binding VisiteDate}"
                                                Format="dd/MM/yyyy"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource TextPrimary}"
                                                VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Statut -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Statut" FontSize="12" FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border BackgroundColor="{StaticResource SurfaceBackground}"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="{StaticResource FieldBorderInactive}"
                                    StrokeThickness="1.5"
                                    Padding="14,0" HeightRequest="52">
                                <Grid ColumnDefinitions="22,*" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="🔖" FontSize="17"
                                           VerticalOptions="Center" />
                                    <Picker Grid.Column="1"
                                            ItemsSource="{Binding StatutOptions}"
                                            SelectedItem="{Binding Statut}"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource TextPrimary}"
                                            VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Notes -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Notes" FontSize="12" FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border BackgroundColor="{StaticResource SurfaceBackground}"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="{StaticResource FieldBorderInactive}"
                                    StrokeThickness="1.5"
                                    Padding="14,12">
                                <Editor Placeholder="Notes sur le déroulement de la visite…"
                                        Text="{Binding Notes}"
                                        MinimumHeightRequest="100"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource TextPrimary}"
                                        PlaceholderColor="{StaticResource TextMuted}" />
                            </Border>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- Rapport button -->
                <Border BackgroundColor="{StaticResource PrimaryLight}"
                        StrokeShape="RoundRectangle 14"
                        Stroke="{StaticResource Primary}" StrokeThickness="1"
                        Padding="14,14"
                        IsVisible="{Binding IsExisting}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                BackgroundColor="{StaticResource Primary}"
                                StrokeShape="RoundRectangle 10" Stroke="Transparent"
                                WidthRequest="38" HeightRequest="38">
                            <Label Text="📝" FontSize="18"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Soumettre un rapport"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                            <Label Text="Documenter cette visite"
                                   FontSize="11" TextColor="{StaticResource PrimaryText}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="22"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToRapportCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToRapportCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- Delete (danger) -->
                <Button Text="Supprimer la visite"
                        Command="{Binding DeleteCommand}"
                        Style="{StaticResource DangerButtonStyle}"
                        Margin="0,4,0,0"
                        IsVisible="{Binding IsExisting}" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- ── Sticky save ────────────────────────────────────────────────── -->
        <Grid Grid.Row="2" BackgroundColor="{StaticResource CardBackground}">
            <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}"
                     VerticalOptions="Start" />
            <Button Text="Enregistrer la visite"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="16,12,16,28"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
        </Grid>

    </Grid>
</ContentPage>
