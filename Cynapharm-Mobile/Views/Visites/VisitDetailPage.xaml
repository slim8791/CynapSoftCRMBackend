<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Cynapharm_Mobile.ViewModels.Visites"
             xmlns:controls="clr-namespace:Cynapharm_Mobile.Controls"
             x:Class="Cynapharm_Mobile.Views.Visites.VisitDetailPage"
             x:DataType="vm:VisitDetailViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- ── Primary header ────────────────────────────────────────────── -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource Primary}"
              Padding="16,48,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0"
                   Text="‹"
                   FontSize="28" FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center"
                   Padding="0,0,8,0" />


            <Label Grid.Column="1"
                   Text="Visite"
                   FontSize="18" FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center"
                   HorizontalOptions="Center" />
        </Grid>

        <!-- ── Body ──────────────────────────────────────────────────────── -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="16">

                <controls:ErrorBanner Message="{Binding ErrorMessage}" />

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Primary}"
                                   HorizontalOptions="Center" />

                <!-- ── Visit info card ─────────────────────────────────── -->
                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="16">

                        <Label Text="Informations de la visite"
                               Style="{StaticResource SectionTitleStyle}" />
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" />

                        <!-- Client -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Client *"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border Stroke="{StaticResource BorderColor}"
                                    BackgroundColor="{StaticResource SurfaceBackground}"
                                    StrokeThickness="1"
                                    Padding="12,0" HeightRequest="48">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Entry Placeholder="Nom du client ou pharmacie"
                                       Text="{Binding ClientName}"
                                       BackgroundColor="Transparent"
                                       TextColor="{StaticResource TextPrimary}"
                                       PlaceholderColor="{StaticResource TextMuted}"
                                       Margin="0"
                                       VerticalOptions="Center"
                                       SemanticProperties.Description="Champ nom du client" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Date -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Date de la visite *"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border Stroke="{StaticResource BorderColor}"
                                    BackgroundColor="{StaticResource SurfaceBackground}"
                                    StrokeThickness="1"
                                    Padding="12,0" HeightRequest="48">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <DatePicker Date="{Binding VisiteDate}"
                                            Format="dd/MM/yyyy"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource TextPrimary}"
                                            VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Statut -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Statut"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border Stroke="{StaticResource BorderColor}"
                                    BackgroundColor="{StaticResource SurfaceBackground}"
                                    StrokeThickness="1"
                                    Padding="12,0" HeightRequest="48">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Picker ItemsSource="{Binding StatutOptions}"
                                        SelectedItem="{Binding Statut}"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource TextPrimary}"
                                        VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Notes -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Notes"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border Stroke="{StaticResource BorderColor}"
                                    BackgroundColor="{StaticResource SurfaceBackground}"
                                    StrokeThickness="1"
                                    Padding="12,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Editor Placeholder="Notes sur le déroulement de la visite…"
                                        Text="{Binding Notes}"
                                        MinimumHeightRequest="100"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource TextPrimary}"
                                        PlaceholderColor="{StaticResource TextMuted}" />
                            </Border>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- ── Actions card ───────────────────────────────────── -->
                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="10">

                        <Button Text="Enregistrer la visite"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

                        <Button Text="Soumettre un rapport"
                                Command="{Binding GoToRapportCommand}"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                CornerRadius="10"
                                HeightRequest="44"
                                Margin="0"
                                IsVisible="{Binding IsExisting}" />

                        <BoxView HeightRequest="1"
                                 BackgroundColor="{StaticResource BorderColor}"
                                 IsVisible="{Binding IsExisting}"
                                 Margin="0,4" />

                        <Button Text="Supprimer la visite"
                                Command="{Binding DeleteCommand}"
                                BackgroundColor="{StaticResource DangerLight}"
                                TextColor="{StaticResource DangerText}"
                                CornerRadius="10"
                                HeightRequest="44"
                                Margin="0"
                                IsVisible="{Binding IsExisting}" />

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
