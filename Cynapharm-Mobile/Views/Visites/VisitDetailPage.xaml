<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Cynapharm_Mobile.ViewModels.Visites"
             xmlns:controls="clr-namespace:Cynapharm_Mobile.Controls"
             x:Class="Cynapharm_Mobile.Views.Visites.VisitDetailPage"
             x:DataType="vm:VisitDetailViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <controls:AppHeader Grid.Row="0"
                            Title="Visite"
                            ShowBackButton="True" />

        <!-- ── Body ──────────────────────────────────────────────────────── -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,16,16,8" Spacing="14">

                <controls:ErrorBanner Message="{Binding ErrorMessage}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Primary}"
                                   HorizontalOptions="Center" />

                <!-- FIX-6: Read-only banner when visite is completed -->
                <Border IsVisible="{Binding IsCompleted}"
                        BackgroundColor="#E8F5E9"
                        StrokeShape="RoundRectangle 12"
                        Stroke="#81C784" StrokeThickness="1"
                        Padding="16,10">
                    <Label Text="✓ Visite terminée "
                           TextColor="#2E7D32"
                           FontSize="13" FontAttributes="Bold"
                           HorizontalOptions="Center" />
                </Border>

                <!-- Rejection banner — visible when superviseur rejects the rapport -->
                <Border IsVisible="{Binding ShowRejectionBanner}"
                        BackgroundColor="{StaticResource DangerLight}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource Danger}" StrokeThickness="1"
                        Padding="16,12">
                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="⚠️" FontSize="16" VerticalOptions="Center" />
                            <Label Text="Rapport rejeté par le superviseur"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="{StaticResource DangerText}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Text="{Binding MotifRejet}"
                               FontSize="12"
                               TextColor="{StaticResource DangerText}"
                               LineBreakMode="WordWrap" />
                        <Label Text="Veuillez corriger et re-soumettre le rapport."
                               FontSize="11"
                               TextColor="{StaticResource TextMuted}"
                               FontAttributes="Italic" />
                    </VerticalStackLayout>
                </Border>

                <!-- Planning association indicator -->
                <Border BackgroundColor="#E8F4FD"
                        StrokeShape="RoundRectangle 8"
                        Stroke="Transparent"
                        Padding="10"
                        IsVisible="{Binding HasPlanningLabel}">
                    <Label Text="{Binding PlanningLabel}"
                           TextColor="#1565C0"
                           FontSize="13" />
                </Border>

                <!-- ── Visit info form ────────────────────────────────────── -->
                <Border Style="{StaticResource CardStyle}" Padding="16,14">
                    <VerticalStackLayout Spacing="16">

                        <Grid ColumnDefinitions="4,*" ColumnSpacing="10">
                            <BoxView Grid.Column="0" BackgroundColor="{StaticResource Primary}"
                                     CornerRadius="2" WidthRequest="4" />
                            <Label Grid.Column="1" Text="Informations de la visite"
                                   FontSize="13" FontAttributes="Bold"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" />

                        <!-- Date -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Date de la visite *" FontSize="12" FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border BackgroundColor="{StaticResource SurfaceBackground}"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="{StaticResource FieldBorderInactive}"
                                    StrokeThickness="1.5"
                                    Padding="14,0" HeightRequest="52">
                                <Grid ColumnDefinitions="22,*" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="📅" FontSize="17"
                                           VerticalOptions="Center" />
                                    <DatePicker Grid.Column="1"
                                                Date="{Binding VisiteDate}"
                                                Format="dd/MM/yyyy"
                                                IsEnabled="{Binding CanEdit}"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource TextPrimary}"
                                                VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Type de visite -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Type de visite *" FontSize="12" FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border BackgroundColor="{StaticResource SurfaceBackground}"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="{StaticResource FieldBorderInactive}"
                                    StrokeThickness="1.5"
                                    Padding="14,0" HeightRequest="52">
                                <Grid ColumnDefinitions="22,*" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="🔖" FontSize="17"
                                           VerticalOptions="Center" />
                                    <Picker Grid.Column="1"
                                            ItemsSource="{Binding VisiteTypeOptions}"
                                            SelectedItem="{Binding SelectedTypeLabel}"
                                            IsEnabled="{Binding CanEdit}"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource TextPrimary}"
                                            VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Notes (optionnel) -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Notes (optionnel)" FontSize="12" FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border BackgroundColor="{StaticResource SurfaceBackground}"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="{StaticResource FieldBorderInactive}"
                                    StrokeThickness="1.5"
                                    Padding="14,10">
                                <Editor Text="{Binding Notes}"
                                        Placeholder="Ajouter des notes..."
                                        PlaceholderColor="{StaticResource TextMuted}"
                                        AutoSize="TextChanges"
                                        MaxLength="500"
                                        MinimumHeightRequest="72"
                                        IsEnabled="{Binding CanEdit}"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource TextPrimary}" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Médecin — visible uniquement si type = Médecin -->
                        <VerticalStackLayout Spacing="6"
                                             IsVisible="{Binding IsMedecinType}">
                            <Label FontSize="12" FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Médecin"/>
                                        <Span Text=" *" TextColor="{StaticResource Danger}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Border BackgroundColor="{StaticResource SurfaceBackground}"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="{StaticResource FieldBorderInactive}"
                                    StrokeThickness="1.5"
                                    Padding="14,0" HeightRequest="52">
                                <Grid ColumnDefinitions="22,*" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="🩺" FontSize="17"
                                           VerticalOptions="Center" />
                                    <Picker Grid.Column="1"
                                            ItemsSource="{Binding Medecins}"
                                            ItemDisplayBinding="{Binding Nom}"
                                            SelectedItem="{Binding SelectedMedecin}"
                                            Title="Sélectionner un médecin"
                                            IsEnabled="{Binding CanEdit}"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource TextPrimary}"
                                            TitleColor="{StaticResource TextMuted}"
                                            VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Pharmacien — visible uniquement si type = Pharmacien -->
                        <VerticalStackLayout Spacing="6"
                                             IsVisible="{Binding IsPharmacienType}">
                            <Label FontSize="12" FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Pharmacien"/>
                                        <Span Text=" *" TextColor="{StaticResource Danger}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Border BackgroundColor="{StaticResource SurfaceBackground}"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="{StaticResource FieldBorderInactive}"
                                    StrokeThickness="1.5"
                                    Padding="14,0" HeightRequest="52">
                                <Grid ColumnDefinitions="22,*" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="💊" FontSize="17"
                                           VerticalOptions="Center" />
                                    <Picker Grid.Column="1"
                                            ItemsSource="{Binding Pharmaciens}"
                                            ItemDisplayBinding="{Binding Nom}"
                                            SelectedItem="{Binding SelectedPharmacien}"
                                            Title="Sélectionner un pharmacien"
                                            IsEnabled="{Binding CanEdit}"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource TextPrimary}"
                                            TitleColor="{StaticResource TextMuted}"
                                            VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- ── Démarrer la visite ────────────────────────────────── -->
                <Button Text="▶  Démarrer la visite"
                        Command="{Binding StartVisiteCommand}"
                        IsVisible="{Binding CanStartVisite}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="50"
                        FontSize="15"
                        FontAttributes="Bold"
                        Margin="0,4,0,0" />

                <!-- ── Heure de début indicator (visible after start) ──── -->
                <Border IsVisible="{Binding IsStarted}"
                        BackgroundColor="#F0FDF4"
                        StrokeShape="RoundRectangle 10"
                        Stroke="#86EFAC" StrokeThickness="1"
                        Padding="14,10">
                    <HorizontalStackLayout Spacing="8"
                                           HorizontalOptions="Center">
                        <Label Text="✓ Visite démarrée à"
                               FontSize="13"
                               TextColor="#15803D" />
                        <Label Text="{Binding HeurDebutLabel}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#15803D" />
                    </HorizontalStackLayout>
                </Border>

                <!-- ── Rapport action — three mutually exclusive states ──────── -->

                <!-- STATE 1: no rapport yet AND visite started → CREATE -->
                <Border BackgroundColor="{StaticResource PrimaryLight}"
                        StrokeShape="RoundRectangle 14"
                        Stroke="{StaticResource Primary}" StrokeThickness="1"
                        Padding="14,14"
                        IsVisible="{Binding ShowSubmitRapport}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                BackgroundColor="{StaticResource Primary}"
                                StrokeShape="RoundRectangle 10" Stroke="Transparent"
                                WidthRequest="38" HeightRequest="38">
                            <Label Text="📝" FontSize="18"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Soumettre un rapport"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                            <Label Text="Documenter cette visite"
                                   FontSize="11" TextColor="{StaticResource PrimaryText}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="22"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToRapportCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToRapportCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- STATE 2: rapport exists, not yet validated → EDIT (amber) -->
                <Border BackgroundColor="#FFF8E1"
                        StrokeShape="RoundRectangle 14"
                        Stroke="#FF8F00" StrokeThickness="1"
                        Padding="14,14"
                        IsVisible="{Binding ShowEditRapport}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                BackgroundColor="#FF8F00"
                                StrokeShape="RoundRectangle 10" Stroke="Transparent"
                                WidthRequest="38" HeightRequest="38">
                            <Label Text="✏️" FontSize="18"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Modifier le rapport"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="#E65100" />
                            <Label Text="Le superviseur n'a pas encore validé"
                                   FontSize="11" TextColor="#FF8F00" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="22"
                               TextColor="#FF8F00"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToRapportCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToRapportCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- STATE 3: rapport locked by superviseur validation → VIEW (gray) -->
                <Border BackgroundColor="#F5F5F5"
                        StrokeShape="RoundRectangle 14"
                        Stroke="#9E9E9E" StrokeThickness="1"
                        Padding="14,14"
                        IsVisible="{Binding ShowViewRapport}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                BackgroundColor="#757575"
                                StrokeShape="RoundRectangle 10" Stroke="Transparent"
                                WidthRequest="38" HeightRequest="38">
                            <Label Text="👁" FontSize="18"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Voir le rapport"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="#424242" />
                            <Label Text="Rapport validé — lecture seule"
                                   FontSize="11" TextColor="#757575" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="22"
                               TextColor="#9E9E9E"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToRapportCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToRapportCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- Delete (danger) — hidden for completed or new visites -->
                <Button Text="Supprimer la visite"
                        Command="{Binding DeleteCommand}"
                        Style="{StaticResource DangerButtonStyle}"
                        Margin="0,4,0,0"
                        IsVisible="{Binding CanDelete}" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- ── Sticky save — hidden when visite is completed (read-only) ─── -->
        <Grid Grid.Row="2" BackgroundColor="{StaticResource CardBackground}"
              IsVisible="{Binding CanEdit}">
            <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}"
                     VerticalOptions="Start" />
            <Button Text="Enregistrer la visite"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="16,12,16,28"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
        </Grid>

        <controls:AppLoader Grid.RowSpan="3" />
    </Grid>
</ContentPage>
