<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Cynapharm_Mobile.ViewModels.Visites"
             xmlns:models="clr-namespace:Cynapharm_Mobile.Models.Field"
             xmlns:controls="clr-namespace:Cynapharm_Mobile.Controls"
             x:Class="Cynapharm_Mobile.Views.Visites.VisitListPage"
             x:DataType="vm:VisitListViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <controls:AppHeader Grid.Row="0" Title="Mes visites" Subtitle="Historique et planification" ShowHamburger="True" />

        <VerticalStackLayout Grid.Row="1" BackgroundColor="{StaticResource Primary}" Padding="0,0,0,16">
            <!-- Floating search bar -->
            <Border BackgroundColor="White"
                    StrokeShape="RoundRectangle 14"
                    Stroke="Transparent"
                    Padding="14,0"
                    Margin="16,0,16,4">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="12" Opacity="0.12" />
                </Border.Shadow>
                <Grid ColumnDefinitions="20,*" ColumnSpacing="10" HeightRequest="48">
                    <Label Grid.Column="0" Text="🔍" FontSize="15"
                           TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                    <Entry Grid.Column="1"
                           Placeholder="Rechercher une visite…"
                           Text="{Binding SearchQuery}"
                           ReturnCommand="{Binding SearchCommand}"
                           ReturnType="Search"
                           PlaceholderColor="{StaticResource TextMuted}"
                           TextColor="{StaticResource TextPrimary}"
                           BackgroundColor="Transparent"
                           FontSize="14" HeightRequest="48"
                           Margin="0" VerticalOptions="Center" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <!-- Error banner -->
        <controls:ErrorBanner Grid.Row="2"
                              Message="{Binding ErrorMessage}"
                              Margin="16,8,16,0" />

        <!-- ── Date range filter ─────────────────────────────────────────── -->
        <Grid Grid.Row="3"
              ColumnDefinitions="*,*" ColumnSpacing="12"
              BackgroundColor="{StaticResource PageBackground}"
              Padding="16,10,16,4">
            <Border Grid.Column="0"
                    Stroke="{StaticResource FieldBorderInactive}"
                    BackgroundColor="{StaticResource SurfaceBackground}"
                    StrokeThickness="1.5"
                    Padding="12,0" HeightRequest="46">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <DatePicker Date="{Binding FilterStartDate}"
                            Format="dd/MM/yyyy"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource TextPrimary}"
                            VerticalOptions="Center" />
            </Border>
            <Border Grid.Column="1"
                    Stroke="{StaticResource FieldBorderInactive}"
                    BackgroundColor="{StaticResource SurfaceBackground}"
                    StrokeThickness="1.5"
                    Padding="12,0" HeightRequest="46">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <DatePicker Date="{Binding FilterEndDate}"
                            Format="dd/MM/yyyy"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource TextPrimary}"
                            VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- ── Status filter chips ───────────────────────────────────────── -->
        <ScrollView Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    BackgroundColor="{StaticResource PageBackground}">
            <HorizontalStackLayout Padding="16,6,16,10" Spacing="8"
                                   BindableLayout.ItemsSource="{Binding StatusOptions}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border Padding="16,8"
                                StrokeThickness="1.5"
                                Stroke="{StaticResource BorderColor}"
                                BackgroundColor="{StaticResource CardBackground}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,1" Radius="4" Opacity="0.05" />
                            </Border.Shadow>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.FilterStatus}"
                                             Value="{Binding .}">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="Stroke"          Value="{StaticResource Primary}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="{Binding .}" FontSize="13"
                                   TextColor="{StaticResource TextSecondary}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.FilterStatus}"
                                                 Value="{Binding .}">
                                        <Setter Property="TextColor"      Value="White" />
                                        <Setter Property="FontAttributes" Value="Bold" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SetStatusFilterCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- ── Visit list ────────────────────────────────────────────────── -->
        <RefreshView Grid.Row="5"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing}"
                     RefreshColor="{StaticResource Primary}">
            <CollectionView ItemsSource="{Binding Visites}"
                            ItemSizingStrategy="MeasureFirstItem">
                <CollectionView.Header>
                    <BoxView HeightRequest="6" Color="Transparent" />
                </CollectionView.Header>
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                         Spacing="16" Padding="40" Margin="0,40,0,0">
                        <Border BackgroundColor="{StaticResource PrimaryLight}"
                                StrokeShape="RoundRectangle 50" Stroke="Transparent"
                                WidthRequest="80" HeightRequest="80" HorizontalOptions="Center">
                            <Label Text="📋" FontSize="38"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Aucune visite trouvée"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               HorizontalOptions="Center" />
                        <Label Text="Modifiez les filtres ou créez une nouvelle visite."
                               Style="{StaticResource EmptyStateStyle}" FontSize="13" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Visite">
                        <Border Margin="16,0,16,10"
                                BackgroundColor="{StaticResource CardBackground}"
                                StrokeShape="RoundRectangle 16"
                                Stroke="{StaticResource BorderColor}" StrokeThickness="1"
                                Padding="0">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.06" />
                            </Border.Shadow>
                            <Grid ColumnDefinitions="5,*">
                                <!-- Status color bar: orange = pending, green = completed -->
                                <BoxView Grid.Column="0" VerticalOptions="Fill"
                                         BackgroundColor="#FF9800">
                                    <BoxView.Triggers>
                                        <DataTrigger TargetType="BoxView"
                                                     Binding="{Binding IsCompleted}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#4CAF50" />
                                        </DataTrigger>
                                    </BoxView.Triggers>
                                </BoxView>
                                <Grid Grid.Column="1"
                                      ColumnDefinitions="*,Auto,28"
                                      Padding="14,14" ColumnSpacing="10">
                                    <!-- Left: date, type badge, contact name -->
                                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                                        <!-- Line 1: Date (date only, no time) -->
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                            <Label Grid.Column="0" Text="📅" FontSize="12"
                                                   VerticalOptions="Center" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding DateVisite, StringFormat='{0:dd/MM/yyyy}'}"
                                                   FontSize="13" FontAttributes="Bold"
                                                   TextColor="{StaticResource TextPrimary}"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                        <!-- Line 2: Type badge (Médecin / Pharmacien / Autre) -->
                                        <Border Padding="8,3" Stroke="Transparent"
                                                BackgroundColor="{StaticResource PrimaryLight}"
                                                HorizontalOptions="Start">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding TypeLabel}"
                                                   FontSize="11" FontAttributes="Bold"
                                                   TextColor="{StaticResource Primary}" />
                                        </Border>
                                        <!-- Line 3: Contact name (doctor or pharmacist) -->
                                        <Label Text="{Binding ContactName}"
                                               FontSize="12"
                                               TextColor="{StaticResource TextSecondary}"
                                               IsVisible="{Binding HasContact}"
                                               LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                    <!-- Right: status badge -->
                                    <Border Grid.Column="1"
                                            Padding="10,4"
                                            Stroke="Transparent"
                                            BackgroundColor="#FFF3E0"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border"
                                                         Binding="{Binding IsCompleted}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#E8F5E9" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="Non complétée"
                                               FontSize="11" FontAttributes="Bold"
                                               TextColor="#E65100">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding IsCompleted}" Value="True">
                                                    <Setter Property="Text"      Value="Complétée" />
                                                    <Setter Property="TextColor" Value="#2E7D32" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                    <!-- Chevron -->
                                    <Label Grid.Column="2" Text="›" FontSize="22"
                                           TextColor="{StaticResource Gray300}"
                                           VerticalOptions="Center" HorizontalOptions="End" />
                                </Grid>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.GoToDetailCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <BoxView HeightRequest="8" Color="Transparent" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <!-- ── Sticky CTA ─────────────────────────────────────────────────── -->
        <Grid Grid.Row="6" BackgroundColor="{StaticResource CardBackground}">
            <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}"
                     VerticalOptions="Start" />
            <Button Text="+ Nouvelle visite"
                    Command="{Binding CreateVisitCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="16,12,16,28" />
        </Grid>

        <controls:AppLoader Grid.RowSpan="7" IsBusy="{Binding IsBusy}" />

    </Grid>
</ContentPage>
