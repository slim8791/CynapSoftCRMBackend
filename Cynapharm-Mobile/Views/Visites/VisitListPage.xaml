<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Cynapharm_Mobile.ViewModels.Visites"
             xmlns:models="clr-namespace:Cynapharm_Mobile.Models.Field"
             xmlns:controls="clr-namespace:Cynapharm_Mobile.Controls"
             x:Class="Cynapharm_Mobile.Views.Visites.VisitListPage"
             x:DataType="vm:VisitListViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

        <!-- ── Primary header ────────────────────────────────────────────── -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource Primary}"
              Padding="16,48,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0"
                   Text="Mes visites"
                   FontSize="18" FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center" />

            <!-- Search bar in header -->
            <Border Grid.Row="1"
                    BackgroundColor="#26FFFFFF"
                    StrokeShape="RoundRectangle 10"
                    Stroke="Transparent"
                    Padding="12,0"
                    HeightRequest="44"
                    Margin="0,10,0,0">
                <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="🔍" FontSize="14"
                           TextColor="#99FFFFFF" VerticalOptions="Center" />
                    <Entry Grid.Column="1"
                           Placeholder="Rechercher une visite…"
                           PlaceholderColor="#99FFFFFF"
                           TextColor="White"
                           BackgroundColor="Transparent"
                           FontSize="14"
                           Margin="0"
                           VerticalOptions="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- Error banner -->
        <controls:ErrorBanner Grid.Row="1"
                              Message="{Binding ErrorMessage}"
                              Margin="16,8,16,0" />

        <!-- ── Date range filter ─────────────────────────────────────────── -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,*" ColumnSpacing="12"
              BackgroundColor="{StaticResource CardBackground}"
              Padding="16,10">
            <Border Grid.Column="0"
                    Stroke="{StaticResource BorderColor}"
                    BackgroundColor="{StaticResource SurfaceBackground}"
                    StrokeThickness="1"
                    Padding="12,0" HeightRequest="44">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <DatePicker Date="{Binding FilterStartDate}"
                            Format="dd/MM/yyyy"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource TextPrimary}"
                            VerticalOptions="Center" />
            </Border>
            <Border Grid.Column="1"
                    Stroke="{StaticResource BorderColor}"
                    BackgroundColor="{StaticResource SurfaceBackground}"
                    StrokeThickness="1"
                    Padding="12,0" HeightRequest="44">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <DatePicker Date="{Binding FilterEndDate}"
                            Format="dd/MM/yyyy"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource TextPrimary}"
                            VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- ── Status filter chips ───────────────────────────────────────── -->
        <ScrollView Grid.Row="3"
                    Orientation="Horizontal"
                    BackgroundColor="{StaticResource CardBackground}">
            <HorizontalStackLayout Padding="16,10" Spacing="8"
                                   BindableLayout.ItemsSource="{Binding StatusOptions}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border Padding="14,6"
                                StrokeThickness="1"
                                Stroke="{StaticResource BorderColor}"
                                BackgroundColor="{StaticResource SurfaceBackground}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.FilterStatus}"
                                             Value="{Binding .}">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="Stroke"          Value="{StaticResource Primary}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="{Binding .}" FontSize="13"
                                   TextColor="{StaticResource TextSecondary}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.FilterStatus}"
                                                 Value="{Binding .}">
                                        <Setter Property="TextColor"     Value="White" />
                                        <Setter Property="FontAttributes" Value="Bold" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SetStatusFilterCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- ── Visit list ────────────────────────────────────────────────── -->
        <RefreshView Grid.Row="4"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing}">
            <CollectionView ItemsSource="{Binding Visites}"
                            ItemSizingStrategy="MeasureFirstItem">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                         Spacing="12" Padding="32">
                        <Label Text="📋" FontSize="48" HorizontalOptions="Center" />
                        <Label Text="Aucune visite trouvée"
                               Style="{StaticResource EmptyStateStyle}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Visite">
                        <Border Margin="16,6" Style="{StaticResource CardStyle}">
                            <VerticalStackLayout Spacing="8">
                                <!-- Row 1: client name + status badge -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           Text="{Binding ClientNom}"
                                           FontAttributes="Bold" FontSize="14"
                                           TextColor="{StaticResource TextPrimary}" />
                                    <Border Grid.Column="1"
                                            Padding="8,3"
                                            BackgroundColor="{StaticResource SecondaryLight}"
                                            Stroke="Transparent"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Statut}"
                                               FontSize="11" FontAttributes="Bold"
                                               TextColor="{Binding Statut, Converter={StaticResource StatusColorConverter}}" />
                                    </Border>
                                </Grid>

                                <!-- Row 2: date + time -->
                                <Label Text="{Binding DateVisite, StringFormat='{0:dd/MM/yyyy  HH:mm}'}"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}" />

                                <!-- Separator -->
                                <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" />

                                <!-- Action buttons row -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Button Grid.Column="0"
                                            Text="Créer rapport"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.GoToDetailCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            FontSize="13"
                                            HeightRequest="40"
                                            Margin="0" />
                                    <Button Grid.Column="1"
                                            Text="Détail"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.GoToDetailCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="{StaticResource SurfaceBackground}"
                                            TextColor="{StaticResource TextPrimary}"
                                            FontSize="13"
                                            HeightRequest="40"
                                            CornerRadius="10"
                                            WidthRequest="80"
                                            Margin="0" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- ── FAB ───────────────────────────────────────────────────────── -->
        <Button Grid.Row="5"
                Text="+ Nouvelle visite"
                Command="{Binding CreateVisitCommand}"
                Style="{StaticResource PrimaryButtonStyle}"
                Margin="16,8" />

    </Grid>
</ContentPage>
