<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Cynapharm_Mobile.ViewModels.Visites"
             xmlns:models="clr-namespace:Cynapharm_Mobile.Models.Field"
             xmlns:controls="clr-namespace:Cynapharm_Mobile.Controls"
             x:Class="Cynapharm_Mobile.Views.Visites.VisitListPage"
             x:DataType="vm:VisitListViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Primary}">
            <VerticalStackLayout Padding="20,52,20,16" Spacing="0">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                        <Label Text="Mes visites"
                               FontSize="22" FontAttributes="Bold"
                               FontFamily="OpenSansSemibold"
                               TextColor="White" />
                        <Label Text="Historique et planification"
                               FontSize="12" TextColor="#CCF5FF" />
                    </VerticalStackLayout>
                </Grid>
                <!-- Floating search bar -->
                <Border BackgroundColor="White"
                        StrokeShape="RoundRectangle 14"
                        Stroke="Transparent"
                        Padding="14,0"
                        Margin="0,0,0,4">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Radius="12" Opacity="0.12" />
                    </Border.Shadow>
                    <Grid ColumnDefinitions="20,*" ColumnSpacing="10" HeightRequest="48">
                        <Label Grid.Column="0" Text="🔍" FontSize="15"
                               TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        <Entry Grid.Column="1"
                               Placeholder="Rechercher une visite…"
                               Text="{Binding SearchQuery}"
                               ReturnCommand="{Binding SearchCommand}"
                               ReturnType="Search"
                               PlaceholderColor="{StaticResource TextMuted}"
                               TextColor="{StaticResource TextPrimary}"
                               BackgroundColor="Transparent"
                               FontSize="14" HeightRequest="48"
                               Margin="0" VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </Grid>

        <!-- Error banner -->
        <controls:ErrorBanner Grid.Row="1"
                              Message="{Binding ErrorMessage}"
                              Margin="16,8,16,0" />

        <!-- ── Date range filter ─────────────────────────────────────────── -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,*" ColumnSpacing="12"
              BackgroundColor="{StaticResource PageBackground}"
              Padding="16,10,16,4">
            <Border Grid.Column="0"
                    Stroke="{StaticResource FieldBorderInactive}"
                    BackgroundColor="{StaticResource SurfaceBackground}"
                    StrokeThickness="1.5"
                    Padding="12,0" HeightRequest="46">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <DatePicker Date="{Binding FilterStartDate}"
                            Format="dd/MM/yyyy"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource TextPrimary}"
                            VerticalOptions="Center" />
            </Border>
            <Border Grid.Column="1"
                    Stroke="{StaticResource FieldBorderInactive}"
                    BackgroundColor="{StaticResource SurfaceBackground}"
                    StrokeThickness="1.5"
                    Padding="12,0" HeightRequest="46">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <DatePicker Date="{Binding FilterEndDate}"
                            Format="dd/MM/yyyy"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource TextPrimary}"
                            VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- ── Status filter chips ───────────────────────────────────────── -->
        <ScrollView Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    BackgroundColor="{StaticResource PageBackground}">
            <HorizontalStackLayout Padding="16,6,16,10" Spacing="8"
                                   BindableLayout.ItemsSource="{Binding StatusOptions}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border Padding="16,8"
                                StrokeThickness="1.5"
                                Stroke="{StaticResource BorderColor}"
                                BackgroundColor="{StaticResource CardBackground}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,1" Radius="4" Opacity="0.05" />
                            </Border.Shadow>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.FilterStatus}"
                                             Value="{Binding .}">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="Stroke"          Value="{StaticResource Primary}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="{Binding .}" FontSize="13"
                                   TextColor="{StaticResource TextSecondary}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.FilterStatus}"
                                                 Value="{Binding .}">
                                        <Setter Property="TextColor"      Value="White" />
                                        <Setter Property="FontAttributes" Value="Bold" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SetStatusFilterCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- ── Visit list ────────────────────────────────────────────────── -->
        <RefreshView Grid.Row="4"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing}"
                     RefreshColor="{StaticResource Primary}">
            <CollectionView ItemsSource="{Binding Visites}"
                            ItemSizingStrategy="MeasureFirstItem">
                <CollectionView.Header>
                    <BoxView HeightRequest="6" Color="Transparent" />
                </CollectionView.Header>
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                         Spacing="16" Padding="40" Margin="0,40,0,0">
                        <Border BackgroundColor="{StaticResource PrimaryLight}"
                                StrokeShape="RoundRectangle 50" Stroke="Transparent"
                                WidthRequest="80" HeightRequest="80" HorizontalOptions="Center">
                            <Label Text="📋" FontSize="38"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Aucune visite trouvée"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               HorizontalOptions="Center" />
                        <Label Text="Modifiez les filtres ou créez une nouvelle visite."
                               Style="{StaticResource EmptyStateStyle}" FontSize="13" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Visite">
                        <Border Margin="16,0,16,10"
                                BackgroundColor="{StaticResource CardBackground}"
                                StrokeShape="RoundRectangle 16"
                                Stroke="{StaticResource BorderColor}" StrokeThickness="1"
                                Padding="0">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.06" />
                            </Border.Shadow>
                            <Grid ColumnDefinitions="5,*">
                                <BoxView Grid.Column="0"
                                         BackgroundColor="{Binding Statut, Converter={StaticResource StatusColorConverter}}"
                                         VerticalOptions="Fill" />
                                <Grid Grid.Column="1"
                                      ColumnDefinitions="*,Auto,28"
                                      Padding="14,14" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                                        <Label Text="{Binding ClientNom}"
                                               FontAttributes="Bold" FontSize="15"
                                               FontFamily="OpenSansSemibold"
                                               TextColor="{StaticResource TextPrimary}" />
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                            <Label Grid.Column="0" Text="📅" FontSize="12"
                                                   VerticalOptions="Center" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding DateVisite, StringFormat='{0:dd/MM/yyyy  HH:mm}'}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource TextSecondary}"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1"
                                            Padding="10,4"
                                            Stroke="Transparent"
                                            BackgroundColor="{StaticResource SecondaryLight}"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Statut}"
                                               FontSize="11" FontAttributes="Bold"
                                               TextColor="{Binding Statut, Converter={StaticResource StatusColorConverter}}" />
                                    </Border>
                                    <Label Grid.Column="2" Text="›" FontSize="22"
                                           TextColor="{StaticResource Gray300}"
                                           VerticalOptions="Center" HorizontalOptions="End" />
                                </Grid>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.GoToDetailCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <BoxView HeightRequest="8" Color="Transparent" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <!-- ── Sticky CTA ─────────────────────────────────────────────────── -->
        <Grid Grid.Row="5" BackgroundColor="{StaticResource CardBackground}">
            <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}"
                     VerticalOptions="Start" />
            <Button Text="+ Nouvelle visite"
                    Command="{Binding CreateVisitCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="16,12,16,28" />
        </Grid>

    </Grid>
</ContentPage>
