<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Cynapharm_Mobile.ViewModels.Clients"
             xmlns:field="clr-namespace:Cynapharm_Mobile.Models.Field"
             x:Class="Cynapharm_Mobile.Views.Clients.ClientDetailPage"
             x:DataType="vm:ClientDetailViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="Auto,*">

        <!-- ═══ HEADER ══════════════════════════════════════════════ -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource Primary}"
              Padding="16,48,16,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Back button -->
            <Border Grid.Row="0" Grid.Column="0"
                    BackgroundColor="#26FFFFFF"
                    StrokeShape="RoundRectangle 10"
                    Stroke="Transparent"
                    HeightRequest="36" WidthRequest="36"
                    VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                </Border.GestureRecognizers>
                <Label Text="‹" FontSize="22" TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

            <!-- Title -->
            <Label Grid.Row="0" Grid.Column="1"
                   Text="Détail client"
                   FontSize="18" FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"/>

            <!-- Edit button removed -->
            <BoxView Grid.Row="0" Grid.Column="2"
                     WidthRequest="36" HeightRequest="36"
                     Color="Transparent"/>

            <!-- Client name + initials -->
            <Grid Grid.Row="1" Grid.ColumnSpan="3"
                  ColumnDefinitions="56,12,*"
                  Margin="0,16,0,0">
                <Border Grid.Column="0"
                        BackgroundColor="#33FFFFFF"
                        StrokeShape="RoundRectangle 14"
                        Stroke="Transparent"
                        HeightRequest="50" WidthRequest="50"
                        VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="{Binding ClientInitials}"
                           FontSize="18" FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="4">
                    <Label Text="{Binding ClientName}"
                           FontSize="16" FontAttributes="Bold"
                           TextColor="White"
                           LineBreakMode="TailTruncation"/>
                    <Border BackgroundColor="#26FFFFFF"
                            StrokeShape="RoundRectangle 10"
                            Stroke="Transparent"
                            Padding="8,3"
                            HorizontalOptions="Start">
                        <Label Text="{Binding ClientType}"
                               FontSize="11" FontAttributes="Bold"
                               TextColor="White"/>
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <!-- ═══ CONTENT ═════════════════════════════════════════════ -->
        <ScrollView Grid.Row="1" Padding="14,14,14,20">
            <VerticalStackLayout Spacing="0">

                <!-- Loading -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Primary}"
                                   HeightRequest="40"/>

                <!-- Error -->
                <Border IsVisible="{Binding HasError}"
                        BackgroundColor="{StaticResource DangerLight}"
                        StrokeShape="RoundRectangle 10"
                        Stroke="Transparent"
                        Padding="12" Margin="0,0,0,12">
                    <Label Text="{Binding ErrorMessage}"
                           FontSize="13" TextColor="{StaticResource DangerText}"/>
                </Border>

                <!-- ── Info Card ────────────────────────────────── -->
                <Label Text="Informations" FontSize="14" FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}" Margin="0,4,0,8"/>

                <Border BackgroundColor="{StaticResource CardBackground}"
                        Stroke="{StaticResource BorderColor}"
                        StrokeShape="RoundRectangle 12"
                        Padding="14" Margin="0,0,0,10"
                        StrokeThickness="1">
                    <VerticalStackLayout Spacing="12">
                        <!-- Email -->
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Email" FontSize="12"
                                   TextColor="{StaticResource TextSecondary}"/>
                            <Label Text="{Binding ClientEmail}"
                                   FontSize="14"
                                   TextColor="{StaticResource TextPrimary}"/>
                        </VerticalStackLayout>
                        <BoxView HeightRequest="1"
                                 BackgroundColor="{StaticResource BorderColor}"/>
                        <!-- Téléphone -->
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Téléphone" FontSize="12"
                                   TextColor="{StaticResource TextSecondary}"/>
                            <Label Text="{Binding ClientTelephone}"
                                   FontSize="14"
                                   TextColor="{StaticResource TextPrimary}"/>
                        </VerticalStackLayout>
                        <BoxView HeightRequest="1"
                                 BackgroundColor="{StaticResource BorderColor}"/>
                        <!-- Adresse -->
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Adresse" FontSize="12"
                                   TextColor="{StaticResource TextSecondary}"/>
                            <Label Text="{Binding ClientAdresse}"
                                   FontSize="14"
                                   TextColor="{StaticResource TextPrimary}"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ── Visit History ────────────────────────────── -->
                <Label Text="Historique des visites" FontSize="14" FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}" Margin="0,4,0,8"/>

                <!-- Empty state for visits -->
                <Border IsVisible="{Binding HasVisites, Converter={StaticResource InvertedBoolConverter}}"
                        BackgroundColor="{StaticResource CardBackground}"
                        Stroke="{StaticResource BorderColor}"
                        StrokeShape="RoundRectangle 12"
                        Padding="20" Margin="0,0,0,10"
                        StrokeThickness="1">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                        <Label Text="📋" FontSize="32" HorizontalOptions="Center"/>
                        <Label Text="Aucune visite enregistrée"
                               FontSize="13" FontAttributes="Italic"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Visit list -->
                <CollectionView ItemsSource="{Binding Visites}"
                                IsVisible="{Binding HasVisites}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="field:Visite">
                            <Border BackgroundColor="{StaticResource CardBackground}"
                                    Stroke="{StaticResource BorderColor}"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="14" Margin="0,0,0,8"
                                    StrokeThickness="1">
                                <Grid ColumnDefinitions="4,12,*,Auto" RowDefinitions="Auto,Auto">

                                    <!-- Status accent bar -->
                                    <BoxView Grid.RowSpan="2" Grid.Column="0"
                                             BackgroundColor="{StaticResource Primary}"
                                             CornerRadius="2" WidthRequest="4"/>

                                    <!-- Date -->
                                    <Label Grid.Row="0" Grid.Column="2"
                                           Text="{Binding DateVisite, StringFormat='{0:dd/MM/yyyy}'}"
                                           FontSize="14" FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}"/>

                                    <!-- Status badge -->
                                    <Border Grid.Row="0" Grid.Column="3"
                                            BackgroundColor="{StaticResource PrimaryLight}"
                                            StrokeShape="RoundRectangle 12"
                                            Stroke="Transparent"
                                            Padding="8,3">
                                        <Label Text="{Binding Statut}"
                                               FontSize="11" FontAttributes="Bold"
                                               TextColor="{StaticResource PrimaryText}"/>
                                    </Border>

                                    <!-- Type -->
                                    <Label Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                                           Text="{Binding TypeVisite}"
                                           FontSize="12"
                                           TextColor="{StaticResource TextSecondary}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
