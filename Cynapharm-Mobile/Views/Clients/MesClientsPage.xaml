<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Cynapharm_Mobile.ViewModels.Clients"
             xmlns:auth="clr-namespace:Cynapharm_Mobile.Models.Auth"
             x:Class="Cynapharm_Mobile.Views.Clients.MesClientsPage"
             x:DataType="vm:MesClientsViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="Auto,*">

        <!-- ═══ HEADER ══════════════════════════════════════════════ -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource Primary}"
              Padding="16,48,16,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Hamburger button — opens flyout drawer -->
            <Border Grid.Row="0" Grid.Column="0"
                    BackgroundColor="#26FFFFFF"
                    StrokeShape="RoundRectangle 10"
                    Stroke="Transparent"
                    HeightRequest="36" WidthRequest="36"
                    VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHamburgerTapped"/>
                </Border.GestureRecognizers>
                <Path Data="M 4,7 L 20,7 M 4,12 L 20,12 M 4,17 L 20,17"
                      Stroke="White" StrokeThickness="2.5"
                      StrokeLineCap="Round"
                      HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

            <!-- Title -->
            <VerticalStackLayout Grid.Row="0" Grid.Column="1"
                                 VerticalOptions="Center" Margin="12,0,0,0">
                <Label Text="Mes clients"
                       FontSize="18" FontAttributes="Bold"
                       TextColor="White"/>
                <Label Text="Pharmaciens et grossistes"
                       FontSize="12" TextColor="#99FFFFFF"/>
            </VerticalStackLayout>

            <!-- Search bar -->
            <Border Grid.Row="1" Grid.ColumnSpan="2"
                    BackgroundColor="#26FFFFFF"
                    StrokeShape="RoundRectangle 10"
                    Stroke="Transparent"
                    Padding="12,0" Margin="0,14,0,0"
                    HeightRequest="44">
                <Grid ColumnDefinitions="Auto,*">
                    <Label Grid.Column="0" Text="🔍" FontSize="16"
                           VerticalOptions="Center" Margin="0,0,8,0"/>
                    <Entry Grid.Column="1"
                           Placeholder="Rechercher un client…"
                           PlaceholderColor="#80FFFFFF"
                           TextColor="White"
                           FontSize="14"
                           BackgroundColor="Transparent"
                           Text="{Binding SearchQuery}"
                           Margin="0"/>
                </Grid>
            </Border>

            <!-- Count -->
            <Label Grid.Row="2" Grid.ColumnSpan="2"
                   Text="{Binding Clients.Count, StringFormat='{0} client(s)'}"
                   FontSize="12" TextColor="#80FFFFFF"
                   Margin="0,8,0,0"/>
        </Grid>

        <!-- ═══ CONTENT ═════════════════════════════════════════════ -->
        <Grid Grid.Row="1">

            <!-- Loading -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}"
                               HeightRequest="40" VerticalOptions="Center"/>

            <!-- Empty state -->
            <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="8" Padding="20">
                <Label Text="👥" FontSize="48" HorizontalOptions="Center"/>
                <Label Text="Aucun client trouvé"
                       FontSize="14" FontAttributes="Italic"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Client list -->
            <CollectionView ItemsSource="{Binding Clients}"
                            IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                            Margin="14,10,14,80">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="auth:UserListItem">
                        <Border BackgroundColor="{StaticResource CardBackground}"
                                Stroke="{StaticResource BorderColor}"
                                StrokeShape="RoundRectangle 12"
                                Padding="14"
                                Margin="0,0,0,10"
                                StrokeThickness="1">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MesClientsViewModel}}, Path=GoToDetailCommand}"
                                    CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="48,12,*,Auto" RowDefinitions="Auto,Auto">

                                <!-- Avatar -->
                                <Border Grid.RowSpan="2" Grid.Column="0"
                                        BackgroundColor="{StaticResource PrimaryLight}"
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="Transparent"
                                        HeightRequest="44" WidthRequest="44"
                                        VerticalOptions="Center">
                                    <Label Text="👤" FontSize="20"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>

                                <!-- Name -->
                                <Label Grid.Row="0" Grid.Column="2"
                                       Text="{Binding Name}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"
                                       LineBreakMode="TailTruncation"/>

                                <!-- Type badge -->
                                <Border Grid.Row="0" Grid.Column="3"
                                        BackgroundColor="{StaticResource PrimaryLight}"
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="Transparent"
                                        Padding="8,3"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding TypeClient}"
                                           FontSize="11" FontAttributes="Bold"
                                           TextColor="{StaticResource PrimaryText}"/>
                                </Border>

                                <!-- ID subtitle -->
                                <Label Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                                       Text="{Binding Id, StringFormat='Client #{0}'}"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- FAB: + Nouveau client -->
            <Button Text="+ Nouveau client"
                    Command="{Binding CreateClientCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="15"
                    HeightRequest="50"
                    CornerRadius="10"
                    Margin="14,0,14,20"
                    VerticalOptions="End"/>
        </Grid>
    </Grid>
</ContentPage>
