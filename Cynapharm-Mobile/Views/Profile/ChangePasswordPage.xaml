<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Cynapharm_Mobile.ViewModels.Profile"
             xmlns:controls="clr-namespace:Cynapharm_Mobile.Controls"
             x:Class="Cynapharm_Mobile.Views.Profile.ChangePasswordPage"
             x:DataType="vm:ChangePasswordViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" BackgroundColor="#2d6a4f" Padding="16,48,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Text="‹"
                    TextColor="White"
                    BackgroundColor="Transparent"
                    FontSize="24" FontAttributes="Bold"
                    Padding="0"
                    Command="{Binding CancelCommand}" />
            <Label Grid.Column="1"
                   Text="Changer le mot de passe"
                   FontSize="16" FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Grid>

        <!-- ── Body ──────────────────────────────────────────────────────── -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="16">

                <controls:ErrorBanner Message="{Binding ErrorMessage}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Primary}"
                                   HorizontalOptions="Center" />

                <!-- ── Info banner ────────────────────────────────────── -->
                <Border BackgroundColor="#e8f4fd"
                        StrokeShape="RoundRectangle 12"
                        Stroke="Transparent"
                        Padding="14,12">
                    <Grid ColumnDefinitions="24,*" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="ℹ️" FontSize="16"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="Le mot de passe doit contenir au moins 6 caractères."
                               FontSize="13" TextColor="#185FA5" />
                    </Grid>
                </Border>

                <!-- ── Password fields card ───────────────────────────── -->
                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="16">

                        <!-- Mot de passe actuel -->
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="MOT DE PASSE ACTUEL"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="{StaticResource TextMuted}"
                                       CharacterSpacing="0.5" />
                                <Label Grid.Column="1"
                                       Text="*" TextColor="{StaticResource Danger}"
                                       FontSize="13" FontAttributes="Bold" />
                            </Grid>
                            <Border BackgroundColor="#f7f7f9"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="{StaticResource BorderColor}"
                                    StrokeThickness="1"
                                    Padding="12,0" HeightRequest="50">
                                <Grid ColumnDefinitions="22,*,36" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="🔒" FontSize="16"
                                           VerticalOptions="Center" />
                                    <Entry Grid.Column="1"
                                           Text="{Binding OldPassword}"
                                           Placeholder="Mot de passe actuel"
                                           IsPassword="{Binding ShowOldPassword, Converter={StaticResource InvertedBoolConverter}}"
                                           BackgroundColor="Transparent"
                                           Margin="0" VerticalOptions="Center" />
                                    <!-- ti-eye (U+EA9A verified) -->
                                    <Label Grid.Column="2"
                                           FontFamily="Tabler" Text="&#xea9a;"
                                           FontSize="20"
                                           TextColor="{StaticResource TextMuted}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleShowOldPasswordCommand}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Nouveau mot de passe -->
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="NOUVEAU MOT DE PASSE"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="{StaticResource TextMuted}"
                                       CharacterSpacing="0.5" />
                                <Label Grid.Column="1"
                                       Text="*" TextColor="{StaticResource Danger}"
                                       FontSize="13" FontAttributes="Bold" />
                            </Grid>
                            <Border BackgroundColor="#f7f7f9"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="{StaticResource BorderColor}"
                                    StrokeThickness="1"
                                    Padding="12,0" HeightRequest="50">
                                <Grid ColumnDefinitions="22,*,36" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="🔒" FontSize="16"
                                           VerticalOptions="Center" />
                                    <Entry Grid.Column="1"
                                           Text="{Binding NewPassword}"
                                           Placeholder="Nouveau mot de passe"
                                           IsPassword="{Binding ShowNewPassword, Converter={StaticResource InvertedBoolConverter}}"
                                           BackgroundColor="Transparent"
                                           Margin="0" VerticalOptions="Center" />
                                    <Label Grid.Column="2"
                                           FontFamily="Tabler" Text="&#xea9a;"
                                           FontSize="20"
                                           TextColor="{StaticResource TextMuted}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleShowNewPasswordCommand}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </Border>

                            <!-- Strength bar (4 segments) -->
                            <Grid ColumnDefinitions="*,4,*,4,*,4,*" HeightRequest="6"
                                  IsVisible="{Binding NewPassword, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                                <BoxView Grid.Column="0" BackgroundColor="{Binding Seg1Color}" CornerRadius="3" />
                                <BoxView Grid.Column="2" BackgroundColor="{Binding Seg2Color}" CornerRadius="3" />
                                <BoxView Grid.Column="4" BackgroundColor="{Binding Seg3Color}" CornerRadius="3" />
                                <BoxView Grid.Column="6" BackgroundColor="{Binding Seg4Color}" CornerRadius="3" />
                            </Grid>
                            <Label Text="{Binding StrengthLabel}"
                                   FontSize="11" FontAttributes="Bold"
                                   TextColor="{StaticResource TextMuted}"
                                   IsVisible="{Binding StrengthLabel, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                        </VerticalStackLayout>

                        <!-- Confirmer le mot de passe -->
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="CONFIRMER LE MOT DE PASSE"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="{StaticResource TextMuted}"
                                       CharacterSpacing="0.5" />
                                <Label Grid.Column="1"
                                       Text="*" TextColor="{StaticResource Danger}"
                                       FontSize="13" FontAttributes="Bold" />
                            </Grid>
                            <Border BackgroundColor="#f7f7f9"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="{StaticResource BorderColor}"
                                    StrokeThickness="1"
                                    Padding="12,0" HeightRequest="50">
                                <Grid ColumnDefinitions="22,*,36" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="🔒" FontSize="16"
                                           VerticalOptions="Center" />
                                    <Entry Grid.Column="1"
                                           Text="{Binding ConfirmPassword}"
                                           Placeholder="Confirmer le mot de passe"
                                           IsPassword="{Binding ShowConfirmPassword, Converter={StaticResource InvertedBoolConverter}}"
                                           BackgroundColor="Transparent"
                                           Margin="0" VerticalOptions="Center" />
                                    <Label Grid.Column="2"
                                           FontFamily="Tabler" Text="&#xea9a;"
                                           FontSize="20"
                                           TextColor="{StaticResource TextMuted}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleShowConfirmPasswordCommand}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Match indicator -->
                        <Border BackgroundColor="#edfaf3"
                                StrokeShape="RoundRectangle 10"
                                Stroke="Transparent"
                                Padding="12,10"
                                IsVisible="{Binding PasswordsMatch}">
                            <Grid ColumnDefinitions="22,*" ColumnSpacing="10">
                                <Label Grid.Column="0" Text="✅" FontSize="16"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="Les mots de passe correspondent ✓"
                                       FontSize="13" FontAttributes="Bold"
                                       TextColor="#2d7a4f" />
                            </Grid>
                        </Border>

                        <!-- Mismatch indicator -->
                        <Border BackgroundColor="{StaticResource DangerLight}"
                                StrokeShape="RoundRectangle 10"
                                Stroke="Transparent"
                                Padding="12,10"
                                IsVisible="{Binding PasswordsMismatch}">
                            <Grid ColumnDefinitions="22,*" ColumnSpacing="10">
                                <Label Grid.Column="0" Text="❌" FontSize="16"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="Les mots de passe ne correspondent pas"
                                       FontSize="13" FontAttributes="Bold"
                                       TextColor="{StaticResource Danger}" />
                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <!-- ── Buttons ────────────────────────────────────────── -->
                <Button Text="Mettre à jour"
                        Command="{Binding ChangePasswordCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

                <Button Text="Annuler"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource TextSecondary}"
                        BorderColor="{StaticResource BorderColor}"
                        BorderWidth="1"
                        HeightRequest="44"
                        CornerRadius="10"
                        FontSize="14" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
