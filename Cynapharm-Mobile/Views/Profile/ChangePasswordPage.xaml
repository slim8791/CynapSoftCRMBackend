<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Cynapharm_Mobile.ViewModels.Profile"
             xmlns:controls="clr-namespace:Cynapharm_Mobile.Controls"
             x:Class="Cynapharm_Mobile.Views.Profile.ChangePasswordPage"
             x:DataType="vm:ChangePasswordViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Primary}" Padding="16,48,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BackgroundColor="#26FFFFFF"
                    StrokeShape="RoundRectangle 12"
                    Stroke="Transparent"
                    HeightRequest="38" WidthRequest="38"
                    VerticalOptions="Center">
                <Label Text="‹" FontSize="24" FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CancelCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Border>

            <Label Grid.Column="1"
                   Text="Changer le mot de passe"
                   FontSize="16" FontAttributes="Bold"
                   FontFamily="OpenSansSemibold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Grid>

        <!-- ── Body ──────────────────────────────────────────────────────── -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,16,16,8" Spacing="0">

                <controls:ErrorBanner Message="{Binding ErrorMessage}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Primary}"
                                   HorizontalOptions="Center"
                                   Margin="0,4" />

                <!-- ── Info banner ────────────────────────────────────────── -->
                <Border BackgroundColor="{StaticResource InfoBackground}"
                        StrokeShape="RoundRectangle 14"
                        Stroke="{StaticResource InfoText}" StrokeThickness="0.5"
                        Padding="14,12"
                        Margin="0,0,0,16">
                    <Grid ColumnDefinitions="36,*" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                BackgroundColor="#1A0C447C"
                                StrokeShape="RoundRectangle 10"
                                Stroke="Transparent"
                                WidthRequest="36" HeightRequest="36">
                            <Label Text="ℹ️" FontSize="17"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1"
                               Text="Le mot de passe doit contenir au moins 6 caractères."
                               FontSize="13" TextColor="{StaticResource InfoText}"
                               LineHeight="1.4"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- ── Section title ─────────────────────────────────────── -->
                <Grid ColumnDefinitions="4,*" ColumnSpacing="10" Margin="2,0,0,10">
                    <BoxView Grid.Column="0" BackgroundColor="{StaticResource Primary}"
                             CornerRadius="2" WidthRequest="4" />
                    <Label Grid.Column="1"
                           Text="Mise à jour du mot de passe"
                           FontSize="13" FontAttributes="Bold"
                           FontFamily="OpenSansSemibold"
                           TextColor="{StaticResource TextPrimary}"
                           VerticalOptions="Center" />
                </Grid>

                <!-- ── Password fields card ───────────────────────────────── -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                    <VerticalStackLayout Spacing="18">

                        <!-- Mot de passe actuel -->
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="Mot de passe actuel"
                                       FontSize="12" FontAttributes="Bold"
                                       TextColor="{StaticResource TextSecondary}" />
                                <Label Grid.Column="1"
                                       Text=" *" TextColor="{StaticResource Danger}"
                                       FontSize="14" FontAttributes="Bold" />
                            </Grid>
                            <Border BackgroundColor="{StaticResource SurfaceBackground}"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="{StaticResource FieldBorderInactive}"
                                    StrokeThickness="1.5"
                                    Padding="14,0" HeightRequest="52">
                                <Grid ColumnDefinitions="24,*,38" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="🔒" FontSize="17"
                                           VerticalOptions="Center" />
                                    <Entry Grid.Column="1"
                                           Text="{Binding OldPassword}"
                                           Placeholder="Mot de passe actuel"
                                           IsPassword="{Binding ShowOldPassword, Converter={StaticResource InvertedBoolConverter}}"
                                           BackgroundColor="Transparent"
                                           HeightRequest="52"
                                           Margin="0" VerticalOptions="Center" />
                                    <Label Grid.Column="2"
                                           FontFamily="Tabler" Text="&#xea9a;"
                                           FontSize="20"
                                           TextColor="{StaticResource TextMuted}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleShowOldPasswordCommand}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Nouveau mot de passe -->
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="Nouveau mot de passe"
                                       FontSize="12" FontAttributes="Bold"
                                       TextColor="{StaticResource TextSecondary}" />
                                <Label Grid.Column="1"
                                       Text=" *" TextColor="{StaticResource Danger}"
                                       FontSize="14" FontAttributes="Bold" />
                            </Grid>
                            <Border BackgroundColor="{StaticResource SurfaceBackground}"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="{StaticResource FieldBorderInactive}"
                                    StrokeThickness="1.5"
                                    Padding="14,0" HeightRequest="52">
                                <Grid ColumnDefinitions="24,*,38" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="🔑" FontSize="17"
                                           VerticalOptions="Center" />
                                    <Entry Grid.Column="1"
                                           Text="{Binding NewPassword}"
                                           Placeholder="Nouveau mot de passe"
                                           IsPassword="{Binding ShowNewPassword, Converter={StaticResource InvertedBoolConverter}}"
                                           BackgroundColor="Transparent"
                                           HeightRequest="52"
                                           Margin="0" VerticalOptions="Center" />
                                    <Label Grid.Column="2"
                                           FontFamily="Tabler" Text="&#xea9a;"
                                           FontSize="20"
                                           TextColor="{StaticResource TextMuted}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleShowNewPasswordCommand}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </Border>

                            <!-- Strength bar (4 segments) -->
                            <Grid ColumnDefinitions="*,5,*,5,*,5,*" HeightRequest="8"
                                  Margin="2,2,2,0"
                                  IsVisible="{Binding NewPassword, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                                <BoxView Grid.Column="0" BackgroundColor="{Binding Seg1Color}" CornerRadius="4" />
                                <BoxView Grid.Column="2" BackgroundColor="{Binding Seg2Color}" CornerRadius="4" />
                                <BoxView Grid.Column="4" BackgroundColor="{Binding Seg3Color}" CornerRadius="4" />
                                <BoxView Grid.Column="6" BackgroundColor="{Binding Seg4Color}" CornerRadius="4" />
                            </Grid>
                            <Label Text="{Binding StrengthLabel}"
                                   FontSize="11" FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}"
                                   IsVisible="{Binding StrengthLabel, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                        </VerticalStackLayout>

                        <!-- Confirmer le mot de passe -->
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="Confirmer le mot de passe"
                                       FontSize="12" FontAttributes="Bold"
                                       TextColor="{StaticResource TextSecondary}" />
                                <Label Grid.Column="1"
                                       Text=" *" TextColor="{StaticResource Danger}"
                                       FontSize="14" FontAttributes="Bold" />
                            </Grid>
                            <Border BackgroundColor="{StaticResource SurfaceBackground}"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="{StaticResource FieldBorderInactive}"
                                    StrokeThickness="1.5"
                                    Padding="14,0" HeightRequest="52">
                                <Grid ColumnDefinitions="24,*,38" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="🔒" FontSize="17"
                                           VerticalOptions="Center" />
                                    <Entry Grid.Column="1"
                                           Text="{Binding ConfirmPassword}"
                                           Placeholder="Confirmer le mot de passe"
                                           IsPassword="{Binding ShowConfirmPassword, Converter={StaticResource InvertedBoolConverter}}"
                                           BackgroundColor="Transparent"
                                           HeightRequest="52"
                                           Margin="0" VerticalOptions="Center" />
                                    <Label Grid.Column="2"
                                           FontFamily="Tabler" Text="&#xea9a;"
                                           FontSize="20"
                                           TextColor="{StaticResource TextMuted}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleShowConfirmPasswordCommand}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Match indicator -->
                        <Border BackgroundColor="#E8F5E9"
                                StrokeShape="RoundRectangle 12"
                                Stroke="#A5D6A7" StrokeThickness="1"
                                Padding="14,12"
                                IsVisible="{Binding PasswordsMatch}">
                            <Grid ColumnDefinitions="30,*" ColumnSpacing="12">
                                <Border Grid.Column="0"
                                        BackgroundColor="#C8E6C9"
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="Transparent"
                                        WidthRequest="30" HeightRequest="30">
                                    <Label Text="✅" FontSize="15"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Grid.Column="1"
                                       Text="Les mots de passe correspondent"
                                       FontSize="13" FontAttributes="Bold"
                                       TextColor="#2d7a4f"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Mismatch indicator -->
                        <Border BackgroundColor="{StaticResource DangerLight}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="#F7C1C1" StrokeThickness="1"
                                Padding="14,12"
                                IsVisible="{Binding PasswordsMismatch}">
                            <Grid ColumnDefinitions="30,*" ColumnSpacing="12">
                                <Border Grid.Column="0"
                                        BackgroundColor="#FFCDD2"
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="Transparent"
                                        WidthRequest="30" HeightRequest="30">
                                    <Label Text="❌" FontSize="15"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Grid.Column="1"
                                       Text="Les mots de passe ne correspondent pas"
                                       FontSize="13" FontAttributes="Bold"
                                       TextColor="{StaticResource Danger}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ── Sticky action bar ──────────────────────────────────────────── -->
        <Grid Grid.Row="2" BackgroundColor="{StaticResource CardBackground}">
            <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}"
                     VerticalOptions="Start" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Padding="16,12,16,28">
                <Button Grid.Column="0"
                        Text="Annuler"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HeightRequest="48" Margin="0" />
                <Button Grid.Column="1"
                        Text="Mettre à jour"
                        Command="{Binding ChangePasswordCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HeightRequest="48" Margin="0"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
            </Grid>
        </Grid>

    </Grid>
</ContentPage>
