<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Cynapharm_Mobile.ViewModels.Profile"
             xmlns:controls="clr-namespace:Cynapharm_Mobile.Controls"
             x:Class="Cynapharm_Mobile.Views.Profile.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="Mon Profil"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="Auto,*">

        <!-- ── Hero header ────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Primary}">

            <!-- Hamburger overlay (top-left, within safe-area padding) -->
            <Border BackgroundColor="#26FFFFFF" StrokeShape="RoundRectangle 12"
                    Stroke="Transparent" HeightRequest="38" WidthRequest="38"
                    HorizontalOptions="Start" VerticalOptions="Start"
                    Margin="16,52,0,0"
                    ZIndex="10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHamburgerTapped" />
                </Border.GestureRecognizers>
                <!-- SVG Hamburger Menu -->
                <Path Data="M 5,7 L 19,7 M 5,12 L 19,12 M 5,17 L 19,17"
                      Stroke="White" StrokeThickness="2.5"
                      StrokeLineJoin="Round" StrokeLineCap="Round"
                      HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <VerticalStackLayout Spacing="0" Padding="20,52,20,28">

                <!-- Avatar with white ring -->
                <Grid HorizontalOptions="Center" WidthRequest="100" HeightRequest="100"
                      Margin="0,0,0,14">
                    <!-- White ring -->
                    <Border BackgroundColor="#40FFFFFF"
                            StrokeShape="RoundRectangle 50"
                            Stroke="White" StrokeThickness="2.5"
                            HeightRequest="100" WidthRequest="100"
                            HorizontalOptions="Center" VerticalOptions="Center" />
                    <!-- Initials -->
                    <Border BackgroundColor="#33FFFFFF"
                            StrokeShape="RoundRectangle 46"
                            Stroke="Transparent"
                            HeightRequest="92" WidthRequest="92"
                            HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="{Binding AvatarInitials}"
                               FontSize="30" FontAttributes="Bold"
                               FontFamily="OpenSansSemibold"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Name -->
                <Label Text="{Binding User.Name}"
                       FontSize="20" FontAttributes="Bold"
                       FontFamily="OpenSansSemibold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       Margin="0,0,0,8" />

                <!-- Role badge -->
                <Border HorizontalOptions="Center"
                        StrokeShape="RoundRectangle 14"
                        Stroke="Transparent"
                        Padding="16,5">
                    <Border.BackgroundColor>
                        <Color>#26FFFFFF</Color>
                    </Border.BackgroundColor>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsClient}" Value="True">
                            <Setter Property="BackgroundColor" Value="#26FFFFFF" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsMedecin}" Value="True">
                            <Setter Property="BackgroundColor" Value="#26FFFFFF" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="{Binding User.Role}"
                           FontSize="12" FontAttributes="Bold"
                           TextColor="White" />
                </Border>

            </VerticalStackLayout>
        </Grid>

        <!-- ── Body ──────────────────────────────────────────────────────── -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,16,16,0" Spacing="0">

                <controls:ErrorBanner Message="{Binding ErrorMessage}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Primary}"
                                   HorizontalOptions="Center"
                                   Margin="0,8" />

                <!-- ── Section title: Informations ──────────────────────── -->
                <Grid ColumnDefinitions="4,*" ColumnSpacing="10" Margin="2,4,0,8">
                    <BoxView Grid.Column="0" BackgroundColor="{StaticResource Primary}"
                             CornerRadius="2" WidthRequest="4" />
                    <Label Grid.Column="1"
                           Text="Informations personnelles"
                           FontSize="13" FontAttributes="Bold"
                           FontFamily="OpenSansSemibold"
                           TextColor="{StaticResource TextPrimary}"
                           VerticalOptions="Center" />
                </Grid>

                <!-- ── Info card ─────────────────────────────────────────── -->
                <Border Style="{StaticResource CardStyle}" Padding="4,4">
                    <VerticalStackLayout Spacing="0">

                        <!-- Email -->
                        <Grid ColumnDefinitions="48,*" ColumnSpacing="12" Padding="10,12">
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource PrimaryLight}"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="Transparent"
                                    HeightRequest="42" WidthRequest="42"
                                    HorizontalOptions="Center">
                                <Label Text="✉️" FontSize="16"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Email" FontSize="11"
                                       TextColor="{StaticResource TextMuted}" />
                                <Label Text="{Binding User.Email}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}"
                                 Margin="60,0,12,0"
                                 IsVisible="{Binding User.Telephone, Converter={StaticResource IsNotNullOrEmptyConverter}}" />

                        <!-- Phone -->
                        <Grid ColumnDefinitions="48,*" ColumnSpacing="12" Padding="10,12"
                              IsVisible="{Binding User.Telephone, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource PrimaryLight}"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="Transparent"
                                    HeightRequest="42" WidthRequest="42"
                                    HorizontalOptions="Center">
                                <Label Text="📞" FontSize="16"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Téléphone" FontSize="11"
                                       TextColor="{StaticResource TextMuted}" />
                                <Label Text="{Binding User.Telephone}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Region (DELEGUE) -->
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}"
                                 Margin="60,0,12,0" IsVisible="{Binding IsDelegue}" />
                        <Grid ColumnDefinitions="48,*" ColumnSpacing="12" Padding="10,12"
                              IsVisible="{Binding IsDelegue}">
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource PrimaryLight}"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="Transparent"
                                    HeightRequest="42" WidthRequest="42"
                                    HorizontalOptions="Center">
                                <Label Text="🗺️" FontSize="16"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Région" FontSize="12"
                                       TextColor="{StaticResource TextMuted}" />
                                <Label Text="{Binding RegionLabel}"
                                       FontSize="15" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"
                                       IsVisible="{Binding HasRegion}" />
                                <Label Text="Non assigné"
                                       FontSize="13"
                                       TextColor="{StaticResource TextMuted}"
                                       IsVisible="{Binding HasRegion, Converter={StaticResource InvertedBoolConverter}}" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Adresse (CLIENT) -->
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}"
                                 Margin="60,0,12,0" IsVisible="{Binding IsClient}" />
                        <Grid ColumnDefinitions="48,*" ColumnSpacing="12" Padding="10,12"
                              IsVisible="{Binding IsClient}">
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource PrimaryLight}"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="Transparent"
                                    HeightRequest="42" WidthRequest="42"
                                    HorizontalOptions="Center">
                                <Label Text="🏪" FontSize="16"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Adresse" FontSize="11"
                                       TextColor="{StaticResource TextMuted}" />
                                <Label Text="{Binding User.Adresse}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Cabinet (MEDECIN) -->
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}"
                                 Margin="60,0,12,0" IsVisible="{Binding IsMedecin}" />
                        <Grid ColumnDefinitions="48,*" ColumnSpacing="12" Padding="10,12"
                              IsVisible="{Binding IsMedecin}">
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource PrimaryLight}"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="Transparent"
                                    HeightRequest="42" WidthRequest="42"
                                    HorizontalOptions="Center">
                                <Label Text="🏥" FontSize="16"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Cabinet" FontSize="11"
                                       TextColor="{StaticResource TextMuted}" />
                                <Label Text="{Binding User.Adresse}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                            </VerticalStackLayout>
                        </Grid>


                        <!-- Delegate banner (MEDECIN) -->
                        <Border BackgroundColor="{StaticResource InfoBackground}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="Transparent"
                                Padding="12,10"
                                Margin="10,4,10,10"
                                IsVisible="{Binding IsMedecin}">
                            <Grid ColumnDefinitions="36,*" ColumnSpacing="10">
                                <Border Grid.Column="0"
                                        BackgroundColor="#1A0C447C"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="Transparent"
                                        WidthRequest="36" HeightRequest="36">
                                    <Label Text="👤" FontSize="17"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2"
                                                     VerticalOptions="Center">
                                    <Label Text="Délégué assigné" FontSize="11"
                                           TextColor="{StaticResource InfoText}" />
                                    <Label Text="Contactez votre délégué Cynapharm"
                                           FontSize="13" FontAttributes="Bold"
                                           TextColor="{StaticResource InfoText}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <!-- ── Section title: Compte ─────────────────────────────── -->
                <Grid ColumnDefinitions="4,*" ColumnSpacing="10" Margin="2,16,0,8">
                    <BoxView Grid.Column="0" BackgroundColor="{StaticResource Primary}"
                             CornerRadius="2" WidthRequest="4" />
                    <Label Grid.Column="1"
                           Text="Compte"
                           FontSize="13" FontAttributes="Bold"
                           FontFamily="OpenSansSemibold"
                           TextColor="{StaticResource TextPrimary}"
                           VerticalOptions="Center" />
                </Grid>

                <!-- ── Account actions card ──────────────────────────────── -->
                <Border Style="{StaticResource CardStyle}" Padding="4,4">
                    <VerticalStackLayout Spacing="0">

                        <!-- Modifier le profil -->
                        <Grid ColumnDefinitions="48,*,28" ColumnSpacing="12" Padding="10,14">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToEditProfileCommand}" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource PrimaryLight}"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="Transparent"
                                    HeightRequest="42" WidthRequest="42"
                                    HorizontalOptions="Center">
                                <Label Text="✏️" FontSize="16"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Modifier le profil"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Text="Nom, téléphone, adresse"
                                       FontSize="11"
                                       TextColor="{StaticResource TextMuted}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="22"
                                   TextColor="{StaticResource TextMuted}"
                                   VerticalOptions="Center" HorizontalOptions="End" />
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}"
                                 Margin="60,0,12,0" />

                        <!-- Changer le mot de passe -->
                        <Grid ColumnDefinitions="48,*,28" ColumnSpacing="12" Padding="10,14">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToChangePasswordCommand}" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource PrimaryLight}"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="Transparent"
                                    HeightRequest="42" WidthRequest="42"
                                    HorizontalOptions="Center">
                                <Label Text="🔒" FontSize="16"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Changer le mot de passe"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Text="Mettre à jour vos identifiants"
                                       FontSize="11"
                                       TextColor="{StaticResource TextMuted}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="22"
                                   TextColor="{StaticResource TextMuted}"
                                   VerticalOptions="Center" HorizontalOptions="End" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- ── Logout row (standalone danger card) ───────────────── -->
                <Border BackgroundColor="{StaticResource DangerLight}"
                        StrokeShape="RoundRectangle 14"
                        Stroke="#F7C1C1" StrokeThickness="1"
                        Padding="4,2"
                        Margin="0,4,0,0">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,1" Radius="4" Opacity="0.05" />
                    </Border.Shadow>
                    <Grid ColumnDefinitions="48,*,28" ColumnSpacing="12" Padding="10,14">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0"
                                BackgroundColor="#FFD6D6"
                                StrokeShape="RoundRectangle 12"
                                Stroke="Transparent"
                                HeightRequest="42" WidthRequest="42"
                                HorizontalOptions="Center">
                            <Path Data="M13 3h-2v10h2V3zm4.83 2.17l-1.42 1.42C17.99 7.86 19 9.81 19 12c0 3.87-3.13 7-7 7s-7-3.13-7-7c0-2.19 1.01-4.14 2.58-5.42L6.17 5.17C4.23 6.82 3 9.26 3 12c0 4.97 4.03 9 9 9s9-4.03 9-9c0-2.74-1.23-5.18-3.17-6.83z"
                                  Fill="{StaticResource Danger}"
                                  Aspect="Uniform"
                                  HeightRequest="20" WidthRequest="20"
                                  HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Se déconnecter"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource Danger}" />
                            <Label Text="Quitter l'application"
                                   FontSize="11"
                                   TextColor="{StaticResource DangerText}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="22"
                               TextColor="{StaticResource Danger}"
                               VerticalOptions="Center" HorizontalOptions="End" />
                    </Grid>
                </Border>

                <!-- ── Footer ────────────────────────────────────────────── -->
                <Label Text="© 2026 CynaPharm · Tous droits réservés"
                       FontSize="11"
                       TextColor="{StaticResource TextMuted}"
                       HorizontalOptions="Center"
                       Margin="0,20,0,32" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
