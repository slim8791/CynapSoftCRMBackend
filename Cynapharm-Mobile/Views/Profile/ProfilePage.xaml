<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Cynapharm_Mobile.ViewModels.Profile"
             xmlns:controls="clr-namespace:Cynapharm_Mobile.Controls"
             x:Class="Cynapharm_Mobile.Views.Profile.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="Mon Profil"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" BackgroundColor="#2d6a4f" Padding="16,48,16,24">
            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">

                <!-- Avatar circle -->
                <Border BackgroundColor="#33FFFFFF"
                        StrokeShape="RoundRectangle 38"
                        Stroke="Transparent"
                        HeightRequest="76" WidthRequest="76"
                        HorizontalOptions="Center">
                    <Label x:Name="AvatarLabel"
                           Text="{Binding AvatarInitials}"
                           FontSize="26" FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- User name -->
                <Label Text="{Binding User.Name}"
                       FontSize="18" FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" />

                <!-- Role badge — color adapts by role via DataTriggers -->
                <Border BackgroundColor="#e8f7fb"
                        StrokeShape="RoundRectangle 12"
                        Stroke="Transparent"
                        Padding="14,4"
                        HorizontalOptions="Center">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsClient}" Value="True">
                            <Setter Property="BackgroundColor" Value="#edfaf3" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsMedecin}" Value="True">
                            <Setter Property="BackgroundColor" Value="#f0efff" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="{Binding User.Role}"
                           FontSize="12" FontAttributes="Bold"
                           TextColor="#00B4D8">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsClient}" Value="True">
                                <Setter Property="TextColor" Value="#2d7a4f" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsMedecin}" Value="True">
                                <Setter Property="TextColor" Value="#6c5ce7" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>

            </VerticalStackLayout>
        </Grid>

        <!-- ── Body ──────────────────────────────────────────────────────── -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="0">

                <controls:ErrorBanner Message="{Binding ErrorMessage}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Primary}"
                                   HorizontalOptions="Center"
                                   Margin="0,8" />

                <!-- ── Section 1 label ───────────────────────────────── -->
                <Label Text="INFORMATIONS PERSONNELLES"
                       FontSize="11" FontAttributes="Bold"
                       TextColor="{StaticResource TextMuted}"
                       CharacterSpacing="0.5"
                       Margin="4,12,4,6" />

                <!-- ── Info card ─────────────────────────────────────── -->
                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="0">

                        <!-- Email row (all roles) -->
                        <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="12" Padding="2,10">
                            <Border Grid.Column="0"
                                    BackgroundColor="#e8f7fb"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="Transparent"
                                    HeightRequest="36" WidthRequest="36">
                                <Label Text="✉️" FontSize="15"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Email" FontSize="11"
                                       TextColor="{StaticResource TextMuted}" />
                                <Label Text="{Binding User.Email}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="22"
                                   TextColor="{StaticResource TextMuted}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}"
                                 Margin="48,0,0,0"
                                 IsVisible="{Binding User.Telephone, Converter={StaticResource IsNotNullOrEmptyConverter}}" />

                        <!-- Phone row -->
                        <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="12" Padding="2,10"
                              IsVisible="{Binding User.Telephone, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                            <Border Grid.Column="0"
                                    BackgroundColor="#e8f7fb"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="Transparent"
                                    HeightRequest="36" WidthRequest="36">
                                <Label Text="📞" FontSize="15"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Téléphone" FontSize="11"
                                       TextColor="{StaticResource TextMuted}" />
                                <Label Text="{Binding User.Telephone}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="22"
                                   TextColor="{StaticResource TextMuted}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <!-- Region row (DELEGUE only) -->
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}"
                                 Margin="48,0,0,0" IsVisible="{Binding IsDelegue}" />
                        <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="12" Padding="2,10"
                              IsVisible="{Binding IsDelegue}">
                            <Border Grid.Column="0"
                                    BackgroundColor="#e8f7fb"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="Transparent"
                                    HeightRequest="36" WidthRequest="36">
                                <Label Text="🗺️" FontSize="15"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Région" FontSize="11"
                                       TextColor="{StaticResource TextMuted}" />
                                <Label Text="{Binding User.RegionId}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="22"
                                   TextColor="{StaticResource TextMuted}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <!-- Address row (CLIENT only) -->
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}"
                                 Margin="48,0,0,0" IsVisible="{Binding IsClient}" />
                        <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="12" Padding="2,10"
                              IsVisible="{Binding IsClient}">
                            <Border Grid.Column="0"
                                    BackgroundColor="#e8f7fb"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="Transparent"
                                    HeightRequest="36" WidthRequest="36">
                                <Label Text="🏪" FontSize="15"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Adresse" FontSize="11"
                                       TextColor="{StaticResource TextMuted}" />
                                <Label Text="{Binding User.Adresse}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="22"
                                   TextColor="{StaticResource TextMuted}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <!-- Cabinet row (MEDECIN only — Adresse field) -->
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}"
                                 Margin="48,0,0,0" IsVisible="{Binding IsMedecin}" />
                        <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="12" Padding="2,10"
                              IsVisible="{Binding IsMedecin}">
                            <Border Grid.Column="0"
                                    BackgroundColor="#e8f7fb"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="Transparent"
                                    HeightRequest="36" WidthRequest="36">
                                <Label Text="🏥" FontSize="15"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Cabinet" FontSize="11"
                                       TextColor="{StaticResource TextMuted}" />
                                <Label Text="{Binding User.Adresse}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="22"
                                   TextColor="{StaticResource TextMuted}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <!-- Wilaya row (MEDECIN only — RegionId field) -->
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}"
                                 Margin="48,0,0,0" IsVisible="{Binding IsMedecin}" />
                        <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="12" Padding="2,10"
                              IsVisible="{Binding IsMedecin}">
                            <Border Grid.Column="0"
                                    BackgroundColor="#e8f7fb"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="Transparent"
                                    HeightRequest="36" WidthRequest="36">
                                <Label Text="📍" FontSize="15"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Wilaya" FontSize="11"
                                       TextColor="{StaticResource TextMuted}" />
                                <Label Text="{Binding User.RegionId}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="22"
                                   TextColor="{StaticResource TextMuted}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <!-- Delegate info banner (MEDECIN only) -->
                        <Border BackgroundColor="#e8f4fd"
                                StrokeShape="RoundRectangle 10"
                                Stroke="Transparent"
                                Padding="12,10"
                                Margin="0,6,0,2"
                                IsVisible="{Binding IsMedecin}">
                            <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
                                <Label Grid.Column="0"
                                       Text="👤" FontSize="18"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Délégué assigné" FontSize="11"
                                           TextColor="#185FA5" />
                                    <Label Text="Contactez votre délégué Cynapharm"
                                           FontSize="13" FontAttributes="Bold"
                                           TextColor="#185FA5" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <!-- ── Section 2 label ───────────────────────────────── -->
                <Label Text="COMPTE"
                       FontSize="11" FontAttributes="Bold"
                       TextColor="{StaticResource TextMuted}"
                       CharacterSpacing="0.5"
                       Margin="4,12,4,6" />

                <!-- ── Account card ──────────────────────────────────── -->
                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="0">

                        <!-- Modifier le profil -->
                        <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="12" Padding="2,12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToEditProfileCommand}" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0"
                                    BackgroundColor="#e8f7fb"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="Transparent"
                                    HeightRequest="36" WidthRequest="36">
                                <Label Text="✏️" FontSize="15"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Modifier le profil"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" FontSize="22"
                                   TextColor="{StaticResource TextMuted}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}"
                                 Margin="48,0,0,0" />

                        <!-- Changer le mot de passe -->
                        <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="12" Padding="2,12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToChangePasswordCommand}" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0"
                                    BackgroundColor="#e8f7fb"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="Transparent"
                                    HeightRequest="36" WidthRequest="36">
                                <Label Text="🔒" FontSize="15"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Changer le mot de passe"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" FontSize="22"
                                   TextColor="{StaticResource TextMuted}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}"
                                 Margin="48,0,0,0" />

                        <!-- Se déconnecter -->
                        <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="12" Padding="2,12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0"
                                    BackgroundColor="#feeaea"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="Transparent"
                                    HeightRequest="36" WidthRequest="36">
                                <Label Text="🚪" FontSize="15"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Se déconnecter"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="#e24b4a"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" FontSize="22"
                                   TextColor="#e24b4a"
                                   VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- ── Footer ────────────────────────────────────────── -->
                <Label Text="© 2026 CynaPharm · Tous droits réservés"
                       FontSize="11"
                       TextColor="{StaticResource TextMuted}"
                       HorizontalOptions="Center"
                       Margin="0,8,0,24" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
