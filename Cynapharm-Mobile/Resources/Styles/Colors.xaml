<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ── Primary brand colors ──────────────────────────────────────────── -->
    <Color x:Key="Primary">#00B4D8</Color>
    <Color x:Key="PrimaryDark">#0096B4</Color>
    <Color x:Key="PrimaryLight">#E1F5FB</Color>
    <Color x:Key="PrimaryText">#007A93</Color>

    <!-- ── Header Background ─────────────────────────────────────────────── -->
    <Color x:Key="HeaderBackground">#2d6a4f</Color>

    <!-- ── Secondary / accent ────────────────────────────────────────────── -->
    <Color x:Key="Secondary">#F5A623</Color>
    <Color x:Key="SecondaryLight">#FAEEDA</Color>
    <Color x:Key="SecondaryText">#854F0B</Color>

    <!-- ── Cyan accent (Legacy mapped to Primary) ────────────────────────── -->
    <Color x:Key="Accent">#00B4D8</Color>
    <Color x:Key="AccentLight">#E1F5FB</Color>

    <!-- ── Danger / error ────────────────────────────────────────────────── -->
    <Color x:Key="Danger">#E24B4A</Color>
    <Color x:Key="DangerLight">#FCEBEB</Color>
    <Color x:Key="DangerText">#A32D2D</Color>

    <!-- ── Info ─────────────────────────────────────────────────────────── -->
    <Color x:Key="InfoBackground">#E6F1FB</Color>
    <Color x:Key="InfoText">#0C447C</Color>

    <!-- ── Neutral surfaces ──────────────────────────────────────────────── -->
    <Color x:Key="PageBackground">#EEF0F5</Color>
    <Color x:Key="CardBackground">#FFFFFF</Color>
    <Color x:Key="SurfaceBackground">#F5F5F5</Color>
    <Color x:Key="BorderColor">#E0E0E0</Color>

    <!-- ── Text ──────────────────────────────────────────────────────────── -->
    <Color x:Key="TextPrimary">#1A1A1A</Color>
    <Color x:Key="TextSecondary">#6B6B6B</Color>
    <Color x:Key="TextMuted">#9E9E9E</Color>

    <!-- ── Legacy aliases (Controls / converters backward-compat) ────────── -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Gray100">#F5F5F5</Color>
    <Color x:Key="Gray200">#E0E0E0</Color>
    <Color x:Key="Gray300">#CCCCCC</Color>
    <Color x:Key="Gray515">#9E9E9E</Color>
    <Color x:Key="Gray900">#1A1A1A</Color>

    <Color x:Key="BrandAccent">#00B4D8</Color>
    <Color x:Key="BrandAccentFaint">#2600B4D8</Color>

    <Color x:Key="ErrorColor">#E24B4A</Color>
    <Color x:Key="ErrorLight">#FCEBEB</Color>
    <Color x:Key="SuccessColor">#1A6B3C</Color>
    <Color x:Key="WarningColor">#854F0B</Color>
    <Color x:Key="WarningLight">#FAEEDA</Color>

    <Color x:Key="Tertiary">#1A1A1A</Color>
    <Color x:Key="FieldBorderActive">#00B4D8</Color>
    <Color x:Key="FieldBorderInactive">#E0E0E0</Color>

    <Color x:Key="PageBackgroundColor">#EEF0F5</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="SurfaceStrokeColor">#E0E0E0</Color>
    <Color x:Key="PrimaryTextColor">#1A1A1A</Color>
    <Color x:Key="SecondaryTextColor">#6B6B6B</Color>

</ResourceDictionary>
