<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="Cynapharm_Mobile.AppShell"
       x:Name="AppShellRoot"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:auth="clr-namespace:Cynapharm_Mobile.Views.Auth"
       xmlns:dashboard="clr-namespace:Cynapharm_Mobile.Views.Dashboard"
       xmlns:visites="clr-namespace:Cynapharm_Mobile.Views.Visites"
       xmlns:planning="clr-namespace:Cynapharm_Mobile.Views.Planning"
       xmlns:rapports="clr-namespace:Cynapharm_Mobile.Views.Rapports"
       xmlns:stock="clr-namespace:Cynapharm_Mobile.Views.Stock"
       xmlns:objectifs="clr-namespace:Cynapharm_Mobile.Views.Objectifs"
       xmlns:products="clr-namespace:Cynapharm_Mobile.Views.Products"
       xmlns:orders="clr-namespace:Cynapharm_Mobile.Views.Orders"
       xmlns:documents="clr-namespace:Cynapharm_Mobile.Views.Documents"
       xmlns:reclamations="clr-namespace:Cynapharm_Mobile.Views.Reclamations"
       xmlns:clients="clr-namespace:Cynapharm_Mobile.Views.Clients"
       xmlns:profile="clr-namespace:Cynapharm_Mobile.Views.Profile"
       Shell.FlyoutBehavior="Flyout"
       Shell.TabBarIsVisible="False"
       BackgroundColor="{StaticResource Primary}"
       ForegroundColor="White">

    <!-- ═══════════════════════════════════════════════════════════════
         CUSTOM FLYOUT PANEL
    ═══════════════════════════════════════════════════════════════════ -->
    <Shell.FlyoutContent>
        <Grid RowDefinitions="Auto,*,Auto"
              BackgroundColor="{StaticResource PageBackground}">

            <!-- ── HEADER ──────────────────────────────────────────────── -->
            <Grid Grid.Row="0"
                  BackgroundColor="{StaticResource Primary}"
                  Padding="20,52,20,24">

                <Grid ColumnDefinitions="58,*,Auto" ColumnSpacing="14">

                    <!-- Avatar with white ring -->
                    <Grid Grid.Column="0"
                          WidthRequest="54" HeightRequest="54"
                          HorizontalOptions="Center" VerticalOptions="Center">
                        <Border BackgroundColor="Transparent"
                                StrokeShape="RoundRectangle 27"
                                Stroke="White" StrokeThickness="2"
                                HeightRequest="54" WidthRequest="54"
                                HorizontalOptions="Center" VerticalOptions="Center" />
                        <Border BackgroundColor="#33FFFFFF"
                                StrokeShape="RoundRectangle 24"
                                Stroke="Transparent"
                                HeightRequest="48" WidthRequest="48"
                                HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="{Binding UserInitials, Source={x:Reference AppShellRoot}}"
                                   FontSize="18" FontAttributes="Bold"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!-- Name + role -->
                    <VerticalStackLayout Grid.Column="1"
                                         VerticalOptions="Center"
                                         Spacing="4">
                        <Label Text="{Binding UserName, Source={x:Reference AppShellRoot}}"
                               FontSize="16" FontAttributes="Bold"
                               FontFamily="OpenSansSemibold"
                               TextColor="White"
                               LineBreakMode="TailTruncation" />
                        <Border BackgroundColor="#26FFFFFF"
                                StrokeShape="RoundRectangle 10"
                                Stroke="Transparent"
                                Padding="10,4"
                                HorizontalOptions="Start">
                            <Label Text="{Binding UserRole, Source={x:Reference AppShellRoot}}"
                                   FontSize="11" FontAttributes="Bold"
                                   TextColor="White" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Close chevron -->
                    <Border Grid.Column="2"
                            BackgroundColor="#26FFFFFF"
                            StrokeShape="RoundRectangle 10"
                            Stroke="Transparent"
                            HeightRequest="34" WidthRequest="34"
                            VerticalOptions="Center">
                        <Label Text="✕" FontSize="14"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                </Grid>
            </Grid>

            <!-- ── NAV ITEMS ───────────────────────────────────────────── -->
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="0,12,0,12" Spacing="0">

                    <!-- ┄ Section: Accueil ─────────────────────────────── -->
                    <Grid ColumnDefinitions="4,*" ColumnSpacing="10"
                          Margin="20,4,20,6"
                          IsVisible="{Binding ShowDashboard, Source={x:Reference AppShellRoot}}">
                        <BoxView Grid.Column="0" BackgroundColor="{StaticResource Primary}"
                                 CornerRadius="2" WidthRequest="4" />
                        <Label Grid.Column="1" Text="Accueil"
                               FontSize="11" FontAttributes="Bold"
                               TextColor="{StaticResource TextMuted}"
                               VerticalOptions="Center" />
                    </Grid>

                    <!-- Dashboard -->
                    <Grid HeightRequest="64" Padding="20,0"
                          ColumnDefinitions="46,12,*,20"
                          IsVisible="{Binding ShowDashboard, Source={x:Reference AppShellRoot}}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding GoToDashboardCommand, Source={x:Reference AppShellRoot}}" />
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0"
                                BackgroundColor="{StaticResource PrimaryLight}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="Transparent"
                                HeightRequest="42" WidthRequest="42"
                                HorizontalOptions="Center" VerticalOptions="Center">
                            <Path Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"
                                  Fill="{StaticResource Primary}"
                                  Aspect="Uniform"
                                  HeightRequest="20" WidthRequest="20"
                                  HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="2"
                               Text="Tableau de bord"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="3" Text="›" FontSize="20"
                               TextColor="{StaticResource Gray300}"
                               VerticalOptions="Center" HorizontalOptions="End" />
                    </Grid>

                    <!-- ┄ Section: Suivi (MEDECIN) ─────────────────────── -->
                    <Grid ColumnDefinitions="4,*" ColumnSpacing="10"
                          Margin="20,8,20,6"
                          IsVisible="{Binding ShowMedecinVisites, Source={x:Reference AppShellRoot}}">
                        <BoxView Grid.Column="0" BackgroundColor="#2E7D32"
                                 CornerRadius="2" WidthRequest="4" />
                        <Label Grid.Column="1" Text="Suivi"
                               FontSize="11" FontAttributes="Bold"
                               TextColor="{StaticResource TextMuted}"
                               VerticalOptions="Center" />
                    </Grid>

                    <!-- Mes visites (MEDECIN) -->
                    <Grid HeightRequest="64" Padding="20,0"
                          ColumnDefinitions="46,12,*,20"
                          IsVisible="{Binding ShowMedecinVisites, Source={x:Reference AppShellRoot}}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding GoToMedecinVisitesCommand, Source={x:Reference AppShellRoot}}" />
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0"
                                BackgroundColor="#E8F5E9"
                                StrokeShape="RoundRectangle 12"
                                Stroke="Transparent"
                                HeightRequest="42" WidthRequest="42"
                                HorizontalOptions="Center" VerticalOptions="Center">
                            <Path Data="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"
                                  Fill="#2E7D32"
                                  Aspect="Uniform"
                                  HeightRequest="20" WidthRequest="20"
                                  HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="2"
                               Text="Mes visites"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="3" Text="›" FontSize="20"
                               TextColor="{StaticResource Gray300}"
                               VerticalOptions="Center" HorizontalOptions="End" />
                    </Grid>

                    <!-- ┄ Section: Terrain ─────────────────────────────── -->
                    <Grid ColumnDefinitions="4,*" ColumnSpacing="10"
                          Margin="20,8,20,6"
                          IsVisible="{Binding ShowVisites, Source={x:Reference AppShellRoot}}">
                        <BoxView Grid.Column="0" BackgroundColor="#2E7D32"
                                 CornerRadius="2" WidthRequest="4" />
                        <Label Grid.Column="1" Text="Terrain"
                               FontSize="11" FontAttributes="Bold"
                               TextColor="{StaticResource TextMuted}"
                               VerticalOptions="Center" />
                    </Grid>

                    <!-- Visites -->
                    <Grid HeightRequest="64" Padding="20,0"
                          ColumnDefinitions="46,12,*,20"
                          IsVisible="{Binding ShowVisites, Source={x:Reference AppShellRoot}}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding GoToVisitesCommand, Source={x:Reference AppShellRoot}}" />
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0"
                                BackgroundColor="#E8F5E9"
                                StrokeShape="RoundRectangle 12"
                                Stroke="Transparent"
                                HeightRequest="42" WidthRequest="42"
                                HorizontalOptions="Center" VerticalOptions="Center">
                            <Path Data="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"
                                  Fill="#2E7D32"
                                  Aspect="Uniform"
                                  HeightRequest="20" WidthRequest="20"
                                  HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="2"
                               Text="Visites"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="3" Text="›" FontSize="20"
                               TextColor="{StaticResource Gray300}"
                               VerticalOptions="Center" HorizontalOptions="End" />
                    </Grid>

                    <!-- Planning -->
                    <Grid HeightRequest="64" Padding="20,0"
                          ColumnDefinitions="46,12,*,20"
                          IsVisible="{Binding ShowPlanning, Source={x:Reference AppShellRoot}}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding GoToPlanningCommand, Source={x:Reference AppShellRoot}}" />
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0"
                                BackgroundColor="{StaticResource SecondaryLight}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="Transparent"
                                HeightRequest="42" WidthRequest="42"
                                HorizontalOptions="Center" VerticalOptions="Center">
                            <Path Data="M17 12h-5v5h5v-5zM16 1v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-1V1h-2zm3 18H5V8h14v11z"
                                  Fill="{StaticResource Secondary}"
                                  Aspect="Uniform"
                                  HeightRequest="20" WidthRequest="20"
                                  HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="2"
                               Text="Planning"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="3" Text="›" FontSize="20"
                               TextColor="{StaticResource Gray300}"
                               VerticalOptions="Center" HorizontalOptions="End" />
                    </Grid>

                    <!-- Objectifs -->
                    <Grid HeightRequest="64" Padding="20,0"
                          ColumnDefinitions="46,12,*,20"
                          IsVisible="{Binding ShowObjectifs, Source={x:Reference AppShellRoot}}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding GoToObjectifsCommand, Source={x:Reference AppShellRoot}}" />
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0"
                                BackgroundColor="#F3E5F5"
                                StrokeShape="RoundRectangle 12"
                                Stroke="Transparent"
                                HeightRequest="42" WidthRequest="42"
                                HorizontalOptions="Center" VerticalOptions="Center">
                            <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm0-12.5c-2.49 0-4.5 2.01-4.5 4.5s2.01 4.5 4.5 4.5 4.5-2.01 4.5-4.5-2.01-4.5-4.5-4.5zm0 5.5c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1z"
                                  Fill="#7B1FA2"
                                  Aspect="Uniform"
                                  HeightRequest="20" WidthRequest="20"
                                  HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="2"
                               Text="Objectifs"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="3" Text="›" FontSize="20"
                               TextColor="{StaticResource Gray300}"
                               VerticalOptions="Center" HorizontalOptions="End" />
                    </Grid>

                    <!-- Mon Stock -->
                    <Grid HeightRequest="64" Padding="20,0"
                          ColumnDefinitions="46,12,*,20"
                          IsVisible="{Binding ShowStock, Source={x:Reference AppShellRoot}}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding GoToStockCommand, Source={x:Reference AppShellRoot}}" />
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0"
                                BackgroundColor="#FFF3E0"
                                StrokeShape="RoundRectangle 12"
                                Stroke="Transparent"
                                HeightRequest="42" WidthRequest="42"
                                HorizontalOptions="Center" VerticalOptions="Center">
                            <Path Data="M20 2H4c-1 0-2 .9-2 2v3.01c0 .72.43 1.34 1 1.72V20c0 1.1 1.1 2 2 2h14c.9 0 2-.9 2-2V8.72c.57-.38 1-.99 1-1.71V4c0-1.1-1-2-2-2zm-5 12H9v-2h6v2zm6-7H3V4h18v3z"
                                  Fill="#E65100"
                                  Aspect="Uniform"
                                  HeightRequest="20" WidthRequest="20"
                                  HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="2"
                               Text="Mon Stock"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="3" Text="›" FontSize="20"
                               TextColor="{StaticResource Gray300}"
                               VerticalOptions="Center" HorizontalOptions="End" />
                    </Grid>

                    <!-- Mes clients -->
                    <Grid HeightRequest="64" Padding="20,0"
                          ColumnDefinitions="46,12,*,20"
                          IsVisible="{Binding ShowClients, Source={x:Reference AppShellRoot}}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding GoToClientsCommand, Source={x:Reference AppShellRoot}}" />
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0"
                                BackgroundColor="{StaticResource AccentLight}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="Transparent"
                                HeightRequest="42" WidthRequest="42"
                                HorizontalOptions="Center" VerticalOptions="Center">
                            <Path Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
                                  Fill="{StaticResource Accent}"
                                  Aspect="Uniform"
                                  HeightRequest="20" WidthRequest="20"
                                  HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="2"
                               Text="Mes clients"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="3" Text="›" FontSize="20"
                               TextColor="{StaticResource Gray300}"
                               VerticalOptions="Center" HorizontalOptions="End" />
                    </Grid>

                    <!-- ┄ Section: Commercial ─────────────────────────── -->
                    <Grid ColumnDefinitions="4,*" ColumnSpacing="10"
                          Margin="20,8,20,6">
                        <BoxView Grid.Column="0" BackgroundColor="{StaticResource Secondary}"
                                 CornerRadius="2" WidthRequest="4" />
                        <Label Grid.Column="1" Text="Commercial"
                               FontSize="11" FontAttributes="Bold"
                               TextColor="{StaticResource TextMuted}"
                               VerticalOptions="Center" />
                    </Grid>

                    <!-- Catalogue -->
                    <Grid HeightRequest="64" Padding="20,0"
                          ColumnDefinitions="46,12,*,20"
                          IsVisible="{Binding ShowCatalogue, Source={x:Reference AppShellRoot}}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding GoToCatalogueCommand, Source={x:Reference AppShellRoot}}" />
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0"
                                BackgroundColor="{StaticResource PrimaryLight}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="Transparent"
                                HeightRequest="42" WidthRequest="42"
                                HorizontalOptions="Center" VerticalOptions="Center">
                            <Path Data="M4 8h4V4H4v4zm6 12h4v-4h-4v4zm-6 0h4v-4H4v4zm0-6h4v-4H4v4zm6 0h4v-4h-4v4zm6-10v4h4V4h-4zm-6 4h4V4h-4v4zm6 6h4v-4h-4v4zm0 6h4v-4h-4v4z"
                                  Fill="{StaticResource Primary}"
                                  Aspect="Uniform"
                                  HeightRequest="20" WidthRequest="20"
                                  HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="2"
                               Text="Catalogue"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="3" Text="›" FontSize="20"
                               TextColor="{StaticResource Gray300}"
                               VerticalOptions="Center" HorizontalOptions="End" />
                    </Grid>

                    <!-- Commandes -->
                    <Grid HeightRequest="64" Padding="20,0"
                          ColumnDefinitions="46,12,*,20"
                          IsVisible="{Binding ShowOrders, Source={x:Reference AppShellRoot}}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding GoToOrdersCommand, Source={x:Reference AppShellRoot}}" />
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0"
                                BackgroundColor="{StaticResource SecondaryLight}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="Transparent"
                                HeightRequest="42" WidthRequest="42"
                                HorizontalOptions="Center" VerticalOptions="Center">
                            <Path Data="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96C5 16.1 6.1 17 7 17h13v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63H19c.75 0 1.41-.41 1.75-1.03l3.58-6.49A1 1 0 0 0 23.47 4H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"
                                  Fill="{StaticResource Secondary}"
                                  Aspect="Uniform"
                                  HeightRequest="20" WidthRequest="20"
                                  HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="2"
                               Text="Commandes"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="3" Text="›" FontSize="20"
                               TextColor="{StaticResource Gray300}"
                               VerticalOptions="Center" HorizontalOptions="End" />
                    </Grid>

                    <!-- Documents -->
                    <Grid HeightRequest="64" Padding="20,0"
                          ColumnDefinitions="46,12,*,20"
                          IsVisible="{Binding ShowDocuments, Source={x:Reference AppShellRoot}}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding GoToDocumentsCommand, Source={x:Reference AppShellRoot}}" />
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0"
                                BackgroundColor="{StaticResource InfoBackground}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="Transparent"
                                HeightRequest="42" WidthRequest="42"
                                HorizontalOptions="Center" VerticalOptions="Center">
                            <Path Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"
                                  Fill="{StaticResource InfoText}"
                                  Aspect="Uniform"
                                  HeightRequest="20" WidthRequest="20"
                                  HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="2"
                               Text="Documents"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="3" Text="›" FontSize="20"
                               TextColor="{StaticResource Gray300}"
                               VerticalOptions="Center" HorizontalOptions="End" />
                    </Grid>

                    <!-- Réclamations -->
                    <Grid HeightRequest="64" Padding="20,0"
                          ColumnDefinitions="46,12,*,20"
                          IsVisible="{Binding ShowReclamations, Source={x:Reference AppShellRoot}}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding GoToReclamationsCommand, Source={x:Reference AppShellRoot}}" />
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0"
                                BackgroundColor="{StaticResource DangerLight}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="Transparent"
                                HeightRequest="42" WidthRequest="42"
                                HorizontalOptions="Center" VerticalOptions="Center">
                            <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                                  Fill="{StaticResource Danger}"
                                  Aspect="Uniform"
                                  HeightRequest="20" WidthRequest="20"
                                  HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="2"
                               Text="Réclamations"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="3" Text="›" FontSize="20"
                               TextColor="{StaticResource Gray300}"
                               VerticalOptions="Center" HorizontalOptions="End" />
                    </Grid>

                    <!-- ┄ Divider before profile ──────────────────────── -->
                    <BoxView HeightRequest="1"
                             BackgroundColor="{StaticResource BorderColor}"
                             Margin="20,10,20,10" />

                    <!-- Profil -->
                    <Grid HeightRequest="64" Padding="20,0"
                          ColumnDefinitions="46,12,*,20">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding GoToProfileCommand, Source={x:Reference AppShellRoot}}" />
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0"
                                BackgroundColor="{StaticResource PrimaryLight}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="Transparent"
                                HeightRequest="42" WidthRequest="42"
                                HorizontalOptions="Center" VerticalOptions="Center">
                            <Path Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                  Fill="{StaticResource Primary}"
                                  Aspect="Uniform"
                                  HeightRequest="20" WidthRequest="20"
                                  HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="2"
                               Text="Mon profil"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="3" Text="›" FontSize="20"
                               TextColor="{StaticResource Gray300}"
                               VerticalOptions="Center" HorizontalOptions="End" />
                    </Grid>

                </VerticalStackLayout>
            </ScrollView>

            <!-- ── FOOTER ──────────────────────────────────────────────── -->
            <Grid Grid.Row="2"
                  BackgroundColor="{StaticResource CardBackground}"
                  Padding="20,12,20,28">
                <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}"
                         VerticalOptions="Start" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,14,0,0">
                    <Border Grid.Column="0"
                            BackgroundColor="{StaticResource PrimaryLight}"
                            StrokeShape="RoundRectangle 8"
                            Stroke="Transparent"
                            WidthRequest="28" HeightRequest="28">
                        <Label Text="💊" FontSize="14"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label Text="CynaPharm CRM"
                               FontSize="12" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <Label Text="Version 1.0.0"
                               FontSize="10"
                               TextColor="{StaticResource TextMuted}" />
                    </VerticalStackLayout>
                </Grid>
            </Grid>

        </Grid>
    </Shell.FlyoutContent>

    <!-- ═══════════════════════════════════════════════════════════════
         LOADING ROUTE (initial route while auth check happens)
    ═══════════════════════════════════════════════════════════════════ -->
    <ShellContent Route="loading"
                  ContentTemplate="{DataTemplate auth:LoadingPage}"
                  Shell.NavBarIsVisible="False"
                  FlyoutItemIsVisible="False" />

    <!-- ═══════════════════════════════════════════════════════════════
         AUTH ROUTE
    ═══════════════════════════════════════════════════════════════════ -->
    <ShellContent Route="login"
                  ContentTemplate="{DataTemplate auth:LoginPage}"
                  Shell.NavBarIsVisible="False"
                  FlyoutItemIsVisible="False" />

    <!-- ═══════════════════════════════════════════════════════════════
         PAGE ROUTES  (tab bar removed — navigation via flyout drawer)
         FlyoutItemIsVisible="False" on every item so nothing appears
         in the auto-generated flyout list; the custom Shell.FlyoutContent
         above handles all visual navigation.
         IsVisible is controlled at runtime by ApplyRoleVisibility().
    ═══════════════════════════════════════════════════════════════════ -->

    <!-- ── DÉLÉGUÉ routes ──────────────────────────────────────────── -->
    <FlyoutItem x:Name="FlyoutDashboard" FlyoutItemIsVisible="False" IsVisible="False">
        <ShellContent Route="dashboard"
                      ContentTemplate="{DataTemplate dashboard:DashboardPage}"
                      Shell.NavBarIsVisible="False" />
    </FlyoutItem>

    <FlyoutItem x:Name="FlyoutVisites" FlyoutItemIsVisible="False" IsVisible="False">
        <ShellContent Route="visits"
                      ContentTemplate="{DataTemplate visites:VisitListPage}"
                      Shell.NavBarIsVisible="False" />
    </FlyoutItem>

    <!-- ── MÉDECIN — Historique de ses visites ─────────────────────── -->
    <FlyoutItem x:Name="FlyoutMedecinVisites" FlyoutItemIsVisible="False" IsVisible="False">
        <ShellContent Route="medecinvisits"
                      ContentTemplate="{DataTemplate visites:MedecinVisitHistoryPage}"
                      Shell.NavBarIsVisible="False" />
    </FlyoutItem>

    <FlyoutItem x:Name="FlyoutPlanning" FlyoutItemIsVisible="False" IsVisible="False">
        <ShellContent Route="planning"
                      ContentTemplate="{DataTemplate planning:PlanningPage}"
                      Shell.NavBarIsVisible="False" />
    </FlyoutItem>

    <!-- ── ALL roles — Catalogue ───────────────────────────────────── -->
    <FlyoutItem FlyoutItemIsVisible="False">
        <ShellContent Route="products"
                      ContentTemplate="{DataTemplate products:ProductListPage}"
                      Shell.NavBarIsVisible="False" />
    </FlyoutItem>

    <!-- ── CLIENT + DÉLÉGUÉ — Commandes ───────────────────────────── -->
    <FlyoutItem x:Name="FlyoutOrders" FlyoutItemIsVisible="False" IsVisible="False">
        <ShellContent Route="orders"
                      ContentTemplate="{DataTemplate orders:OrderListPage}"
                      Shell.NavBarIsVisible="False" />
    </FlyoutItem>

    <!-- ── CLIENT — Documents ─────────────────────────────────────── -->
    <FlyoutItem x:Name="FlyoutDocuments" FlyoutItemIsVisible="False" IsVisible="False">
        <ShellContent Route="documents"
                      ContentTemplate="{DataTemplate documents:DocumentListPage}"
                      Shell.NavBarIsVisible="False" />
    </FlyoutItem>

    <!-- ── ALL roles — Profil ─────────────────────────────────────── -->
    <FlyoutItem FlyoutItemIsVisible="False">
        <ShellContent Route="profile"
                      ContentTemplate="{DataTemplate profile:ProfilePage}"
                      Shell.NavBarIsVisible="False" />
    </FlyoutItem>

    <!-- ═══════════════════════════════════════════════════════════════
         SECONDARY PAGES (flyout drawer access only)
    ═══════════════════════════════════════════════════════════════════ -->
    <FlyoutItem Title="Mon Stock" x:Name="FlyoutStock"
                FlyoutItemIsVisible="False">
        <ShellContent Route="stock"
                      ContentTemplate="{DataTemplate stock:MyStockPage}"
                      Shell.NavBarIsVisible="False" />
    </FlyoutItem>

    <FlyoutItem Title="Mes clients" x:Name="FlyoutClients"
                FlyoutItemIsVisible="False" IsVisible="False">
        <ShellContent Route="clients"
                      ContentTemplate="{DataTemplate clients:MesClientsPage}"
                      Shell.NavBarIsVisible="False" />
    </FlyoutItem>

    <FlyoutItem Title="Objectifs" x:Name="FlyoutObjectifs"
                FlyoutItemIsVisible="False">
        <ShellContent Route="objectifs"
                      ContentTemplate="{DataTemplate objectifs:ObjectifPage}"
                      Shell.NavBarIsVisible="False" />
    </FlyoutItem>

    <FlyoutItem Title="Réclamations" x:Name="FlyoutReclamations"
                FlyoutItemIsVisible="False">
        <ShellContent Route="reclamations"
                      ContentTemplate="{DataTemplate reclamations:ReclamationListPage}"
                      Shell.NavBarIsVisible="False" />
    </FlyoutItem>

</Shell>
